#!/usr/bin/env python3
"""info-guard — build the redaction pattern file for Hermes Agent.

The pattern file (redact_patterns.json) is the single interface between
your secrets and Hermes' redaction engine. Hermes reads it at every
message boundary and masks anything it contains — exact values, or
values appearing as KEY=value / KEY: value / KEY: "value".

Usage:
  info-guard build [ENV_FILE ...]   Build redact_patterns.json from .env
                                    sources (default: $HERMES_HOME/.env).
                                    Extra ENV_FILE args add more sources
                                    (e.g. docker compose .env files).
  info-guard status                 Show a summary of the current pattern file.
  info-guard preflight [DIR ...]    Zero-config leak scan of Hermes' own data
                                    (default: <home>/sessions, <home>/logs,
                                    <home>/cron/output) — run BEFORE deciding
                                    whether to install. Read-only, output
                                    masked, nothing written.
  info-guard setup [--all]          Interactive bootstrap: reviews preflight
                                    candidates one by one (masked only),
                                    registers the ones you confirm as custom
                                    literals, picks .env sources, builds the
                                    pattern file. --all accepts every
                                    candidate non-interactively (agents/tests).
  info-guard check                  Health check / schedulable watchdog:
                                    engine marker, pattern file, custom
                                    literals, gitleaks. Exit 0 healthy,
                                    1 broken (run install.sh), 2 error.
                                    No alert channel assumed — wire the
                                    non-zero exit to your scheduler.

Sources merged by `build`:
  1. Every KEY=value pair from the env files, except:
       - non-secret keys (hosts, urls, usernames, emails, ports, flags,
         schedules, model configs, ...) — masking those values was pure
         information loss, and hashing them made detection false-positive
       - values shorter than 8 chars (precision floor — no false friends;
         those keys are still covered by the key-pattern pass below)
  2. A curated key list (PIN, x_passphrase, client_secret, ...) whose
     values are masked regardless of length (KEY= form).
  3. <state>/custom_literals.json — hand-edited exact values (PII, emails,
     names, anything you decide is sensitive). Optional; survives rebuilds;
     masking only. Entries: plain strings, or {"value": ..., "mask": "full"}
     for full masking.

Output: <state>/redact_patterns.json (chmod 600).
State dir: $HERMES_HOME/state/info-guard/  (default $HERMES_HOME = ~/.hermes).

This is the redaction layer only. The full stack — secret inventory,
leak detection, rotation, watchdogs — is documented in docs/full-stack.md.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

_HERMES_HOME = Path(os.environ.get("HERMES_HOME") or os.path.expanduser("~/.hermes"))
STATE_DIR = _HERMES_HOME / "state" / "info-guard"
MATCHER = STATE_DIR / "redact_patterns.json"
CUSTOM_LITERALS = STATE_DIR / "custom_literals.json"

VALID_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

# Keys that may appear in config/unit files but not in .env (PIN classes,
# router config dumps, NPM meta). Key-aware masking covers these regardless
# of value length.
EXTRA_KEY_PATTERNS = [
    "PIN", "WEBUI_PIN", "HERMES_WEBUI_PASSWORD", "x_passphrase", "client_secret",
    "refresh_token", "access_token", "dns_provider_credentials",
]

# Non-secret key classes: hosts/usernames/URLs/flags/schedules/... are NOT
# credentials — masking their values was pure information loss. The trailing
# \b keeps prefix classes (UNIFI_SSH_PASS, NPMI_PASSWORD...) out of this
# match; those still reach the literal pass via their values.
NON_SECRET_KEY_RE = re.compile(
    r"(?:host|url|user|email|path|home|dir|address|debug|_tools|proxy|browser|"
    r"wiki|image|web|moa|vision|terminal|searxng|firecrawl|vaultwarden_agent|"
    r"icloud|unifi|unraid|npm[ei]?|agh|hermes|model|smtp|cron|domain|timezone|"
    r"rclone|name|mode|dialectic|dream|peer_card|embedding|summary|deriver|"
    r"deduction|induction|overrides|structured_output|port|level|interval|"
    r"transport|users)\b", re.IGNORECASE)
# Exact non-secret keys whose values are emails/modes/env-var-NAMES (not
# secrets) — mid-string markers defeat the \b rule, so explicit denylist.
NON_SECRET_EXACT = {
    "EMAIL_ALLOWED_USERS", "SMTP_FROM", "SMTP_SECURITY",
    "DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV",
    "EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV",
    "GITHUB_APP_ID", "GITHUB_APP_INSTALLATION_ID",
}
# Boolean/config-flag keys (CACHE_ENABLED, SIGNUPS_ALLOWED, ...) — values are
# short booleans, never credentials; they only pollute the pattern file.
NON_SECRET_FLAG_RE = re.compile(
    r"(?:ENABLED?|ALLOWED|PROXIES|STEALTH|SENTRY|SIGNUPS|INVITATIONS|USE_AUTH)$",
    re.IGNORECASE)


def _is_non_secret_key(k: str) -> bool:
    return (NON_SECRET_KEY_RE.search(k) or k in NON_SECRET_EXACT
            or NON_SECRET_FLAG_RE.search(k))


def _load_env(path: Path):
    """Parse a .env file into {KEY: value}. Errors on a path are fatal
    (a source you named must exist); missing default sources are skipped."""
    out = {}
    try:
        lines = path.read_text().splitlines()
    except OSError:
        raise SystemExit(f"[info-guard] ✗ cannot read env source: {path}")
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        k = k.strip().strip('"').strip("'")
        if not VALID_KEY_RE.match(k):
            continue
        v = v.strip().strip('"').strip("'")
        # strip trailing comments (only when preceded by whitespace; a
        # # inside the value is part of the value)
        v = re.sub(r"\s+#.*$", "", v)
        out[k] = v
    return out


def _default_sources():
    """Default env sources: the active Hermes home's .env, plus ./ .env if
    present in the working directory. Additional files come from argv."""
    candidates = [_HERMES_HOME / ".env", Path.cwd() / ".env"]
    return [p for p in candidates if p.exists()]


def _atomic_write_json(path: Path, data: dict) -> None:
    """Write JSON atomically: temp file in the same directory (0600) →
    fsync → os.replace → fsync the directory. A concurrent reader sees
    either the old or the new file, never a partial one (external-audit
    B1/F4)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".redact-", suffix=".json",
                               dir=str(path.parent))
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
        try:
            d = os.open(str(path.parent), os.O_RDONLY)
            os.fsync(d)
            os.close(d)
        except OSError:
            pass
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def cmd_build(env_files):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    sources = [Path(p) for p in env_files] if env_files else _default_sources()
    if not sources:
        raise SystemExit("[info-guard] ✗ no .env sources found — pass env files "
                         "explicitly, or run from a directory with a .env")
    raw_lits, key_patterns, val_masks = [], {}, {}
    for path in sources:
        if not path.exists():
            raise SystemExit(f"[info-guard] ✗ env source not found: {path}")
        for k, v in _load_env(path).items():
            if _is_non_secret_key(k):
                continue
            if len(v) >= 8:                    # literal floor = precision optimization
                raw_lits.append(v)
            key_patterns[k] = True
    for k in EXTRA_KEY_PATTERNS:
        key_patterns[k] = True
    # Hand-edited custom literals (PII — emails, names, numbers, anything the
    # user decides is sensitive). The file is a SOURCE, never clobbered by
    # rebuilds: edit it, then `info-guard build` picks it up.
    if CUSTOM_LITERALS.exists():
        try:
            for item in json.loads(CUSTOM_LITERALS.read_text()).get("literals", []) or []:
                if isinstance(item, dict):
                    v = item.get("value")
                    if isinstance(v, str) and v:
                        raw_lits.append(v)
                        if "mask" in item:
                            val_masks[v] = item["mask"]
                elif isinstance(item, str) and item:
                    raw_lits.append(item)
        except (OSError, ValueError):
            print(f"[info-guard] ⚠ {CUSTOM_LITERALS.name} unreadable — skipped (fail-safe)")
    # Longest-first so overlapping literals mask deterministically
    literals = []
    for v in sorted(set(raw_lits), key=len, reverse=True):
        literals.append({"value": v, "mask": val_masks[v]} if v in val_masks else v)
    _atomic_write_json(MATCHER, {
        "mask": {"head": 2, "tail": 2, "floor": 12},
        "literals": literals,
        "key_patterns": key_patterns,
        "generated": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    })
    os.chmod(MATCHER, 0o600)
    n_full = sum(1 for l in literals if isinstance(l, dict))
    print(f"[info-guard] matcher: {len(literals)} literals ({n_full} full-mask), "
          f"{len(key_patterns)} key patterns → {MATCHER}")


def cmd_status():
    if not MATCHER.exists():
        print(f"[info-guard] no pattern file yet — run `info-guard build`")
        return 1
    data = json.loads(MATCHER.read_text())
    lits = data.get("literals", [])
    n_full = sum(1 for l in lits if isinstance(l, dict))
    print(f"[info-guard] {len(lits)} literals ({n_full} full-mask), "
          f"{len(data.get('key_patterns', {}))} key patterns, "
          f"mask default {data.get('mask')}, generated {data.get('generated')}")
    print(f"[info-guard] file: {MATCHER} (mode {oct(MATCHER.stat().st_mode & 0o777)})")
    return 0


# ── preflight: zero-config leak scan of Hermes' own data ───────────────────
# Run BEFORE installing: answers "am I already leaking without knowing it?"
# No registry, no state, nothing written. Two detection passes over the
# transcript/log dirs: (a) key-shape regexes (KEY=value with secret-family
# keys, known token prefixes), (b) gitleaks' already-tuned ruleset
# (--redact=8, same invocation the full-stack detector uses).
_PREFLIGHT_DIRS = ["sessions", "logs", "cron/output"]

_KEY_FAMILY_RE = re.compile(
    r"(?:api[ _.\-]?key|token|secret|passwd|password|credential|auth|pass|pw|pin)\b",
    re.IGNORECASE)
_KEY_FORM_RE = re.compile(
    r"\b([A-Za-z0-9_.\-]*" + _KEY_FAMILY_RE.pattern + r"[A-Za-z0-9_.\-]*)\s*[=:]\s*(\S+)",
    re.IGNORECASE)
_TOKEN_PREFIX_RE = re.compile(
    r"\b(sk-[A-Za-z0-9_\-]{10,}|key_[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|"
    r"github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9\-]{10,}|AKIA[A-Za-z0-9]{16}|"
    r"AC[a-z0-9]{32}|whsec_[A-Za-z0-9]{16,}|glpat-[A-Za-z0-9_\-]{10,}|"
    r"xr[a-z0-9_\-]{10,})\b")
_TRIVIAL_VALUES = {"true", "false", "null", "none", "yes", "no", "0", "1", "undefined", "auto"}
# Hard-mask for gitleaks Match context: any 16+ char run (token-shaped
# fragments survive gitleaks' own --redact in the Match field)
_HARD_MASK_RE = re.compile(r"[A-Za-z0-9_\-./+=]{16,}")
# Pinned, not floating: the release download verifies SHA256 against the
# release's own checksums file (external-audit B4/F7). Bump after testing a
# newer release — `info-guard preflight` refuses to install unverified versions.
_GITLEAKS_VERSION = "8.30.1"
_GITLEAKS_RELEASES_URL = f"https://api.github.com/repos/gitleaks/gitleaks/releases/tags/v{_GITLEAKS_VERSION}"


def _mask_value(v: str) -> str:
    if len(v) <= 10:
        return "***"
    return v[:2] + "..." + v[-2:]


def _key_scan(path: Path):
    """Key-shape + token-prefix pass over one file. Returns list of
    (cls, rule, line_no, value, masked_repr, context). The raw value is
    returned so the setup wizard can register it — it is NEVER printed."""
    hits = []
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return hits
    for lineno, line in enumerate(text.splitlines(), 1):
        line = line.rstrip("\n")
        for m in _KEY_FORM_RE.finditer(line):
            key, val = m.group(1), m.group(2)
            if val.lower() in _TRIVIAL_VALUES or re.fullmatch(r"\d{1,6}", val):
                continue
            if len(val) > 64:                       # giant json blob, not a value
                continue
            ctx = line[: m.end()] + line[m.end():][:80]
            ctx = re.sub(re.escape(val), "***", ctx, count=1)
            hits.append(("KEY-SHAPE", f"key-family:{key[:40]}", lineno, val,
                         f"{key}={_mask_value(val)}", ctx))
        for m in _TOKEN_PREFIX_RE.finditer(line):
            tok = m.group(1)
            ctx = line[: m.end()] + line[m.end():][:80]
            ctx = re.sub(re.escape(tok), "***", ctx, count=1)
            hits.append(("TOKEN-SHAPE", "known-prefix", lineno, tok,
                         _mask_value(tok), ctx))
    return hits


def _gitleaks_available() -> bool:
    """gitleaks on PATH, or in the usual user-level spots (~/go/bin from
    `go install`, ~/.local/bin from the release installer)."""
    if shutil.which("gitleaks"):
        return True
    for cand in (Path.home() / "go" / "bin" / "gitleaks",
                 Path.home() / ".local" / "bin" / "gitleaks"):
        if cand.is_file():
            return True
    return False


def _install_gitleaks() -> bool:
    """Best-effort install: `go install` when go exists, else the GitHub
    release binary into ~/.local/bin. Returns True on success."""
    import io
    import platform
    import tarfile
    import urllib.request

    go = shutil.which("go")
    if go:
        print(f"  installing via `go install github.com/gitleaks/gitleaks/v8@v{_GITLEAKS_VERSION}`…")
        try:
            subprocess.run([go, "install",
                            f"github.com/gitleaks/gitleaks/v8@v{_GITLEAKS_VERSION}"],
                           capture_output=True, timeout=600)
            if (Path.home() / "go" / "bin" / "gitleaks").is_file():
                print("  ✓ installed — note: ~/go/bin may need to be on PATH")
                return True
        except (subprocess.TimeoutExpired, OSError):
            pass
        print("  go install did not produce a usable binary — trying the release download…")
    os_name = {"linux": "linux", "darwin": "darwin"}.get(sys.platform)
    arch = {"x86_64": "x64", "amd64": "x64",
            "aarch64": "arm64", "arm64": "arm64"}.get(platform.machine())
    if not os_name or not arch:
        print("  ✗ unsupported platform for auto-install — grab the binary from "
              "https://github.com/gitleaks/gitleaks/releases")
        return False
    try:
        with urllib.request.urlopen(_GITLEAKS_RELEASES_URL, timeout=30) as r:
            release = json.load(r)
        tag = release["tag_name"]
        if tag != f"v{_GITLEAKS_VERSION}":
            print(f"  ✗ expected v{_GITLEAKS_VERSION} but the API returned {tag} — "
                  "refusing to install (pinned version, never floats)")
            return False
        # pick the asset from the API's list (names drift: x64, x86_64, …)
        want = f"{os_name}_{arch}.tar.gz"
        asset = next((a for a in release.get("assets", [])
                      if a.get("name", "").endswith(want)), None)
        if not asset:
            print(f"  ✗ no {want} asset in the v{_GITLEAKS_VERSION} release — "
                  "install manually: https://github.com/gitleaks/gitleaks/releases")
            return False
        # SHA256 against the release's own checksums file
        sum_name = f"gitleaks_{_GITLEAKS_VERSION}_checksums.txt"
        sum_asset = next((a for a in release.get("assets", [])
                          if a.get("name") == sum_name), None)
        if not sum_asset:
            print(f"  ✗ {sum_name} missing from the release — refusing an "
                  "unverifiable install")
            return False
        with urllib.request.urlopen(sum_asset["browser_download_url"],
                                    timeout=60) as r:
            checksums = r.read().decode()
        expected = next((ln.split()[0].lower() for ln in checksums.splitlines()
                         if asset["name"] in ln), None)
        if not expected:
            print(f"  ✗ no checksum entry for {asset['name']} — refusing install")
            return False
        print(f"  downloading {asset['name']} …")
        with urllib.request.urlopen(asset["browser_download_url"], timeout=180) as r:
            tarball = r.read()
        actual = hashlib.sha256(tarball).hexdigest()
        if actual != expected:
            print(f"  ✗ SHA256 mismatch ({actual[:12]}… ≠ {expected[:12]}…) — "
                  "refusing to install (supply-chain guard)")
            return False
        dest = Path.home() / ".local" / "bin"
        dest.mkdir(parents=True, exist_ok=True)
        with tarfile.open(fileobj=io.BytesIO(tarball), mode="r:gz") as tf:
            member = next(m for m in tf.getmembers()
                          if m.name == "gitleaks" or m.name.endswith("/gitleaks"))
            data = tf.extractfile(member).read()
        (dest / "gitleaks").write_bytes(data)
        (dest / "gitleaks").chmod(0o755)
        print("  ✓ installed to ~/.local/bin/gitleaks (SHA256 verified)")
        return True
    except Exception as e:  # network / archive / missing asset
        print(f"  ✗ auto-install failed: {e}")
        print("  install manually: https://github.com/gitleaks/gitleaks/releases")
        return False


def _ensure_gitleaks() -> bool:
    """Up-front gitleaks check for preflight/setup: when missing, explain
    the benefit and offer to install (interactive terminals only; non-tty
    runs get instructions and continue with the key-shape pass). Returns
    True when gitleaks is available afterwards."""
    if _gitleaks_available():
        return True
    print()
    print("[info-guard] ⚠ gitleaks not found on PATH.")
    print("  What it adds: the tuned-ruleset detection tier — 100+ provider-")
    print("  specific patterns (AWS, GitHub, OpenAI, generic API keys, …).")
    print("  Without it the scan still catches key-shaped values (KEY=value")
    print("  with secret-family keys) and known token prefixes (sk-, ghp_, …),")
    print("  but provider formats go unseen.")
    print("  gitleaks is OPTIONAL for Info Guard: the redaction layer never")
    print("  needs it — it powers this scan's second tier and the full-stack")
    print("  detector. Small (~10 MB), open source (MIT), runs fully offline")
    print("  once installed.")
    if not sys.stdin.isatty():
        print("  non-interactive run: install it separately (`go install "
              "github.com/gitleaks/gitleaks/v8@v8.30.1` or the GitHub release),")
        print("  then re-run — continuing with the key-shape pass only.")
        return False
    try:
        ans = input("  install gitleaks now? [y/N] ").strip().lower()
    except EOFError:
        return False
    if ans != "y":
        print("  continuing with the key-shape pass only.")
        return False
    ok = _install_gitleaks()
    if not ok:
        print("  continuing with the key-shape pass only.")
    return ok


def _gitleaks_bin() -> str:
    """Resolved gitleaks binary: PATH, ~/go/bin (go install), or
    ~/.local/bin (release installer) — PATH alone misses user-level
    installs on a scrubbed PATH."""
    for cand in (shutil.which("gitleaks"),
                 str(Path.home() / "go" / "bin" / "gitleaks"),
                 str(Path.home() / ".local" / "bin" / "gitleaks")):
        if cand and Path(cand).is_file():
            return cand
    return ""


def _gitleaks_scan(root: Path, redact=True):
    """gitleaks dir over one directory tree (already-tuned ruleset).
    Returns (hits, available) — available=False when gitleaks is missing.
    NEVER prints the raw Secret field; the Match line is hard-masked (all
    16+ char runs replaced) before it can reach the terminal. With
    redact=False the full secret is kept in memory for the setup wizard
    (written straight to custom_literals.json, never echoed)."""
    binpath = _gitleaks_bin()
    if not binpath:
        return [], False
    report_fd, report = tempfile.mkstemp(suffix=".json")
    os.close(report_fd)
    hits = []
    try:
        cmd = [binpath, "dir", str(root), "--no-banner",
               "--report-format=json", f"--report-path={report}"]
        if redact:
            cmd.insert(2, "--redact=8")
        subprocess.run(cmd, capture_output=True, timeout=600)
        try:
            findings = json.loads(Path(report).read_text())
        except (OSError, json.JSONDecodeError):
            findings = []
        for f in findings:
            rule = f.get("RuleID", "?")
            cls = "SUSPICIOUS" if rule == "generic-api-key" else "HIGH-CONFIDENCE"
            secret = f.get("Secret", "") or ""
            match = f.get("Match", "") or ""
            # Hard-mask: gitleaks' Match may keep long visible fragments
            # (--redact=8 applies to Secret, not always to Match context).
            masked = _HARD_MASK_RE.sub("***", match)
            if redact:
                secret = ""
            elif secret and len(secret) >= 4:
                masked = masked.replace(secret, "***")
            hits.append((cls, rule, f.get("File", "?"), f.get("StartLine", 0),
                         secret, "***", masked.strip()[:140]))
    except (subprocess.TimeoutExpired, OSError):
        pass
    finally:
        try:
            os.unlink(report)
        except OSError:
            pass
    return hits, True


def cmd_preflight(args):
    dirs = []
    for name in args or _PREFLIGHT_DIRS:
        p = _HERMES_HOME / name
        if p.is_dir():
            dirs.append(p)
    if not dirs:
        print(f"[info-guard] preflight: no scan targets under {_HERMES_HOME} "
              f"({', '.join(_PREFLIGHT_DIRS)}) — nothing to scan")
        return 0
    _ensure_gitleaks()
    _print_install_status()
    total = 0
    for d in dirs:
        total += sum(1 for _ in d.rglob("*") if _.is_file())
    print(f"[info-guard] preflight — scanning {len(dirs)} dirs / ~{total} files "
          f"under {_HERMES_HOME} (read-only, nothing written)")
    all_hits, gitleaks_ok = [], True
    for d in dirs:
        for p in sorted(d.rglob("*")):
            if not p.is_file():
                continue
            for hit in _key_scan(p):
                all_hits.append((hit[0], hit[1], str(p.relative_to(_HERMES_HOME)), *hit[2:]))
        ghits, ok = _gitleaks_scan(d)
        gitleaks_ok = gitleaks_ok and ok
        for cls, rule, fname, line, value, masked, ctx in ghits:
            rel = os.path.relpath(fname, str(_HERMES_HOME)) if fname else str(d)
            all_hits.append((cls, rule, rel, line, value, masked, ctx))
    if not gitleaks_ok:
        print("[info-guard] preflight: ⚠ gitleaks not found on PATH — ran "
              "key-shape pass only (install gitleaks for the tuned-ruleset pass)")
    all_hits.sort(key=lambda h: (h[2], h[3]))
    print()
    if not all_hits:
        print("[info-guard] ✓ preflight CLEAN — no key-shaped values, token "
              "prefixes, or gitleaks rule hits in Hermes' transcripts and logs.")
        print()
        print("  What this means: no detected leaks AT REST in the scanned dirs")
        print("  — a solid baseline, but a snapshot of today, not a promise.")
        print("  What it does not mean:")
        print("    • future-proof — new services and new secrets create new")
        print("      exposure after this run")
        print("    • exhaustive — key-forms, known token prefixes, and gitleaks'")
        print("      ruleset; an unusual format could go unseen")
        print("  Why install anyway: Info Guard is PREVENTION, not cleanup.")
        print("  It masks your exact values before they ever reach logs/")
        print("  transcripts — and it NEVER removes what is already at rest:")
        print("  anything found stays until you rotate or delete it.")
        print("  Re-run preflight anytime (it's free) — e.g. after adding a")
        print("  new service, to confirm the baseline still holds.")
        return 0
    print(f"[info-guard] ✗ preflight FINDINGS — {len(all_hits)} candidate(s) in "
          f"Hermes' own data. Each is a value that LOOKS like a secret at rest:")
    from collections import Counter, OrderedDict
    tier = Counter(h[0] for h in all_hits)
    print(f"    tiers: {', '.join(f'{k} {v}' for k, v in tier.most_common())}")
    # dedup identical (cls, rule, file, line, value) → ×N display
    deduped = OrderedDict()
    for h in all_hits:
        key = (h[0], h[1], h[2], h[3], h[4])
        count, _ = deduped.get(key, (0, None))
        deduped[key] = (count + 1, h)
    print()
    shown = 0
    for key, (n, h) in deduped.items():
        if shown >= 50:
            break
        cls, rule, rel, line, value, masked, ctx = h
        print(f"  [{cls}] {rule}" + (f" (×{n} files/lines)" if n > 1 else ""))
        print(f"      {rel}:{line}  value={masked}")
        if ctx:
            print(f"      …{ctx}…")
        print()
        shown += 1
    if len(deduped) > 50:
        print(f"  …and {len(deduped) - 50} more unique candidates (first 50 shown)")
    print("  What this means: a secret at rest in transcripts/logs is already\n"
          "  compromised (anyone with file access can read it). Review the list;\n"
          "  for anything you confirm is a real secret: ROTATE or delete it.\n"
          "  Installing Info Guard does NOT clean these up — masking is\n"
          "  display-only; it prevents the NEXT occurrence, it never removes\n"
          "  what is already here.\n"
          "  Known false-positive classes: code identifiers (password_hash =),\n"
          "  config examples in docs, harmless IDs matching token prefixes.")
    return 1


def _collect_hits(dirs, redact=True):
    """Shared scan used by preflight and setup. Returns (all_hits,
    gitleaks_ok) with 7-tuples (cls, rule, rel, line, value, masked, ctx).

    redact=False is for the setup wizard ONLY: gitleaks findings must
    carry their real value so the user can register it (the wizard never
    echoes it — it goes straight into custom_literals.json). Preflight
    stays redact=True (read-only, values blanked)."""
    all_hits, gitleaks_ok = [], True
    for d in dirs:
        for p in sorted(d.rglob("*")):
            if not p.is_file():
                continue
            for hit in _key_scan(p):
                all_hits.append((hit[0], hit[1], str(p.relative_to(_HERMES_HOME)), *hit[2:]))
        ghits, ok = _gitleaks_scan(d, redact=redact)
        gitleaks_ok = gitleaks_ok and ok
        for cls, rule, fname, line, value, masked, ctx in ghits:
            rel = os.path.relpath(fname, str(_HERMES_HOME)) if fname else str(d)
            all_hits.append((cls, rule, rel, line, value, masked, ctx))
    return all_hits, gitleaks_ok


# The 5 files the patch touches, with a marker per file. All present =
# ACTIVE; some = PARTIAL (a failed `hermes update` half-reverted the patch);
# none = MISSING. Single-marker greps miss partial reversion (external-audit
# B2/F5).
_ENGINE_MARKERS = {
    "agent/redact.py": "_redact_registry_patterns",
    "hermes_cli/config.py": "redact_patterns",
    "hermes_cli/main.py": "HERMES_REDACT_PATTERNS",
    "cli.py": "HERMES_REDACT_PATTERNS",
    "gateway/run.py": "HERMES_REDACT_PATTERNS",
}


def _installation_status():
    """Best-effort detection of an existing Info Guard install: engine
    markers across all 5 patched files + the state artifacts that only
    install/build create."""
    status = {"state_dir": STATE_DIR.is_dir(),
              "patterns": MATCHER.exists(),
              "custom": CUSTOM_LITERALS.exists(),
              "markers": {}}
    for rel, marker in _ENGINE_MARKERS.items():
        p = _HERMES_HOME / "hermes-agent" / rel
        found = False
        if p.is_file():
            try:
                found = marker in p.read_text(errors="replace")
            except OSError:
                pass
        status["markers"][rel] = found
    n = sum(status["markers"].values())
    status["engine"] = n == len(_ENGINE_MARKERS)
    status["partial"] = 0 < n < len(_ENGINE_MARKERS)
    return status


def _print_install_status():
    """Frame the run: decide-step (not installed) vs. health check
    (installed — findings are residue, masking does not remove it)."""
    inst = _installation_status()
    if inst["engine"]:
        pf = "present" if inst["patterns"] else "MISSING"
        print(f"[info-guard] ℹ Info Guard INSTALLED (engine ACTIVE, 5/5 markers, "
              f"pattern file {pf}) — this run is a health check of at-rest "
              f"residue, not a decide step.")
    elif inst["partial"]:
        missing = ", ".join(rel for rel, ok in inst["markers"].items() if not ok)
        print(f"[info-guard] ⚠ Info Guard PARTIAL — patch markers missing in: "
              f"{missing}. A failed `hermes update` likely half-reverted the "
              f"patch: restore the files (`git checkout` them in the checkout) "
              f"and re-run ./install.sh before trusting this health check.")
    else:
        print("[info-guard] ℹ Info Guard not detected — this run is the "
              "before-install decide step.")


def _scan_dirs(names=None):
    return [p for name in (names or _PREFLIGHT_DIRS)
            for p in [_HERMES_HOME / name] if p.is_dir()]


def _load_custom_values():
    """Existing custom literals as a list of values (dict entries keep their
    mask; plain strings stay plain). Returns ([entries], ok)."""
    if not CUSTOM_LITERALS.exists():
        return [], True
    try:
        return json.loads(CUSTOM_LITERALS.read_text()).get("literals", []) or [], True
    except (OSError, ValueError):
        return [], False


def cmd_setup(args):
    """Interactive wizard: preflight scan → review candidates → register
    the real ones → pick .env sources → build the pattern file.

    Values are NEVER echoed: candidates are shown masked, and confirmed
    values go straight from the scan into custom_literals.json.
    `--all` accepts every candidate non-interactively (for agents/tests)."""
    auto = "--all" in args
    if not auto and not sys.stdin.isatty():
        print("[info-guard] setup is interactive — run it in a terminal, or use:\n"
              "    info-guard preflight            review candidates manually\n"
              "    info-guard build [ENV_FILE...]  build from your .env files\n"
              "    edit <state>/custom_literals.json, then `info-guard build`")
        return 2
    dirs = _scan_dirs()
    if not dirs:
        print(f"[info-guard] setup: no scan targets under {_HERMES_HOME} "
              f"({', '.join(_PREFLIGHT_DIRS)})")
        return 0
    _ensure_gitleaks()
    print(f"[info-guard] setup — scanning {len(dirs)} dirs under {_HERMES_HOME} "
          f"(read-only scan; only your confirmed choices write anything)")
    all_hits, gitleaks_ok = _collect_hits(dirs, redact=False)
    if not gitleaks_ok:
        print("[info-guard] setup: ⚠ gitleaks not found on PATH — key-shape pass only")
    from collections import OrderedDict
    deduped = OrderedDict()
    for h in all_hits:
        key = (h[0], h[1], h[2], h[3], h[4])
        count, _ = deduped.get(key, (0, None))
        deduped[key] = (count + 1, h)
    added = []          # (value, mask_style)
    skipped_short = 0
    if deduped:
        print(f"\n[info-guard] {len(deduped)} candidate(s) found in your transcripts "
              f"and logs. Review each: anything that is YOURS gets registered as "
              f"an exact-value literal (values shown masked only).")
        print()
        for key, (n, h) in deduped.items():
            cls, rule, rel, line, value, masked, ctx = h
            print(f"  [{cls}] {rule} (×{n})")
            print(f"      {rel}:{line}  value={masked}")
            if ctx:
                print(f"      …{ctx}…")
            if auto:
                ans = "y"
            else:
                try:
                    ans = input("      add as literal? [y]es / [n]o / [q]uit  ").strip().lower()
                except EOFError:
                    ans = "q"
            if ans == "q":
                break
            if ans != "y":
                continue
            if len(value) < 8:
                skipped_short += 1
                print("      (value too short for exact-value matching — it will be "
                      "covered if its KEY is in your .env sources)")
                continue
            style = "full" if cls != "KEY-SHAPE" else None
            added.append((value, style))
            print(f"      ✓ registered (mask: {style or 'default 2+2'})")
        print()
    # .env sources
    env_sources = []
    for cand, default in [(_HERMES_HOME / ".env", True), (Path.cwd() / ".env", False)]:
        if not cand.exists():
            continue
        if auto:
            ans = "y" if default else "n"
        else:
            ans = input(f"  include {cand} as an env source? [Y/n] "
                        if default else f"  include {cand} as an env source? [y/N] ").strip().lower()
            ans = ans or ("y" if default else "n")
        if ans == "y":
            env_sources.append(str(cand))
    # write custom_literals.json (merge, never clobber)
    existing, ok = _load_custom_values()
    if not ok:
        print(f"[info-guard] ⚠ existing {CUSTOM_LITERALS.name} unreadable — "
              f"will not overwrite; new values skipped")
        added = []
    if added:
        seen = set()
        merged = []
        for item in existing + [{"value": v, "mask": m} if m else v for v, m in added]:
            sig = item if isinstance(item, str) else item.get("value")
            if sig in seen:
                continue
            seen.add(sig)
            merged.append(item)
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        _atomic_write_json(CUSTOM_LITERALS, {"literals": merged})
        print(f"[info-guard] wrote {len(added)} new literal(s) → {CUSTOM_LITERALS}")
    elif not env_sources:
        print("[info-guard] nothing new to register — no changes made")
        return 0
    # build
    if env_sources:
        cmd_build(env_sources)
    elif added:
        print("[info-guard] no env sources selected — pattern file will contain "
              "only the custom literals (add sources later with "
              "`info-guard build ENV_FILE...`)")
    if skipped_short:
        print(f"[info-guard] note: {skipped_short} short value(s) skipped — their "
              f"keys are covered if present in an env source")
    cmd_status()
    print("[info-guard] done. Verify with ./test.sh — masking is live immediately.")
    return 0


def cmd_check(args):
    """Health check — the package's schedulable watchdog. Verifies the
    engine marker survived updates, the pattern file is present, and
    reports gitleaks availability. Exit 0 = healthy, 1 = broken,
    2 = error. No alert channel assumed: the caller's scheduler decides
    what to do with a non-zero exit (cron mail, ntfy, ...)."""
    problems = 0
    inst = _installation_status()
    if inst["engine"]:
        print("[info-guard] ✓ engine: ACTIVE — all 5 patch markers present")
    elif inst["partial"]:
        problems += 1
        missing = ", ".join(rel for rel, ok in inst["markers"].items() if not ok)
        print(f"[info-guard] ✗ engine: PARTIAL — markers missing in: {missing}. "
              f"A failed `hermes update` likely half-reverted the patch; "
              f"restore the files (`git checkout` them in the checkout) and "
              f"re-run ./install.sh")
    else:
        problems += 1
        print("[info-guard] ✗ engine: MISSING — no patch markers found; "
              "`hermes update` likely wiped the patch; run ./install.sh "
              "(idempotent) or ./uninstall.sh if you want out")
    if inst["patterns"]:
        try:
            data = json.loads(MATCHER.read_text())
            lits = data.get("literals", [])
            n_full = sum(1 for l in lits if isinstance(l, dict))
            print(f"[info-guard] ✓ pattern file: present ({len(lits)} literals, "
                  f"{n_full} full-mask, {len(data.get('key_patterns', {}))} "
                  f"key patterns)")
        except (OSError, ValueError):
            problems += 1
            print(f"[info-guard] ✗ pattern file: unreadable at {MATCHER}")
    else:
        problems += 1
        print(f"[info-guard] ✗ pattern file: missing — run ./install.sh then "
              f"`info-guard build`")
    if CUSTOM_LITERALS.exists():
        print("[info-guard] ✓ custom literals: present (masking-only source)")
    if _gitleaks_available():
        print("[info-guard] ✓ gitleaks: available (preflight tuned-ruleset tier "
              "active)")
    else:
        print("[info-guard] ⚠ gitleaks: absent — OPTIONAL; preflight degrades "
              "to key-shape pass (install with `info-guard preflight`)")
    print()
    if problems:
        print(f"[info-guard] ✗ check FAILED — {problems} problem(s) found")
        return 1
    print("[info-guard] ✓ check OK — Info Guard healthy")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv and argv[0] in ("-h", "--help") else 1
    cmd, rest = argv[0], argv[1:]
    if cmd == "build":
        cmd_build(rest)
        return 0
    if cmd == "status":
        return cmd_status()
    if cmd == "preflight":
        return cmd_preflight(rest)
    if cmd == "setup":
        return cmd_setup(rest)
    if cmd == "check":
        return cmd_check(rest)
    print(f"[info-guard] unknown command: {cmd} (try `info-guard --help`)")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
