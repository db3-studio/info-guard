#!/usr/bin/env python3
"""info-guard — build the redaction pattern file for Hermes Agent.

The pattern file (redact_patterns.json) is the single interface between
your secrets and Hermes' redaction engine. Hermes reads it at every
message boundary and masks anything it contains — exact values, or
values appearing as KEY=value / KEY: value / KEY: "value".

Usage:
  info-guard build [ENV_FILE ...]   Build redact_patterns.json from .env
                                    sources (default: $HERMES_HOME/.env).
                                    Extra ENV_FILE args add more sources
                                    (e.g. docker compose .env files).
  info-guard status                 Show a summary of the current pattern file.
  info-guard preflight [DIR ...]    Zero-config leak scan of Hermes' own data
                                    (default: <home>/sessions, <home>/logs,
                                    <home>/cron/output) — run BEFORE deciding
                                    whether to install. Read-only, output
                                    masked, nothing written.
                                    --json: emit the assessment object
                                    (schema info-guard/assessment/v1, see
                                    docs/assessment-schema.md) to stdout;
                                    --json-out FILE: write it atomically
                                    (0600). The text report is unchanged.
  info-guard watch [DIR ...]        Re-run the scan and report deltas
                                    since the baseline (<state>/
                                    watch-baseline.json — value sha256
                                    only, 0600): exposure (new /
                                    resolved / changed values, families,
                                    files), protection configuration
                                    (literals / key patterns / mask
                                    policy, counts only), engine state
                                    transitions. First run creates the
                                    baseline; exit 1 on new values or a
                                    degraded engine (cron-friendly);
                                    config-only changes exit 0.
                                    --reset clears the baseline.
                                    --json: emit the delta object
                                    (schema info-guard/watch/v1, see
                                    docs/watch-schema.md) to stdout;
                                    --json-out FILE: write it atomically
                                    (0600).
  info-guard setup [--all]          Interactive bootstrap: reviews preflight
                                    candidates one by one (masked only),
                                    registers the ones you confirm as custom
                                    literals, picks .env sources, builds the
                                    pattern file. --all accepts every
                                    candidate non-interactively (agents/tests).
  info-guard check [--heal] [--battery]
                                    Health check / schedulable watchdog:
                                    engine marker, pattern file, custom
                                    literals, gitleaks, patch-state probe,
                                    supported-version floor, W12 seven-check
                                    smoke (proves the engine masks). --heal
                                    repairs a broken engine via install.sh
                                    (explicit only); --battery runs the full
                                    sandboxed battery. Exit 0 healthy,
                                    1 broken, 2 usage OR operational.
                                    No alert channel assumed — wire the
                                    non-zero exit to your scheduler.
  info-guard update [--check] [--json] [--rollback]
                                    Update the package from the configured
                                    origin (strict vX.Y.Z tags, HTTPS only;
                                    --check report-only exit 1 when newer;
                                    --rollback returns to the last verified
                                    release by commit id). Run BEFORE
                                    `hermes update` (D42 ordering contract).
  info-guard literals add VALUE...  Register custom literals (ids assigned;
                                    --mask STYLE, --file FILE for bulk,
                                    --json for script capture;
                                    --kind honeytoken plants a canary).
  info-guard literals list         List registered literals (masked only).
  info-guard literals remove ID    Remove one literal by id (Wave B).

Sources merged by `build`:
  1. Every KEY=value pair from the env files, except:
       - non-secret keys (hosts, urls, usernames, emails, ports, flags,
         schedules, model configs, ...) — masking those values was pure
         information loss, and hashing them made detection false-positive
       - values shorter than 8 chars (precision floor — no false friends;
         those keys are still covered by the key-pattern pass below)
  2. A curated key list (PIN, x_passphrase, client_secret, ...) whose
     values are masked regardless of length (KEY= form).
  3. <state>/custom_literals.json — hand-edited exact values (PII, emails,
     names, anything you decide is sensitive). Optional; survives rebuilds;
     masking only. Entries: plain strings, or {"value": ..., "mask": "full"}
     for full masking.

Output: <state>/redact_patterns.json (chmod 600).
State dir: $HERMES_HOME/state/info-guard/  (default $HERMES_HOME = ~/.hermes).

This is the redaction layer only. The full stack — secret inventory,
leak detection, rotation, watchdogs — is documented in docs/full-stack.md.
"""
import contextlib
import fcntl
import hashlib
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

_HERMES_HOME = Path(os.environ.get("HERMES_HOME") or os.path.expanduser("~/.hermes"))
STATE_DIR = _HERMES_HOME / "state" / "info-guard"
MATCHER = STATE_DIR / "redact_patterns.json"
CUSTOM_LITERALS = STATE_DIR / "custom_literals.json"

# Package version — bump with every feature/behavior change; the preflight
# report header prints it and `info-guard --version` exposes it. Tag vX.Y.Z.
_PACKAGE_VERSION = "0.7.0"

# Per-subcommand usage lines (v0.4.1, IG D55): printed by
# `info-guard <cmd> --help` (exit 0). Mirror the __doc__ usage block —
# keep both in sync when a command's options change.
_SUBCOMMAND_USAGE = {
    "build": "info-guard build [ENV_FILE ...]    Build redact_patterns.json from .env sources",
    "status": "info-guard status                  Show a summary of the current pattern file",
    "preflight": "info-guard preflight [DIR ...] [--full] [--json] [--json-out FILE]   Zero-config leak scan (read-only, masked)",
    "watch": "info-guard watch [DIR ...] [--reset] [--json] [--json-out FILE]   Delta monitor vs the watch baseline (cron-friendly exits)",
    "setup": "info-guard setup [--all]            Interactive bootstrap (registers custom literals, builds patterns)",
    "check": "info-guard check [--heal] [--battery]   Health check / schedulable watchdog (fast smoke by default; --heal repairs the engine; --battery runs the full sandboxed battery)",
    "update": "info-guard update [--check] [--json] [--rollback]   Update the package from the configured origin (run BEFORE `hermes update` — D42 ordering contract)",
    "literals": "info-guard literals add VALUE... [--mask STYLE] [--file FILE] [--json]   Register custom literals (ids assigned)\n"
                "info-guard literals list [--json]   List registered literals (id + masked value)",
}

VALID_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

# Keys that may appear in config/unit files but not in .env (PIN classes,
# router config dumps, NPM meta). Key-aware masking covers these regardless
# of value length.
EXTRA_KEY_PATTERNS = [
    "PIN", "WEBUI_PIN", "HERMES_WEBUI_PASSWORD", "x_passphrase", "client_secret",
    "refresh_token", "access_token", "dns_provider_credentials",
]

# Non-secret key classes: hosts/usernames/URLs/flags/schedules/... are NOT
# credentials — masking their values was pure information loss. The trailing
# \b keeps prefix classes (UNIFI_SSH_PASS, NPMI_PASSWORD...) out of this
# match; those still reach the literal pass via their values.
NON_SECRET_KEY_RE = re.compile(
    r"(?:host|url|user|email|path|home|dir|address|debug|_tools|proxy|browser|"
    r"wiki|image|web|moa|vision|terminal|searxng|firecrawl|vaultwarden_agent|"
    r"icloud|unifi|unraid|npm[ei]?|agh|hermes|model|smtp|cron|domain|timezone|"
    r"rclone|name|mode|dialectic|dream|peer_card|embedding|summary|deriver|"
    r"deduction|induction|overrides|structured_output|port|level|interval|"
    r"transport|users)\b", re.IGNORECASE)
# Exact non-secret keys whose values are emails/modes/env-var-NAMES (not
# secrets) — mid-string markers defeat the \b rule, so explicit denylist.
NON_SECRET_EXACT = {
    "EMAIL_ALLOWED_USERS", "SMTP_FROM", "SMTP_SECURITY",
    "DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV",
    "EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV",
    "GITHUB_APP_ID", "GITHUB_APP_INSTALLATION_ID",
}
# Boolean/config-flag keys (CACHE_ENABLED, SIGNUPS_ALLOWED, ...) — values are
# short booleans, never credentials; they only pollute the pattern file.
NON_SECRET_FLAG_RE = re.compile(
    r"(?:ENABLED?|ALLOWED|PROXIES|STEALTH|SENTRY|SIGNUPS|INVITATIONS|USE_AUTH)$",
    re.IGNORECASE)


def _is_non_secret_key(k: str) -> bool:
    return (NON_SECRET_KEY_RE.search(k) or k in NON_SECRET_EXACT
            or NON_SECRET_FLAG_RE.search(k))


def _parse_env_lines(lines):
    """Pure parser: [KEY: value] from already-split lines. Returns
    (entries, saw_content, saw_valid_entry). NO I/O — read/decode errors
    are the caller's job (_load_env raises SystemExit with a path-only
    message; _env_sources catches and classifies). Malformed lines
    (no '=', invalid key, empty) are skipped SILENTLY — the existing
    documented .env grammar (v0.4.x characterization: byte-identical
    behavior, verified by the battery's parser-characterization block).
    saw_content = any non-blank line; saw_valid_entry = >=1 valid
    KEY=value pair (the env-pass malformed-source classifier)."""
    out = {}
    saw_content = saw_valid_entry = False
    for line in lines:
        line = line.strip()
        if not line:
            continue
        saw_content = True
        if line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        k = k.strip().strip('"').strip("'")
        if not VALID_KEY_RE.match(k):
            continue
        v = v.strip().strip('"').strip("'")
        # strip trailing comments (only when preceded by whitespace; a
        # # inside the value is part of the value)
        v = re.sub(r"\s+#.*$", "", v)
        out[k] = v
        saw_valid_entry = True
    return out, saw_content, saw_valid_entry


def _load_env(path: Path):
    """Parse a .env file into {KEY: value}. Errors on a path are fatal
    (a source you named must exist); missing default sources are skipped.
    Parsing delegates to _parse_env_lines (identical semantics)."""
    try:
        lines = path.read_text().splitlines()
    except OSError:
        raise SystemExit(f"[info-guard] ✗ cannot read env source: {path}")
    return _parse_env_lines(lines)[0]


def _default_sources():
    """Default env sources: the active Hermes home's .env, plus ./ .env if
    present in the working directory. Additional files come from argv."""
    candidates = [_HERMES_HOME / ".env", Path.cwd() / ".env"]
    return [p for p in candidates if p.exists()]


def _atomic_write_json(path: Path, data: dict) -> None:
    """Write JSON atomically: temp file in the same directory (0600) →
    fsync → os.replace → fsync the directory. A concurrent reader sees
    either the old or the new file, never a partial one (external-audit
    B1/F4)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".redact-", suffix=".json",
                               dir=str(path.parent))
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
        try:
            d = os.open(str(path.parent), os.O_RDONLY)
            os.fsync(d)
            os.close(d)
        except OSError:
            pass
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def cmd_build(env_files):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    sources = [Path(p) for p in env_files] if env_files else _default_sources()
    if not sources:
        raise SystemExit("[info-guard] ✗ no .env sources found — pass env files "
                         "explicitly, or run from a directory with a .env")
    raw_lits, key_patterns, val_masks = [], {}, {}
    for path in sources:
        if not path.exists():
            raise SystemExit(f"[info-guard] ✗ env source not found: {path}")
        for k, v in _load_env(path).items():
            if _is_non_secret_key(k):
                continue
            if len(v) >= 8:                    # literal floor = precision optimization
                raw_lits.append(v)
            key_patterns[k] = True
    for k in EXTRA_KEY_PATTERNS:
        key_patterns[k] = True
    # Hand-edited custom literals (PII — emails, names, numbers, anything the
    # user decides is sensitive). The file is a SOURCE, never clobbered by
    # rebuilds: edit it, then `info-guard build` picks it up. Read through
    # the canonical loader (v0.4.2, MAJ-1) — build also triggers the lazy
    # registry migration, so a v1 registry cannot linger for build-only users.
    entries, ok, _doc = _load_registry()
    if not ok:
        print(f"[info-guard] ⚠ {CUSTOM_LITERALS.name} unreadable — skipped (fail-safe)")
    else:
        for item in entries:
            if isinstance(item, dict):
                v = item.get("value")
                if isinstance(v, str) and v:
                    raw_lits.append(v)
                    if "mask" in item:
                        val_masks[v] = item["mask"]
            elif isinstance(item, str) and item:
                raw_lits.append(item)
    # Longest-first so overlapping literals mask deterministically
    literals = []
    for v in sorted(set(raw_lits), key=len, reverse=True):
        literals.append({"value": v, "mask": val_masks[v]} if v in val_masks else v)
    _atomic_write_json(MATCHER, {
        "mask": {"head": 2, "tail": 2, "floor": 12},
        "literals": literals,
        "key_patterns": key_patterns,
        "generated": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    })
    os.chmod(MATCHER, 0o600)
    n_full = sum(1 for l in literals if isinstance(l, dict))
    print(f"[info-guard] matcher: {len(literals)} literals ({n_full} full-mask), "
          f"{len(key_patterns)} key patterns → {MATCHER}")


def cmd_status():
    if not MATCHER.exists():
        print(f"[info-guard] no pattern file yet — run `info-guard build`")
        return 1
    data = json.loads(MATCHER.read_text())
    lits = data.get("literals", [])
    n_full = sum(1 for l in lits if isinstance(l, dict))
    print(f"[info-guard] {len(lits)} literals ({n_full} full-mask), "
          f"{len(data.get('key_patterns', {}))} key patterns, "
          f"mask default {data.get('mask')}, generated {data.get('generated')}")
    print(f"[info-guard] file: {MATCHER} (mode {oct(MATCHER.stat().st_mode & 0o777)})")
    return 0


# ── preflight: zero-config leak scan of Hermes' own data ───────────────────
# Run BEFORE installing: answers "am I already leaking without knowing it?"
# No registry, no state, nothing written. Two detection passes over the
# transcript/log dirs: (a) key-shape regexes (KEY=value with secret-family
# keys, known token prefixes), (b) gitleaks' already-tuned ruleset
# (--redact=8, same invocation the full-stack detector uses).
_PREFLIGHT_DIRS = ["sessions", "logs", "cron/output"]

_KEY_FAMILY_RE = re.compile(
    r"(?:api[ _.\\-]?key|token|secret|passwd|password|credential|auth|authorization|pass|pw|pin)\b",
    re.IGNORECASE)
_KEY_FORM_RE = re.compile(
    r"\b([A-Za-z0-9_.\-]*" + _KEY_FAMILY_RE.pattern + r"[A-Za-z0-9_.\-]*)\s*[=:]\s*(\S+)",
    re.IGNORECASE)
_TOKEN_PREFIX_RE = re.compile(
    r"\b(sk-[A-Za-z0-9_\-]{10,}|key_[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|"
    r"github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9\-]{10,}|AKIA[A-Za-z0-9]{16}|"
    r"AC[a-z0-9]{32}|whsec_[A-Za-z0-9]{16,}|glpat-[A-Za-z0-9_\-]{10,}|"
    r"xr[a-z0-9_\\-]{10,}|eyJ[A-Za-z0-9_\\-]{8,}\.[A-Za-z0-9_\\-]{2,})\b")
_TRIVIAL_VALUES = {"true", "false", "null", "none", "yes", "no", "0", "1", "undefined", "auto"}
# Hard-mask for gitleaks Match context: any 16+ char run (token-shaped
# fragments survive gitleaks' own --redact in the Match field)
_HARD_MASK_RE = re.compile(r"[A-Za-z0-9_\-./+=]{16,}")
# Pinned, not floating: the release download verifies SHA256 against the
# release's own checksums file (external-audit B4/F7). Bump after testing a
# newer release — `info-guard preflight` refuses to install unverified versions.
_GITLEAKS_VERSION = "8.30.1"
_GITLEAKS_RELEASES_URL = f"https://api.github.com/repos/gitleaks/gitleaks/releases/tags/v{_GITLEAKS_VERSION}"


def _mask_value(v: str) -> str:
    if len(v) <= 10:
        return "***"
    return v[:2] + "..." + v[-2:]


def _n(x) -> str:
    """Thousands separator for every printed count (contract: numbers
    carry separators). The assessment object keeps raw ints — facts;
    only the render formats them."""
    return f"{x:,}"


INSTALL_MANIFEST = STATE_DIR / "install.json"


def _install_manifest():
    """The install manifest written by install.sh — records WHICH package
    version installed the engine (the report header shows it). None when
    absent (legacy install or not installed)."""
    try:
        data = json.loads(INSTALL_MANIFEST.read_text())
        if isinstance(data.get("version"), str):
            return data
    except (OSError, ValueError):
        pass
    return None


# Token-shaped value forms the report treats as "looks like a real secret"
# (highest-signal tier). Superset of _TOKEN_PREFIX_RE: adds JWT (eyJ),
# Discord bot tokens (MTQ), Firecrawl (fc-), and hash-like shapes — the
# families the friend's 2026-08-18 preflight actually surfaced.
_VALUE_TOKEN_RE = re.compile(
    r"^(?:eyJ[A-Za-z0-9_.\-]{6,}|sk-[A-Za-z0-9_\-]{10,}|key_[A-Za-z0-9]{20,}|"
    r"ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9\-]{10,}|"
    r"AKIA[A-Za-z0-9]{16}|AC[a-z0-9]{32}|whsec_[A-Za-z0-9]{16,}|glpat-[A-Za-z0-9_\-]{10,}|"
    r"xr[a-z0-9_\-]{10,}|MTQ[A-Za-z0-9_\-]{6,}|fc-[A-Za-z0-9_\-]{16,}|97ee[A-Za-z0-9_\-]{6,})")


def _value_class(value: str) -> str:
    """Classify a raw scan value into a report tier. The value itself is
    NEVER printed — only the tier label leaves this function.

    Returns one of:
      token-format   — looks like a real credential (JWT, ghp_, sk-, ...)
      placeholder    — example/placeholder text ('your...')
      already-masked — the value is already a mask (***) in the source
      key-name       — anything else: a key-name mention, code ref, path...
    """
    v = (value or "").strip().strip('"').strip("'")
    if not v or set(v) <= {"*"} or "«redacted-secret»" in v:
        return "already-masked"
    if v.lower().startswith("your"):
        return "placeholder"
    if _VALUE_TOKEN_RE.match(v):
        return "token-format"
    return "key-name"


def _value_type(value: str) -> str:
    """Human label for a token-shaped value (JWT, GitHub PAT, ...)."""
    v = (value or "").strip().strip('"').strip("'")
    if v.startswith("eyJ"):
        return "JWT"
    if v.startswith(("ghp_", "github_pat_")):
        return "GitHub PAT"
    if v.startswith("sk-"):
        return "API key"
    if v.startswith("MTQ"):
        return "Discord bot token"
    if v.startswith("fc-"):
        return "Firecrawl key"
    if v.startswith("key_"):
        return "generated key"
    if v.startswith("xox"):
        return "Slack token"
    if v.startswith("AKIA"):
        return "AWS key"
    if v.startswith("whsec_"):
        return "webhook secret"
    if v.startswith("glpat-"):
        return "GitLab PAT"
    if v.startswith("97ee"):
        return "hash-like token"
    return "token-shaped"


def _family_of(rule: str) -> str:
    """The secret-family name a hit belongs to: the key name for key-shape
    hits ('key-family:HASS_TOKEN' -> 'HASS_TOKEN'), the gitleaks RuleID for
    gitleaks hits, 'bare-token' for prefix-only token hits, and the env
    KEY for KNOWN hits ('known-env:HASS_TOKEN' -> 'HASS_TOKEN', v0.5.0)."""
    if rule.startswith("key-family:"):
        return rule[len("key-family:"):]
    if rule.startswith("known-env:"):
        return rule[len("known-env:"):]
    if rule == "known-prefix":
        return "bare-token"
    return rule


_GENERIC_KEY_RE = re.compile(
    r"^(?:api[ _.\\-]?key|token|secret|passwd|password|credential|auth|authorization|pass|pw|pin)$",
    re.IGNORECASE)


def _family_label(f: str) -> str:
    """Human-facing family name. A family that IS a generic key word (the
    literal env var name `token`) renders quoted so it never reads as a
    credential class; the synthetic bare-token family renders as
    '(no key context)'. Data/JSON family names stay unchanged."""
    if f == "bare-token":
        return "(no key context)"
    if f and _GENERIC_KEY_RE.match(f):
        return f'"{f}"'
    return f


def _known_env_keys() -> set:
    """Key NAMES only (never values — same rule as env-inspect.sh) from
    the default .env sources. Used to label DETAILS families as known
    credentials vs unknown (the interesting ones). Absent/empty .env →
    empty set: the report stays zero-config."""
    keys = set()
    for p in _default_sources():
        try:
            keys.update(_load_env(p).keys())
        except SystemExit:
            continue
    return keys


def _displayable_value(value: str) -> bool:
    """True when the 2+2 mask of a value shows real characters (alnum
    head AND tail). Code refs (${...), paths (/t...), markup (<l...>),
    and fragments (en...),) reveal nothing — they're detection
    artifacts, not credentials, and belong count-only in the sampler."""
    v = (value or "").strip().strip('"').strip("'")
    if len(v) < 5:
        return False
    return v[0].isalnum() and v[-1].isalnum()


def _key_scan(path: Path):
    """Key-shape + token-prefix pass over one file. Returns list of
    (cls, rule, line_no, value, masked_repr, context). The raw value is
    returned so the setup wizard can register it — it is NEVER printed."""
    hits = []
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return hits
    for lineno, line in enumerate(text.splitlines(), 1):
        line = line.rstrip("\n")
        for m in _KEY_FORM_RE.finditer(line):
            key, val = m.group(1), m.group(2)
            if val.lower() in _TRIVIAL_VALUES or re.fullmatch(r"\d{1,6}", val):
                continue
            if len(val) > 64 and not _VALUE_TOKEN_RE.match(val.strip().strip('"').strip("'")):  # giant non-token blob, not a value (long JWTs stay)
                continue
            # Bounded window around the match (40 before / 80 after) — the
            # old `line[:m.end()] + ...` prefix could be multi-KB when the
            # matched line was a huge blob, making reports unreadable.
            ctx = line[max(0, m.start() - 40): m.end() + 80]
            ctx = re.sub(re.escape(val), "***", ctx, count=1)
            hits.append(("KEY-SHAPE", f"key-family:{key[:40]}", lineno, val,
                         f"{key}={_mask_value(val)}", ctx))
        for m in _TOKEN_PREFIX_RE.finditer(line):
            tok = m.group(1)
            ctx = line[max(0, m.start() - 40): m.end() + 80]
            ctx = re.sub(re.escape(tok), "***", ctx, count=1)
            hits.append(("TOKEN-SHAPE", "known-prefix", lineno, tok,
                         _mask_value(tok), ctx))
    return hits


def _gitleaks_available() -> bool:
    """gitleaks on PATH, or in the usual user-level spots (~/go/bin from
    `go install`, ~/.local/bin from the release installer)."""
    if shutil.which("gitleaks"):
        return True
    for cand in (Path.home() / "go" / "bin" / "gitleaks",
                 Path.home() / ".local" / "bin" / "gitleaks"):
        if cand.is_file():
            return True
    return False


def _install_gitleaks() -> bool:
    """Best-effort install: `go install` when go exists, else the GitHub
    release binary into ~/.local/bin. Returns True on success."""
    import io
    import platform
    import tarfile
    import urllib.request

    go = shutil.which("go")
    if go:
        print(f"  installing via `go install github.com/gitleaks/gitleaks/v8@v{_GITLEAKS_VERSION}`…")
        try:
            subprocess.run([go, "install",
                            f"github.com/gitleaks/gitleaks/v8@v{_GITLEAKS_VERSION}"],
                           capture_output=True, timeout=600)
            if (Path.home() / "go" / "bin" / "gitleaks").is_file():
                print("  ✓ installed — note: ~/go/bin may need to be on PATH")
                return True
        except (subprocess.TimeoutExpired, OSError):
            pass
        print("  go install did not produce a usable binary — trying the release download…")
    os_name = {"linux": "linux", "darwin": "darwin"}.get(sys.platform)
    arch = {"x86_64": "x64", "amd64": "x64",
            "aarch64": "arm64", "arm64": "arm64"}.get(platform.machine())
    if not os_name or not arch:
        print("  ✗ unsupported platform for auto-install — grab the binary from "
              "https://github.com/gitleaks/gitleaks/releases")
        return False
    try:
        with urllib.request.urlopen(_GITLEAKS_RELEASES_URL, timeout=30) as r:
            release = json.load(r)
        tag = release["tag_name"]
        if tag != f"v{_GITLEAKS_VERSION}":
            print(f"  ✗ expected v{_GITLEAKS_VERSION} but the API returned {tag} — "
                  "refusing to install (pinned version, never floats)")
            return False
        # pick the asset from the API's list (names drift: x64, x86_64, …)
        want = f"{os_name}_{arch}.tar.gz"
        asset = next((a for a in release.get("assets", [])
                      if a.get("name", "").endswith(want)), None)
        if not asset:
            print(f"  ✗ no {want} asset in the v{_GITLEAKS_VERSION} release — "
                  "install manually: https://github.com/gitleaks/gitleaks/releases")
            return False
        # SHA256 against the release's own checksums file
        sum_name = f"gitleaks_{_GITLEAKS_VERSION}_checksums.txt"
        sum_asset = next((a for a in release.get("assets", [])
                          if a.get("name") == sum_name), None)
        if not sum_asset:
            print(f"  ✗ {sum_name} missing from the release — refusing an "
                  "unverifiable install")
            return False
        with urllib.request.urlopen(sum_asset["browser_download_url"],
                                    timeout=60) as r:
            checksums = r.read().decode()
        expected = next((ln.split()[0].lower() for ln in checksums.splitlines()
                         if asset["name"] in ln), None)
        if not expected:
            print(f"  ✗ no checksum entry for {asset['name']} — refusing install")
            return False
        print(f"  downloading {asset['name']} …")
        with urllib.request.urlopen(asset["browser_download_url"], timeout=180) as r:
            tarball = r.read()
        actual = hashlib.sha256(tarball).hexdigest()
        if actual != expected:
            print(f"  ✗ SHA256 mismatch ({actual[:12]}… ≠ {expected[:12]}…) — "
                  "refusing to install (supply-chain guard)")
            return False
        dest = Path.home() / ".local" / "bin"
        dest.mkdir(parents=True, exist_ok=True)
        with tarfile.open(fileobj=io.BytesIO(tarball), mode="r:gz") as tf:
            member = next(m for m in tf.getmembers()
                          if m.name == "gitleaks" or m.name.endswith("/gitleaks"))
            data = tf.extractfile(member).read()
        (dest / "gitleaks").write_bytes(data)
        (dest / "gitleaks").chmod(0o755)
        print("  ✓ installed to ~/.local/bin/gitleaks (SHA256 verified)")
        return True
    except Exception as e:  # network / archive / missing asset
        print(f"  ✗ auto-install failed: {e}")
        print("  install manually: https://github.com/gitleaks/gitleaks/releases")
        return False


def _ensure_gitleaks() -> bool:
    """Up-front gitleaks check for preflight/setup: when missing, explain
    the benefit and offer to install (interactive terminals only; non-tty
    runs get instructions and continue with the key-shape pass). Returns
    True when gitleaks is available afterwards."""
    if _gitleaks_available():
        return True
    print()
    print("[info-guard] ⚠ gitleaks not found on PATH.")
    print("  What it adds: the tuned-ruleset detection tier — 100+ provider-")
    print("  specific patterns (AWS, GitHub, OpenAI, generic API keys, …).")
    print("  Without it the scan still catches key-shaped values (KEY=value")
    print("  with secret-family keys) and known token prefixes (sk-, ghp_, …),")
    print("  but provider formats go unseen.")
    print("  gitleaks is OPTIONAL for Info Guard: the redaction layer never")
    print("  needs it — it powers this scan's second tier and the full-stack")
    print("  detector. Small (~10 MB), open source (MIT), runs fully offline")
    print("  once installed.")
    if not sys.stdin.isatty():
        print("  non-interactive run: install it separately (`go install "
              "github.com/gitleaks/gitleaks/v8@v8.30.1` or the GitHub release),")
        print("  then re-run — continuing with the key-shape pass only.")
        return False
    try:
        ans = input("  install gitleaks now? [y/N] ").strip().lower()
    except EOFError:
        return False
    if ans != "y":
        print("  continuing with the key-shape pass only.")
        return False
    ok = _install_gitleaks()
    if not ok:
        print("  continuing with the key-shape pass only.")
    return ok


def _gitleaks_bin() -> str:
    """Resolved gitleaks binary: PATH, ~/go/bin (go install), or
    ~/.local/bin (release installer) — PATH alone misses user-level
    installs on a scrubbed PATH."""
    for cand in (shutil.which("gitleaks"),
                 str(Path.home() / "go" / "bin" / "gitleaks"),
                 str(Path.home() / ".local" / "bin" / "gitleaks")):
        if cand and Path(cand).is_file():
            return cand
    return ""


def _gitleaks_scan(root: Path, redact=True):
    """gitleaks dir over one directory tree (already-tuned ruleset).
    Returns (hits, available) — available=False when gitleaks is missing.
    NEVER prints the raw Secret field; the Match line is hard-masked (all
    16+ char runs replaced) before it can reach the terminal.

    redact=True (preflight): the value is kept in memory only to derive a
    head/tail mask (2+2, same as every other tier) — it is never printed.
    The temp JSON report (mkstemp = 0600, unlinked in finally) holds the
    value exactly like the setup wizard's redact=False path does; we do
    NOT pass --redact to gitleaks because its redaction truncates the
    tail (verified 2026-08-18: redact=8 keeps 92% AND destroys the real
    last chars), which would break our 2+2 mask. redact=False keeps the
    full value in memory for the setup wizard (never echoed)."""
    binpath = _gitleaks_bin()
    if not binpath:
        return [], False
    report_fd, report = tempfile.mkstemp(suffix=".json")
    os.close(report_fd)
    hits = []
    try:
        cmd = [binpath, "dir", str(root), "--no-banner",
               "--report-format=json", f"--report-path={report}"]
        res = subprocess.run(cmd, capture_output=True, timeout=600)
        # D94 doctrine, degraded-engine case (evidence-gate r3, WB C8): gitleaks
        # exit codes are 0 = clean, 1 = leaks found, >1 = ERROR (bad flags, scan
        # failure, exec error). A failing engine must NEVER masquerade as a clean
        # scan — rc > 1 degrades to available=False (exit 2 upstream), the same
        # path the missing-engine case takes.
        if res.returncode > 1:
            return [], False
        try:
            findings = json.loads(Path(report).read_text())
        except (OSError, json.JSONDecodeError):
            findings = []
        for f in findings:
            rule = f.get("RuleID", "?")
            cls = "SUSPICIOUS" if rule == "generic-api-key" else "HIGH-CONFIDENCE"
            secret = f.get("Secret", "") or ""
            match = f.get("Match", "") or ""
            # Hard-mask: gitleaks' Match may keep long visible fragments.
            masked = _HARD_MASK_RE.sub("***", match)
            if not redact and secret and len(secret) >= 4:
                masked = masked.replace(secret, "***")
            disp = _mask_value(secret) if secret else "***"
            hits.append((cls, rule, f.get("File", "?"), f.get("StartLine", 0),
                         secret, disp, masked.strip()[:140]))
    except (subprocess.TimeoutExpired, OSError):
        pass
    finally:
        try:
            os.unlink(report)
        except OSError:
            pass
    return hits, True


def cmd_preflight(args):
    # --full: print the complete deduplicated ledger instead of the
    # one-example-per-family sampler (same masking, no cap).
    # --json: emit the assessment object to stdout (no chatter — the
    # object carries engine state); --json-out FILE: atomic 0600 write.
    # Exits: 0 clean · 1 findings · 2 usage OR operational failure
    # (engine unavailable / scan failure — never 0, never 1; v0.5.1, IG D94).
    full = "--full" in (args or [])
    as_json = "--json" in (args or [])
    json_out = None
    names = []
    a = list(args or [])
    i = 0
    while i < len(a):
        x = a[i]
        if x == "--json-out":
            i += 1
            if i >= len(a):
                print("[info-guard] preflight: --json-out requires a file "
                      "path", file=sys.stderr)
                return 2
            json_out = a[i]
        elif x.startswith("--"):
            # --full / --json handled above; other unknown flags are
            # tolerated but never silent (IG D55).
            if x not in ("--full", "--json"):
                print(f"Warning: unknown option '{x}'", file=sys.stderr)
        else:
            names.append(x)
        i += 1
    as_json = as_json or json_out is not None
    dirs = []
    for name in names or _PREFLIGHT_DIRS:
        p = _HERMES_HOME / name
        if p.is_dir():
            dirs.append(p)
    if not dirs:
        print(f"[info-guard] preflight: no scan targets under {_HERMES_HOME} "
              f"({', '.join(_PREFLIGHT_DIRS)}) — nothing to scan")
        return 0
    if as_json:
        # JSON purity (W15 doctrine, applied early): the missing-engine
        # advisory is chatter → stderr; stdout stays pure JSON (v0.5.1, IG D94).
        with contextlib.redirect_stdout(sys.stderr):
            _ensure_gitleaks()
    else:
        _ensure_gitleaks()
    total = 0
    for d in dirs:
        total += sum(1 for _ in d.rglob("*") if _.is_file())
    if not as_json:
        _print_install_status()
        print(f"[info-guard] preflight — scanning {len(dirs)} dirs / ~{total} "
              f"files under {_HERMES_HOME} (read-only, nothing written)")
    all_hits, gitleaks_ok, env_meta = _collect_hits(dirs, env_pass=True,
                                                    canary_pass=True)
    if not gitleaks_ok and not as_json:
        print("[info-guard] preflight: ⚠ gitleaks not found on PATH — ran "
              "key-shape pass only (install gitleaks for the tuned-ruleset pass)")
    all_hits.sort(key=lambda h: (h[2], h[3]))
    now = datetime.now(timezone.utc).isoformat(timespec="seconds").replace(
        "+00:00", "Z")
    try:
        ht_map = _honeytoken_id_map()
        assessment = _build_assessment(
            all_hits, [str(d.relative_to(_HERMES_HOME)) for d in dirs], total,
            gitleaks_ok, now, env_meta, _value_id_map(), ht_map)
        if as_json:
            if json_out:
                _atomic_write_json(Path(json_out), assessment)
                print(f"[info-guard] preflight: assessment written to {json_out}")
            else:
                print(json.dumps(assessment, indent=2))
            # Wave B exit ladder (proposal §3): 2 > 4 > 3 > 1 > 0.
            return (2 if not gitleaks_ok else
                    (4 if assessment["totals"].get("honeytoken", 0)
                     else (3 if assessment["totals"].get("known", 0)
                           else (1 if assessment["totals"]["credential_shaped"]
                                 else 0))))
        print()
        rc = _render_assessment(assessment, all_hits, full, env_meta)
        # Text mode: the renderer returns its own exit (it knows the
        # tier mix); ensure the Wave B ladder applies there too.
        if rc == 0 or rc == 1 or rc == 3:
            if not gitleaks_ok:
                rc = 2
            elif assessment["totals"].get("honeytoken", 0):
                rc = 4
            elif assessment["totals"].get("known", 0) and rc != 4:
                rc = 3
            elif assessment["totals"]["credential_shaped"] and rc not in (3, 4):
                rc = 1
        return rc
    except BaseException:
        # Sanitized CLI boundary (plan A1.7/CRIT-2 r3): any failure below
        # this line (assessment construction, JSON serialization, text
        # rendering, exit handling) surfaces as ONE generic line — raw
        # values never reach stderr/tracebacks. JSON mode emits no partial
        # object (stdout stays clean).
        print("[info-guard] preflight: internal error — scan incomplete "
              "(generic)", file=sys.stderr)
        return 2  # operational failure (v0.5.1, IG D94): a failed scan is
                  # never "findings" (1) and never clean (0)


def cmd_watch(args):
    """Watch mode: re-run the scan and report deltas since the baseline
    (value sha256 only, 0600 state file). First run (or --reset)
    creates the baseline; exit 1 on new values and degraded engine
    transitions — cron-friendly. The baseline is union-kept across
    tool/gitleaks version changes (known values never re-alert). v2:
    exposure + protection + engine deltas + --json/--json-out (see
    format-spec watch contract)."""
    opts, dirs = _parse_watch_args(args)
    if dirs is None:
        return 2  # usage error (--json-out without a path)
    reset = opts["reset"]
    scan_dirs = []
    for name in dirs or _PREFLIGHT_DIRS:
        p = _HERMES_HOME / name
        if p.is_dir():
            scan_dirs.append(p)
    dirs = scan_dirs
    json_mode = opts["json"]

    def say(msg):
        # JSON mode: stdout is pure JSON — informational chatter goes
        # to stderr (preflight precedent, review MIN E2).
        print(msg, file=sys.stderr if json_mode else sys.stdout)

    if not dirs:
        say(f"[info-guard] watch: no scan targets under {_HERMES_HOME} "
            f"({', '.join(_PREFLIGHT_DIRS)}) — nothing to scan")
        return 0
    if json_mode:
        # JSON purity: same treatment as preflight (v0.5.1, IG D94).
        with contextlib.redirect_stdout(sys.stderr):
            _ensure_gitleaks()
    else:
        _ensure_gitleaks()
    all_hits, gitleaks_ok, env_meta = _collect_hits(dirs, env_pass=True,
                                                    canary_pass=True)
    if not gitleaks_ok:
        say("[info-guard] watch: ⚠ gitleaks not found on PATH — key-shape "
            "pass only")
    if env_meta and env_meta.get("disabled"):
        # KNOWN tier disabled (no ok sources or env-pass failure): the
        # watch population excludes env-matched values this run — say so
        # (preflight precedent; advisory to stderr in JSON mode).
        say("[info-guard] watch: KNOWN pass disabled (no usable .env "
            "sources) — env-matched values not tracked this run")
    elif env_meta and env_meta.get("diagnostics"):
        for _d in env_meta["diagnostics"]:
            say(_d)
    all_hits.sort(key=lambda h: (h[2], h[3]))
    ht_map = _honeytoken_id_map()
    # Wave B W2 (IG D103, §5): review_list = ALL current-scan SUSPICIOUS
    # rows (gitleaks generic-api-key), deduped by value, count =
    # current-scan occurrences; report-only, never an alert; canary
    # values EXCLUDED (they serialize as HONEYTOKEN rows — one event).
    # review_list_complete = engine produced a full SUSPICIOUS result.
    review_rows = {}
    for h in all_hits:
        cls, rule, rel, line, value, masked, ctx = h
        if cls != "SUSPICIOUS":
            continue
        if _sha(value) in ht_map:
            continue  # canary exclusion (r2 MAJ-3)
        e = review_rows.setdefault(value, {"value_masked": _mask_value(value),
                                           "type": "SUSPICIOUS",
                                           "family": None, "count": 0})
        e["count"] += 1
        if e["family"] is None:
            f = _family_of(rule)
            e["family"] = f if f != "bare-token" else None
    review_list = sorted(review_rows.values(),
                         key=lambda r: (-r["count"], r["value_masked"]))
    review_list_complete = bool(gitleaks_ok)
    current = _watch_values(all_hits, env_meta, ht_map)
    # One assessment per run (A2): totals + per-file map for the
    # baseline snapshot, later rendered by watch/v1 JSON.
    total_files = sum(1 for d in dirs for _ in d.rglob("*") if _.is_file())
    now = datetime.now(timezone.utc).isoformat(timespec="seconds").replace(
        "+00:00", "Z")
    assessment = _build_assessment(
        all_hits,
        [str(d.relative_to(_HERMES_HOME)) if _HERMES_HOME in d.parents
         else str(d) for d in dirs],
        total_files, gitleaks_ok, now, env_meta, _value_id_map(), ht_map)
    protection = _snapshot_protection()
    # Live protected-value registry (v0.4.1, IG D52/D53): custom_literals
    # fingerprints from the CURRENT snapshot — declaring a literal takes
    # effect on the next run; no --reset needed (acceptance A3).
    known_fps = {fp.removeprefix("sha256:") for fp in
                 (protection.get("custom_literals") or {})
                 .get("fingerprints", [])}
    # value_id map (v0.4.2, IG D64/D65; Wave A Phase 2 — shared helper):
    # sha256(value) -> registry id, built from the loader's DEDUPED
    # entries (first-wins, NIT-3) — in-memory only; sha stays an
    # internal comparison primitive (D56). Read-only, annotation-only.
    sha_id = _value_id_map()
    assessment_snap = _snapshot_assessment_totals(assessment)
    baseline_path = STATE_DIR / "watch-baseline.json"
    prev = None
    if not reset and baseline_path.exists():
        try:
            prev = json.loads(baseline_path.read_text())
        except (OSError, ValueError):
            prev = None  # broken baseline: rebuild (never crash)
    empty_d = {"new_values": [], "resolved_values": [], "changed_values": [],
               "new_families": [], "resolved_families": [],
               "changed_files": []}

    def emit_json(prev_obj, d_obj, pd_obj, et_obj, pm_obj=None):
        obj = _watch_json_object(prev_obj, now, assessment_snap, d_obj,
                                 pd_obj, et_obj, pm_obj, review_list,
                                 review_list_complete)
        if opts["json_out"]:
            _atomic_write_json(Path(opts["json_out"]), obj)
            say(f"[info-guard] watch: JSON written to {opts['json_out']}")
        else:
            print(json.dumps(obj, indent=2))

    if prev is not None and prev.get("schema") == "info-guard/watch-baseline/v1":
        # v1→v2 migration (R2/A4): values reconciled against the CURRENT
        # scan — keep those still present (first_seen preserved), drop
        # absent ones (v1 never surfaced them); protection/assessment
        # snapshotted from current state. First v2 run is delta-free.
        _write_watch_baseline(baseline_path, current, prev,
                              protection, assessment_snap)
        say("[info-guard] watch: baseline migrated to v2 — protection "
            "state baselined at migration")
        if json_mode:
            pd0 = _protection_deltas(protection, protection)
            et0 = _engine_transition(protection, protection)
            emit_json(prev, empty_d, pd0, et0)
        # Migration run is still a scan: honor the operational-failure
        # exit (D94 doctrine, Wave A A20).
        return 2 if not gitleaks_ok else 0
    if prev is None:
        _write_watch_baseline(baseline_path, current, None,
                              protection, assessment_snap)
        verb = "reset — " if reset else ""
        say(f"[info-guard] watch: baseline {verb}created — "
            f"{_n(len(current))} known credential-shaped "
            f"value{'s' if len(current) != 1 else ''} "
            "(re-run to detect new ones)")
        if json_mode:
            pd0 = _protection_deltas(protection, protection)
            et0 = _engine_transition(protection, protection)
            emit_json(None, empty_d, pd0, et0)
        # Baseline-creation run is still a scan: a degraded engine must
        # not masquerade as clean (D94 doctrine, Wave A A20) — honor the
        # operational-failure exit even when there is nothing to delta.
        return 2 if not gitleaks_ok else 0
    if (prev.get("tool_version") != _PACKAGE_VERSION
            or prev.get("gitleaks_version") != _GITLEAKS_VERSION):
        say("[info-guard] watch: tool/gitleaks version changed — known "
            "values retained (union), updated rules may surface fresh "
            "findings")
    d = _watch_deltas(current, prev, assessment, sha_id)
    pd = _protection_deltas(prev.get("protection"), protection)
    et = _engine_transition(prev.get("protection"), protection)
    pm = _protected_value_matches(current, prev, known_fps, sha_id)
    pm_alarm = [m for m in pm if m["delta"] in ("new", "increased")]
    # Wave B (IG D103): canary-touch = a HONEYTOKEN protected row with
    # delta new/increased → exit 4 (proposal §3: watch-side 4 exists,
    # dominates 1). Already-baselined canaries (delta unchanged) never
    # alarm (D30/D53 value-level semantics).
    ht_alarm = [m for m in pm_alarm if m.get("type") == "HONEYTOKEN"]
    non_ht_alarm = [m for m in pm_alarm if m.get("type") != "HONEYTOKEN"]
    # Overlay rule (IG D54): JSON keeps protected rows in new_values /
    # changed_values AND protected_values (one event); the TERMINAL
    # renders them only in the PROTECTED block — the NEW VALUES / CHANGED
    # COUNTS display views below skip them (MAJ-1).
    base_rows = {v["value_sha256"]: v for v in (prev.get("values") or [])}

    def _disp_row(value, e):
        return {"value_masked": _mask_value(value), "type": e["type"],
                "family": e["family"], "count": e["count"]}

    display_new = [_disp_row(v, e) for v, e in current.items()
                   if e["value_sha256"] not in base_rows
                   and e["value_sha256"] not in known_fps]
    display_changed = []
    for v, e in current.items():
        if e["value_sha256"] in base_rows and e["value_sha256"] not in known_fps:
            old = base_rows[e["value_sha256"]].get("count", 0)
            if old != e["count"]:
                row = _disp_row(v, e)
                row["count_before"] = old
                display_changed.append(row)
    any_delta = bool(d["new_values"] or d["resolved_values"]
                     or d["changed_values"] or d["changed_files"]
                     or ht_alarm  # Wave B: a canary-touch alone is a delta
                                  # (it never appears in new_values — the
                                  # one-event rule) and MUST refresh the
                                  # baseline so the next run reads
                                  # delta: unchanged
                     or pd["status"] == "changed"
                     or et["state_before"] != et["state_after"])
    # Watch exit reduction (Wave A §2.5, A20; Wave B §3 — 2 > 4 > 1 > 0):
    # operational failure → 2 (engine unavailable / scan failure — never
    # 0, never 1; v0.5.1 D94 doctrine extended to watch); else a
    # canary-touch (HONEYTOKEN new/increased) → 4, dominates 1; else
    # new_values / engine degradation / new-or-increased protected alarm
    # → 1; else 0.
    exit_code = (2 if not gitleaks_ok else
                 (4 if ht_alarm else
                  (1 if (d["new_values"] or et["degraded"] or non_ht_alarm)
                   else 0)))
    if any_delta:
        # Changed run: header + per-track summaries + blocks (proposal
        # §2.3 guidance UX). All values masked 2+2 or counts only.
        say("Info Guard Watch")
        say("────────────────────────────────────────────")
        if ht_alarm:
            say("🚨 CANARY TOUCHED (HONEYTOKEN)")
            for m in ht_alarm:
                fam = _family_label(m["family"]) if m["family"] \
                    else "(no key context)"
                if m["delta"] == "increased":
                    occ = (f"+{_n(m['count'] - m['count_before'])} "
                           f"occurrence{'s' if m['count'] - m['count_before'] != 1 else ''} "
                           "since baseline")
                else:
                    occ = (f"{_n(m['count'])} occurrence"
                           f"{'s' if m['count'] != 1 else ''} (first detected)")
                say(f"    {m['value_masked']:<18} {m['type'][:22]:<24} "
                    f"{occ:<36} {fam} — investigate, then replant")
        if non_ht_alarm:
            say("🔴 PROTECTED VALUE RE-DETECTED")
            for m in non_ht_alarm:
                fam = _family_label(m["family"]) if m["family"] \
                    else "(no key context)"
                if m["delta"] == "increased":
                    occ = (f"+{_n(m['count'] - m['count_before'])} "
                           f"occurrence{'s' if m['count'] - m['count_before'] != 1 else ''} "
                           "since baseline")
                else:
                    occ = (f"{_n(m['count'])} occurrence"
                           f"{'s' if m['count'] != 1 else ''} (first detected)")
                say(f"    {m['value_masked']:<18} {m['type'][:22]:<24} "
                    f"{occ:<36} {fam}")
        if pm:
            say(f"  {_n(len(pm))} protected value"
                f"{'s' if len(pm) != 1 else ''} present "
                f"({_n(len(pm_alarm))} re-detected)")
        parts = []
        if display_new:
            parts.append(f"+{_n(len(display_new))} new value"
                         f"{'s' if len(display_new) != 1 else ''}")
        if d["resolved_values"]:
            parts.append(f"{_n(len(d['resolved_values']))} resolved")
        if display_changed:
            n_occ = sum(e["count"] - e["count_before"]
                        for e in display_changed)
            parts.append(f"+{_n(len(display_changed))} value"
                         f"{'s' if len(display_changed) != 1 else ''} "
                         f"{(n_occ and ('+' + _n(n_occ))) or '0'} "
                         f"occurrence{'s' if abs(n_occ) != 1 else ''}")
        if parts:
            say("🔴 EXPOSURE CHANGED (" + ", ".join(parts) + ")")
    if display_new:
        say("  NEW VALUES (masked 2+2 · type · family · count)")
        for e in display_new:
            fam = _family_label(e["family"]) if e["family"] \
                else "(no key context)"
            say(f"    {e['value_masked']:<18} {e['type'][:22]:<24} "
                f"{_n(e['count']):>6}  {fam}")
    if d["resolved_values"]:
        say("  RESOLVED (informational — not confirmed dead/revoked)")
        for e in d["resolved_values"]:
            fam = _family_label(e["family"]) if e["family"] \
                else "(no key context)"
            say(f"    {e['type'][:22]:<24} {_n(e['count']):>6}  {fam}  "
                f"(first seen {str(e['first_seen'])[:10]})")
        say("  No longer detected in the current scan scope. This does not "
            "confirm that the credential is dead or revoked.")
    if display_changed:
        say("  CHANGED COUNTS (informational)")
        for e in display_changed:
            fam = _family_label(e["family"]) if e["family"] \
                else "(no key context)"
            cb = e["count_before"]
            delta = e["count"] - cb
            say(f"    {e['value_masked']:<18} {e['type'][:22]:<24} "
                f"{_n(cb):>6} → {_n(e['count']):>6} "
                f"({delta:+d})  {fam}")
    if d["new_families"] or d["resolved_families"]:
        say("  FAMILIES — new: "
            + (", ".join(_family_label(f) if f else "(no key context)"
                         for f in d["new_families"]) or "—")
            + "; resolved: " + (", ".join(_family_label(f) if f
                                          else "(no key context)"
                                          for f in d["resolved_families"])
                                or "—"))
    if d["changed_files"]:
        say("  FILES WITH CHANGED COUNTS (informational)")
        for f in d["changed_files"]:
            say(f"    {f['file']}: {_n(f['before'])} → {_n(f['after'])}")
    if pd["status"] == "changed":
        cl = pd["custom_literals"]
        kp = pd["key_patterns"]
        rp = pd["redact_patterns"]
        mp = pd["mask_policy"]
        lit_delta = rp["literal_count_after"] - rp["literal_count_before"]
        kp_delta = (rp["key_pattern_count_after"]
                    - rp["key_pattern_count_before"])
        summ_bits = []
        if cl["added"] or cl["removed"]:
            summ_bits.append(f"custom literals +{cl['added']} / "
                             f"-{cl['removed']}")
        if rp["changed"]:
            summ_bits.append(f"{lit_delta:+d} literals")
            summ_bits.append(f"{kp_delta:+d} key patterns")
        if mp["changed"]:
            summ_bits.append("mask policy")
        say("🟢 PROTECTION CHANGED (" + ", ".join(summ_bits) + ")")
        if cl["added"] or cl["removed"]:
            say(f"  Custom literals +{cl['added']} / -{cl['removed']}")
        if kp["added"] or kp["removed"]:
            say(f"  Key patterns +{kp['added']} / -{kp['removed']}")
        if rp["changed"]:
            say(f"  Pattern literals {_n(rp['literal_count_before'])} → "
                f"{_n(rp['literal_count_after'])} · key patterns "
                f"{_n(rp['key_pattern_count_before'])} → "
                f"{_n(rp['key_pattern_count_after'])}")
        if mp["changed"]:
            say("  Mask policy changed")
        say("  Note: configuration deltas only — whether protection "
            "improved is answered by the next preflight, not watch")
    if et["state_before"] != et["state_after"]:
        if et["state_after"] == "active" and et["state_before"] in ("none",
                                                                    "partial"):
            eng_hdr = "🟢"
        elif et["state_after"] == "partial" and et["state_before"] == "active":
            eng_hdr = "🟠"
        else:
            eng_hdr = "🔴"
        say(f"{eng_hdr} ENGINE STATE ({et['state_before']} → "
            f"{et['state_after']})")
        if et["state_after"] == "active" and et["state_before"] == "none":
            say("  🟢 Engine installed")
        elif et["state_after"] == "active" and et["state_before"] == "partial":
            say("  🟢 Protection restored")
        elif et["state_after"] == "partial" and et["state_before"] == "active":
            say("  🟠 Protection degraded — Hermes is not fully applying "
                "the configuration")
        elif et["state_after"] == "none" and et["state_before"] == "active":
            say("  🔴 PROTECTION ENGINE REMOVED — existing configuration "
                "remains on disk, but Hermes is not actively applying it")
    if any_delta:
        say("────────────────────────────────────────────")
        say(f"Last baseline: {_fmt_generated(prev.get('generated', ''))}")
        say(f"Current scan:  {_fmt_generated(now)}")
        say("Run `info-guard preflight` for the complete assessment.")
        # refresh-on-delta policy (review MAJ A1): rewrite the baseline
        # with current state — values = current scan (absent ones
        # dropped), protection/assessment snapshots refreshed. Every
        # delta alerts exactly once; clean runs leave it untouched.
        _write_watch_baseline(baseline_path, current, prev,
                              protection, assessment_snap)
        say(f"[info-guard] watch: baseline refreshed — {_n(len(current))} "
            "values now known")
        if json_mode:
            emit_json(prev, d, pd, et, pm)
        return exit_code
    say(f"[info-guard] watch: no new credential-shaped values since "
        f"{_fmt_generated(prev.get('generated', ''))}")
    if json_mode:
        pm = _protected_value_matches(current, prev, known_fps, sha_id)
        emit_json(prev, d, pd, et, pm)
    # Clean run is still a scan: a degraded engine must not masquerade
    # as clean (D94 doctrine, Wave A A20) — the reduction's exit-2 path
    # applies even when there are no deltas.
    return exit_code


def _watch_values(all_hits, env_meta=None, ht_map=None):
    """Distinct credential-shaped values -> metadata for the watch
    baseline. sha256 of the raw value only — raw values never touch
    the baseline file.

    Wave A (Phase 3/4): env-matched values join the population
    regardless of shape class (CRIT-1 fold), and the KNOWN precedence
    partition is applied HERE too (same rule as _build_assessment):
    a shape/token/gitleaks hit whose (rel, line, value) is an env-known
    signature is dropped — the env match owns the row, so counts never
    double. env_meta carries known_sigs when the env pass ran.

    Wave B (IG D103): canary values (sha in ht_map) join the population
    REGARDLESS of shape class, typed HONEYTOKEN (registry-exact pass —
    a canary-touch is detected by value identity, never by shape)."""
    known_sigs = (env_meta or {}).get("known_sigs") or {}
    ht_map = ht_map or {}
    out = {}
    for h in all_hits:
        cls, rule, rel, line, value, masked, ctx = h
        sha = _sha(value)
        if sha in ht_map:
            # Wave B: canary values always join, typed HONEYTOKEN.
            # The canary pass OWNS the signature (KNOWN-precedence
            # pattern): only HONEYTOKEN-class hits count — the key-scan
            # and gitleaks hits for the same line/value are the same
            # occurrence (one line = one count), never double-counted.
            if cls != "HONEYTOKEN":
                continue
            e = out.setdefault(value, {"type": "HONEYTOKEN", "family": None,
                                       "count": 0, "value_sha256": sha})
            e["count"] += 1
            continue
        if cls != "KNOWN" and (rel, line, value) in known_sigs:
            # KNOWN precedence: the env pass owns this signature; the
            # shape hit is dropped (never double-counted). The KNOWN
            # hit itself is processed below.
            continue
        vc = _value_class(value)
        # Inclusion (Wave A Phase 4, CRIT-1 fold): env-matched KNOWN
        # rows join the watch population REGARDLESS of shape class —
        # this is the wave's deliberate population expansion (v1.7
        # CRIT-1; documented mandatory re-baseline on first v0.6.0 run).
        # Non-env rows keep the v0.4.x shape gate (HIGH-CONFIDENCE or
        # token-format only) so non-env behavior is byte-unchanged.
        if cls != "KNOWN" and cls != "HIGH-CONFIDENCE" and vc != "token-format":
            continue
        e = out.setdefault(value, {"type": _value_type(value), "family": None,
                                   "count": 0, "value_sha256": _sha(value)})
        if cls == "KNOWN":
            # Env-identity-verified rows are KNOWN by contract (proposal
            # §3.4 watch example: type "KNOWN"), regardless of shape —
            # the shape type is what the row would be WITHOUT the env
            # match; identity beats shape-guess.
            e["type"] = "KNOWN"
        e["count"] += 1
        if e["family"] is None:
            f = _family_of(rule)
            e["family"] = f if f != "bare-token" else None
        if cls == "KNOWN" and rule.startswith("known-env:"):
            # Env provenance: source_key = the env key (alphabetically
            # first across sources — the index already picks it). Carried
            # per value so watch rows can annotate source/source_key.
            key = rule[len("known-env:"):]
            e["source_key"] = key
            if e["family"] is None:
                e["family"] = key
    return out


def _watch_deltas(current, prev, assessment, sha_id=None):
    """Exposure deltas vs the v2 baseline (proposal §2.2). Row shape:
    new/changed carry `value_masked` (2+2 — the value is IN the scan);
    resolved rows carry type/family/count/first_seen with
    `value_masked: null` — the raw value is gone from the scan, and
    sha256 is forbidden on this surface (IG D49 / review MAJ A3).
    Protected values (sha in the registry set) additionally carry
    `value_id` — the SAME id on the overlay row and the protected row
    (IG D54 one-event rule); unregistered rows have no `value_id` key
    at all (absent, never null); resolved rows never carry one.
    Families are raw (None for bare-token — the terminal labels, JSON
    stays machine-friendly); files are per-file count diffs (baseline
    assessment.files vs current)."""
    baseline_rows = {v["value_sha256"]: v for v in prev.get("values", [])}
    known = set(baseline_rows)
    sha_id = sha_id or {}
    d = {"new_values": [], "resolved_values": [], "changed_values": [],
         "new_families": [], "resolved_families": [], "changed_files": []}
    fams_new, fams_res = set(), set()
    for value, e in current.items():
        sha = e["value_sha256"]
        fam = e["family"]
        vid = sha_id.get(sha)
        # Wave B (IG D103, §4.5): HONEYTOKEN rows are EXCLUDED from
        # new_values/changed_values/resolved_values — a canary-touch
        # serializes ONLY in protected_values[] (one event, D54; absent
        # canaries are absent rows, never resolved). The canary's
        # protected row carries its delta.
        if e.get("type") == "HONEYTOKEN":
            continue
        # Wave A annotations (proposal §3.4/P-C): source = precedence
        # winner (literal wins on collision); source_key present iff an
        # env match exists REGARDLESS of the winner (both-match rows
        # carry both); value_id iff registered. Absent, never null.
        env_key = e.get("source_key")
        if env_key is not None:
            src = "literal" if vid else "env"
        else:
            src = "literal" if vid else None
        if sha not in known:
            row = {"value_masked": _mask_value(value),
                   "type": e["type"], "family": fam,
                   "count": e["count"]}
            if src:
                row["source"] = src
            if env_key is not None:
                row["source_key"] = env_key
            if vid:
                row["value_id"] = vid
            d["new_values"].append(row)
            fams_new.add(fam)
        else:
            old = baseline_rows[sha]
            if old.get("count") != e["count"]:
                row = {"value_masked": _mask_value(value), "type": e["type"],
                       "family": fam, "count": e["count"],
                       "count_before": old.get("count", 0)}
                if src:
                    row["source"] = src
                if env_key is not None:
                    row["source_key"] = env_key
                if vid:
                    row["value_id"] = vid
                d["changed_values"].append(row)
    cur_shas = {e["value_sha256"] for e in current.values()}
    for sha, row in baseline_rows.items():
        if row.get("type") == "HONEYTOKEN":
            continue  # Wave B: absent canaries are absent, never resolved
        if sha not in cur_shas:
            d["resolved_values"].append(
                {"value_masked": None, "type": row.get("type"),
                 "family": row.get("family"), "count": row.get("count", 0),
                 "first_seen": row.get("first_seen")})
            fams_res.add(row.get("family"))
    d["new_families"] = sorted(f for f in fams_new if f)
    d["resolved_families"] = sorted(f for f in fams_res if f)
    # per-file credential_shaped count diff (files-with-findings map,
    # absent = 0; review MIN A2)
    base_files = (prev.get("assessment") or {}).get("files") or {}
    cur_files = {f["file"]: f["credential_shaped"]
                 for f in assessment.get("affected_files", []) or []
                 if f.get("credential_shaped")}
    for rel in sorted(set(base_files) | set(cur_files)):
        before = base_files.get(rel, 0)
        after = cur_files.get(rel, 0)
        if before != after:
            d["changed_files"].append({"file": rel, "before": before,
                                       "after": after})
    return d


def _protected_value_matches(current, prev, known_fps, sha_id=None):
    """Protected-value matches (v0.4.1, IG D53/D54; value_id v0.4.2,
    IG D64/D65): scan values whose value_sha256 is in the LIVE
    custom_literals fingerprint set (the app's known-value registry).
    Rows are the PUBLIC shape — masked 2+2, type, family, count,
    count_before (increased/decreased only), delta
    (new|increased|decreased|unchanged), value_id (the registry id of
    the matched entry — same id the overlay row carries, D54) — never
    sha256 (the sha is an internal comparison primitive only, D56). A
    value absent from the current scan never appears here: it surfaces
    via resolved_values. Empty/unreadable registry -> empty list
    (fail-safe)."""
    if not known_fps:
        return []
    sha_id = sha_id or {}
    baseline_rows = {v["value_sha256"]: v for v in (prev.get("values") or [])}
    rows = []
    for value, e in current.items():
        if e["value_sha256"] not in known_fps:
            continue
        row = {"value_masked": _mask_value(value), "type": e["type"],
               "family": e["family"], "count": e["count"]}
        vid = sha_id.get(e["value_sha256"])
        # Wave A annotations: protected rows are registered by
        # definition — source = "literal" (precedence winner on
        # collision, P-C); source_key present iff an env match also
        # exists; value_id iff the entry carries one (absent, never
        # null — hand-added entries without an id until backfilled).
        row["source"] = "literal"
        env_key = e.get("source_key")
        if env_key is not None:
            row["source_key"] = env_key
        if vid:
            row["value_id"] = vid
        old = baseline_rows.get(e["value_sha256"])
        if old is None:
            row["delta"] = "new"
        elif old.get("count", 0) != e["count"]:
            row["delta"] = ("increased" if e["count"] > old.get("count", 0)
                            else "decreased")
            row["count_before"] = old.get("count", 0)
        else:
            row["delta"] = "unchanged"
        rows.append(row)
    return rows


def _protection_deltas(prev_protection, protection):
    """Protection-config deltas vs the baseline snapshot. Counts +
    fingerprints only — never values (guidance's explicit don't).
    Custom literals and key patterns diff by exact fingerprint sets
    (duplicates = one, order-insensitive); redact_patterns whole-set
    fingerprints detect regeneration/order changes; mask policy
    compared structurally (IG D45)."""
    def fp_set(block, key):
        return set((block or {}).get(key, []) or [])
    d = {"status": "unchanged",
         "custom_literals": {"added": 0, "removed": 0},
         "key_patterns": {"added": 0, "removed": 0},
         "redact_patterns": {"changed": False, "literal_count_before": 0,
                             "literal_count_after": 0,
                             "key_pattern_count_before": 0,
                             "key_pattern_count_after": 0},
         "mask_policy": {"changed": False}}
    pb = prev_protection or {}
    cl_b = fp_set(pb.get("custom_literals"), "fingerprints")
    cl_a = fp_set(protection.get("custom_literals"), "fingerprints")
    d["custom_literals"]["added"] = len(cl_a - cl_b)
    d["custom_literals"]["removed"] = len(cl_b - cl_a)
    rp_b = pb.get("redact_patterns") or {}
    rp_a = protection.get("redact_patterns") or {}
    kp_b = fp_set(rp_b, "key_pattern_fingerprints")
    kp_a = fp_set(rp_a, "key_pattern_fingerprints")
    d["key_patterns"]["added"] = len(kp_a - kp_b)
    d["key_patterns"]["removed"] = len(kp_b - kp_a)
    d["redact_patterns"] = {
        "changed": (rp_a.get("literals_fingerprint") != rp_b.get("literals_fingerprint")
                    or rp_a.get("key_patterns_fingerprint") != rp_b.get("key_patterns_fingerprint")),
        "literal_count_before": rp_b.get("literal_count", 0),
        "literal_count_after": rp_a.get("literal_count", 0),
        "key_pattern_count_before": rp_b.get("key_pattern_count", 0),
        "key_pattern_count_after": rp_a.get("key_pattern_count", 0)}
    d["mask_policy"]["changed"] = (rp_a.get("mask_policy")
                                   != rp_b.get("mask_policy"))
    changed = (d["custom_literals"]["added"] or d["custom_literals"]["removed"]
               or d["key_patterns"]["added"] or d["key_patterns"]["removed"]
               or d["redact_patterns"]["changed"] or d["mask_policy"]["changed"])
    d["status"] = "changed" if changed else "unchanged"
    return d


def _engine_transition(prev_protection, protection):
    """Engine-state transition vs the baseline snapshot (proposal §2.5,
    IG D47). Returns {state_before, state_after, version_before,
    version_after, degraded} — degraded=True for active→partial and
    active→none (both exit 1); recoveries and installs exit 0."""
    e_b = (prev_protection or {}).get("engine") or {}
    e_a = (protection or {}).get("engine") or {}
    before = e_b.get("engine_state") or "none"
    after = e_a.get("engine_state") or "none"
    return {"state_before": before, "state_after": after,
            "version_before": e_b.get("engine_version"),
            "version_after": e_a.get("engine_version"),
            "degraded": (before, after) in (("active", "partial"),
                                            ("active", "none"))}


def _parse_watch_args(args):
    """watch argument parser (preflight precedent, L650-675): bare
    names = scan dirs; --reset; --json; --json-out FILE (requires a
    value -> stderr + exit 2; implies --json, file wins). Unknown --*
    flags are ignored (preflight precedent). Returns (opts, dirs) or
    (opts, None) when usage is invalid (caller returns 2)."""
    opts = {"reset": False, "json": False, "json_out": None}
    dirs = []
    a = list(args or [])
    i = 0
    while i < len(a):
        x = a[i]
        if x == "--reset":
            opts["reset"] = True
        elif x == "--json":
            opts["json"] = True
        elif x == "--json-out":
            i += 1
            if i >= len(a):
                print("[info-guard] watch: --json-out requires a file "
                      "path", file=sys.stderr)
                return opts, None
            opts["json_out"] = a[i]
        elif x.startswith("--"):
            # Unknown flags are tolerated (preflight precedent) but NEVER
            # silent: warn verbatim so a typo (--jason) is visible in
            # cron logs (IG D55).
            print(f"Warning: unknown option '{x}'", file=sys.stderr)
        else:
            dirs.append(x)
        i += 1
    opts["json"] = opts["json"] or opts["json_out"] is not None
    return opts, dirs


def _watch_json_object(prev, now, assessment_snap, d, pd, et, pm=None,
                       review_list=None, review_list_complete=True):
    """watch/v1 object (proposal §2.4, IG D49; Wave B W2 §5): the PUBLIC
    delta result. Exposure rows carry value_masked 2+2 (resolved rows:
    null — value gone, sha256 forbidden); protection = counts +
    fingerprints-derived deltas only; engine = transition facts.
    Wave B: review_list (report-only SUSPICIOUS rows, additive) +
    review_list_complete (false when the engine produced no full
    SUSPICIOUS result) — never raise the exit (D8 discipline)."""
    def totals(snap):
        if not snap:
            return None
        return {"credential_shaped": snap.get("credential_shaped", 0),
                "distinct_values": snap.get("distinct_values", 0),
                "family_attributed": snap.get("family_attributed", 0),
                "unattributed": snap.get("unattributed", 0)}
    before = totals((prev or {}).get("assessment"))
    rp = pd["redact_patterns"]
    changed = bool(d["new_values"] or d["resolved_values"]
                   or d["changed_values"] or d["changed_files"]
                   or pd["status"] == "changed"
                   or et["state_before"] != et["state_after"])
    return {
        "schema": "info-guard/watch/v1",
        "tool": {"name": "info-guard", "version": _PACKAGE_VERSION},
        "watch": {"generated": now,
                  "baseline_generated": (prev or {}).get("generated"),
                  "status": "changed" if changed else "clean"},
        "assessment": {"before": before, "after": totals(assessment_snap)},
        "exposure": {"new_values": d["new_values"],
                     "resolved_values": d["resolved_values"],
                     "changed_values": d["changed_values"],
                     "new_families": d["new_families"],
                     "resolved_families": d["resolved_families"],
                     "changed_files": d["changed_files"],
                     "protected_values": pm or [],
                     "review_list": review_list or [],
                     "review_list_complete": bool(review_list_complete)},
        "protection": {"status": pd["status"],
                       "custom_literals": pd["custom_literals"],
                       "key_patterns": pd["key_patterns"],
                       "redact_patterns": {"changed": rp["changed"],
                                           "literal_count_before": rp["literal_count_before"],
                                           "literal_count_after": rp["literal_count_after"],
                                           "key_pattern_count_before": rp["key_pattern_count_before"],
                                           "key_pattern_count_after": rp["key_pattern_count_after"]},
                       "mask_policy": pd["mask_policy"]},
        "engine": {"state_before": et["state_before"],
                   "state_after": et["state_after"],
                   "version_before": et["version_before"],
                   "version_after": et["version_after"]},
    }


def _sha(s):
    return hashlib.sha256(s.encode()).hexdigest()


def _snapshot_protection():
    """Protection-config snapshot for the watch baseline: fingerprints
    ONLY — sha256 of exact unique literal values / key patterns / mask
    policy / engine facts (proposal §2.1, IG D45). Raw literals never
    appear, not even masked (guidance's explicit don't). Missing or
    broken files -> zeros/None, never crash (fail-safe precedent)."""
    snap = {
        "custom_literals": {"count": 0, "fingerprints": []},
        "redact_patterns": {"literal_count": 0, "key_pattern_count": 0,
                            "literals_fingerprint": None,
                            "key_patterns_fingerprint": None,
                            "key_pattern_fingerprints": [],
                            "mask_policy": None},
        "engine": {"engine_state": "none", "engine_version": None},
    }
    # custom_literals.json via the canonical loader (v0.4.2): normalized
    # entries carry ids; fingerprints are sha256 of unique VALUES only —
    # the id field must never enter the fingerprint set (D45; an id leak
    # would fabricate added/removed counts on every migration).
    lits = []
    if CUSTOM_LITERALS.exists():
        entries, ok, _doc = _load_registry()
        if ok:
            for item in entries:
                v = item.get("value") if isinstance(item, dict) else item
                if isinstance(v, str) and v:
                    lits.append(v)
    uniq = sorted(set(lits))
    snap["custom_literals"]["count"] = len(uniq)
    snap["custom_literals"]["fingerprints"] = [
        "sha256:" + _sha(v) for v in uniq]
    # redact_patterns.json: machine-generated by `build` / `matcher
    # build`. Set fingerprints over sorted unique values — regeneration
    # may reorder, so order-insensitivity is the R1 contract.
    if MATCHER.exists():
        try:
            data = json.loads(MATCHER.read_text())
            rp_lits = []
            for item in data.get("literals", []) or []:
                v = item.get("value") if isinstance(item, dict) else item
                if isinstance(v, str) and v:
                    rp_lits.append(v)
            kp = data.get("key_patterns", {}) or {}
            mask = data.get("mask") or {}
            rp = snap["redact_patterns"]
            rp["literal_count"] = len(set(rp_lits))
            rp["key_pattern_count"] = len(kp)
            if rp_lits:
                rp["literals_fingerprint"] = "sha256:" + _sha(
                    json.dumps(sorted(set(rp_lits))))
            if kp:
                rp["key_patterns_fingerprint"] = "sha256:" + _sha(
                    json.dumps(sorted(kp)))
                # per-pattern fingerprints: the whole-set fingerprint
                # detects change but cannot produce the added/removed
                # counts watch/v1 contracts — exact diff needs the set.
                rp["key_pattern_fingerprints"] = [
                    "sha256:" + _sha(k) for k in sorted(kp)]
            if all(k in mask for k in ("head", "tail", "floor")):
                rp["mask_policy"] = {"head": mask["head"],
                                     "tail": mask["tail"],
                                     "floor": mask["floor"]}
        except (OSError, ValueError):
            pass  # unreadable: zeros/None, never crash
    # engine facts (same derivation as the assessment tool block)
    inst = _installation_status()
    manifest = _install_manifest()
    snap["engine"]["engine_state"] = (
        "active" if inst["engine"] else ("partial" if inst["partial"]
                                         else "none"))
    snap["engine"]["engine_version"] = (
        manifest.get("version") if manifest and inst["engine"] else None)
    return snap


def _snapshot_assessment_totals(assessment):
    """Totals + per-file credential_shaped map for the baseline's
    assessment block (derived from the ONE in-memory assessment watch
    builds per run — no second scan). Files with zero credential-shaped
    findings are omitted; the diff defaults absent files to 0."""
    t = assessment["totals"]
    files = {}
    for f in assessment.get("affected_files", []) or []:
        if f.get("credential_shaped"):
            files[f["file"]] = f["credential_shaped"]
    return {"credential_shaped": t["credential_shaped"],
            "distinct_values": t["distinct_values"],
            "family_attributed": t["family_attributed"],
            "unattributed": t["unattributed"],
            "files": files}


def _write_watch_baseline(path, current, prev, protection=None,
                          assessment=None, keep_values=False):
    """Write the watch baseline v2: {schema, generated, tool_version,
    gitleaks_version, values:[{value_sha256, type, family, count,
    first_seen}], protection, assessment}. Union semantics: rows known
    in prev keep their first_seen; new rows get today. Values absent
    from the current scan are DROPPED (resolved — the scan is the
    truth). With keep_values=True (setup stamping, IG D48): the value
    history is preserved VERBATIM from prev — only the protection +
    assessment snapshots are refreshed. 0600 via _atomic_write_json."""
    now = datetime.now(timezone.utc).isoformat(timespec="seconds").replace(
        "+00:00", "Z")
    prev_by_sha = {}
    if prev:
        prev_by_sha = {v["value_sha256"]: v for v in prev.get("values", [])}
    if keep_values:
        values = sorted(prev_by_sha.values(),
                        key=lambda v: (v.get("first_seen", ""),
                                       v.get("value_sha256", "")))
    else:
        values = []
        for value, e in current.items():
            old = prev_by_sha.get(e["value_sha256"])
            row = {"value_sha256": e["value_sha256"], "type": e["type"],
                   "family": e["family"], "count": e["count"]}
            row["first_seen"] = old.get("first_seen", now) if old else now
            values.append(row)
        values.sort(key=lambda v: (v["first_seen"], v["value_sha256"]))
    doc = {"schema": "info-guard/watch-baseline/v2",
           "generated": now,
           "tool_version": _PACKAGE_VERSION,
           "gitleaks_version": _GITLEAKS_VERSION,
           "values": values}
    if protection is not None:
        doc["protection"] = protection
    if assessment is not None:
        doc["assessment"] = assessment
    _atomic_write_json(path, doc)


def _fmt_generated(iso):
    """ISO-8601 -> the text report's display form (renderer owns
    language; the object carries machine time)."""
    try:
        dt = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return iso
    return dt.strftime("%Y-%m-%d %H:%M UTC")


# ── assessment object (v0.2.4 contract): facts only, no prose ────────────
# One scan -> one structured object. The text report below renders it;
# v0.3.0 serializes the same object (--json) and diffs it (watch). Raw
# values NEVER enter the object — masked forms only.

_PREFLIGHT_AREAS = ("sessions", "logs", "cron", "state")
_SESSION_DATE_RE = re.compile(r"(?:^|[/_])(?:session_)?(\d{8})_\d{6}")


def _area_of(rel: str) -> str:
    top = rel.split("/", 1)[0]
    return top if top in _PREFLIGHT_AREAS else "other"


def _session_date(rel: str):
    """Session date (YYYY-MM-DD) from a filename like session_20260505_...
    or 20260505_... — the honest 'when the session ran' evidence. Never
    filesystem mtime (reviewer fix #2: mtime is not an exposure date)."""
    m = _SESSION_DATE_RE.search(rel)
    if not m:
        return None
    d = m.group(1)
    try:
        datetime.strptime(d, "%Y%m%d")
    except ValueError:
        return None
    return f"{d[:4]}-{d[4:6]}-{d[6:]}"


def _area_status(value: int, masked: int):
    """Redaction status for an AREA scope (locations rows), under the
    owner's reading of the display: masked is the share of the area's
    candidates already redacted. protected = every candidate masked (or
    no candidates at all), mostly_masked = at least half, mixed = some,
    exposed = none."""
    if value == 0:
        return "protected" if masked else None
    if masked == 0:
        return "exposed"
    if masked >= value:
        return "protected"
    return "mostly_masked" if masked >= value / 2 else "mixed"


def _build_assessment(all_hits, dirs, files_scanned, gitleaks_ok, generated,
                      env_meta=None, value_id_map=None, ht_map=None):
    """Reduce the raw hit list into the assessment object. Classification
    is a PARTITION: every hit lands in exactly one tier (HONEYTOKEN,
    KNOWN, credential-shaped, key-name mention, or already-masked) —
    totals always reconcile. v0.5.0 (IG D57–D62/D70–D75): env_meta
    carries the KNOWN pass results (known_sigs = {(rel, line, value)},
    diagnostics, disabled) — KNOWN rows classify by signature (proposal
    §2.2/D28), counted per OCCURRENCE, value-deduped into totals.known.
    Wave A (Phase 2/6): value_id_map = per-run {sha256(value): id} from
    the shared registry lookup — registered KNOWN rows carry value_id
    (annotation-only, never affects matching/counts; absent, never
    null). Wave B (IG D103): ht_map = {sha256(value): id} for canary
    entries — HONEYTOKEN is the top tier (wins over KNOWN, shape,
    key-name, already-masked — proposal §4.3), classified FIRST."""
    from collections import Counter

    known_sigs = (env_meta or {}).get("known_sigs") or {}
    vid_map = value_id_map or {}
    ht_map = ht_map or {}
    n_tok = n_gl = n_key = n_mask = 0
    for h in all_hits:
        cls, _rule, rel, line, value, _masked, _ctx = h
        if _sha(value) in ht_map:
            continue  # HONEYTOKEN rows never feed shape/mention/mask buckets
        if (rel, line, value) in known_sigs:
            continue  # KNOWN rows never feed shape/mention/mask buckets
        if cls == "HIGH-CONFIDENCE":
            n_gl += 1
        elif cls == "SUSPICIOUS":
            if _value_class(value) == "token-format":
                n_tok += 1
            else:
                n_key += 1
        else:
            vc = _value_class(value)
            if vc == "token-format":
                n_tok += 1
            elif vc == "already-masked":
                n_mask += 1
            else:
                n_key += 1
    n_action = n_tok + n_gl
    n_rows = 0  # unique (file, line, value) candidate rows — the canonical count
    n_known_rows = 0  # unique (file, line, value) KNOWN rows (v0.5.0)
    n_ht_rows = 0  # unique (file, line, value) HONEYTOKEN rows (Wave B)
    known_occ = Counter()  # value -> occurrence count (per-occurrence, D28+)
    known_vals = {}  # value -> {type, count, fams} — distinct KNOWN values
    ht_vals = {}  # value -> {type, count, fams} — distinct canary values

    # Per-family / per-area / per-file tallies + the distinct-value proof
    # list. Real-value rows are deduped by (file, line, value) signature;
    # mentions count every hit row (390 mentions != 26 values).
    fam, loc, files, vals = {}, {}, {}, {}
    sig_seen = set()
    for h in all_hits:
        cls, rule, rel, line, value, masked, ctx = h
        f = _family_of(rule)
        area = _area_of(rel)
        fe = fam.setdefault(f, {"value": 0, "masked": 0, "mentions": 0,
                                "types": [], "areas": Counter(), "dates": set(),
                                "display": None, "first": None, "known": 0})
        le = loc.setdefault(area, {"value": 0, "masked": 0, "files": set(),
                                   "dates": set(), "known": 0})
        fe["mentions"] += 1
        fl = files.setdefault(rel, {"total": 0, "value": 0, "key": 0,
                                    "masked": 0, "known": 0})
        fl["total"] += 1
        sig = (rel, line, value)
        if _sha(value) in ht_map:
            # Wave B HONEYTOKEN tier — the top tier (proposal §4.3):
            # wins over KNOWN (a canary that is also a live .env value
            # IS the exposure), shape, key-name, and already-masked.
            # One row per file:line:value (D28 partition).
            if sig in sig_seen:
                continue
            sig_seen.add(sig)
            n_ht_rows += 1
            fl["known"] += 1  # honeytokens are registered values; kept in
                              # the "known" file column for the ledger view
            fe["known"] += 1
            le["known"] += 1
            le["files"].add(rel)
            t = "HONEYTOKEN"
            if t not in fe["types"]:
                fe["types"].append(t)
            fe["areas"][area] += 1
            d = _session_date(rel)
            if d:
                fe["dates"].add(d)
                le["dates"].add(d)
            ve = ht_vals.setdefault(value, {"type": "HONEYTOKEN", "count": 0,
                                            "fams": Counter()})
            ve["count"] += 1
            # HONEYTOKEN rows are UNATTRIBUTED (family: null per the
            # binding contract §4.2) — never derive a family from the
            # canary-pass rule; the fams counter stays empty.
            # §4.3 (O5): a canary that is also a live .env value — the
            # env index already tagged this signature with the source
            # key; carry it (both facts reported). HONEYTOKEN still wins.
            if sig in known_sigs and "source_key" not in ve:
                ve["source_key"] = known_sigs[sig]
            if fe["first"] is None:
                fe["first"] = h
            if fe["display"] is None and _displayable_value(value):
                fe["display"] = h
            continue
        if sig in known_sigs:
            # KNOWN tier (v0.5.0): env hits carry cls="KNOWN"; shape hits
            # with the same signature are DROPPED (never credential-shaped).
            # Occurrence count preserves per-occurrence hits (MAJ-2 r2).
            # Family/source_key come from the sig->key map — a collapsed
            # shape hit's rule never misattributes the KNOWN row (MAJ-6 r3).
            f = known_sigs[sig]
            if cls == "KNOWN":
                known_occ[value] += 1
            if sig in sig_seen:
                continue
            sig_seen.add(sig)
            n_known_rows += 1
            fl["known"] += 1
            fe["known"] += 1
            le["known"] += 1
            le["files"].add(rel)
            t = "KNOWN"
            if t not in fe["types"]:
                fe["types"].append(t)
            fe["areas"][area] += 1
            d = _session_date(rel)
            if d:
                fe["dates"].add(d)
                le["dates"].add(d)
            ve = known_vals.setdefault(value, {"type": "KNOWN", "count": 0,
                                               "fams": Counter()})
            ve["fams"][f] += 1
            if fe["first"] is None:
                fe["first"] = h
            if fe["display"] is None and _displayable_value(value):
                fe["display"] = h
            continue
        if sig in sig_seen:
            continue
        sig_seen.add(sig)
        vc = _value_class(value)
        is_real = cls == "HIGH-CONFIDENCE" or vc == "token-format"
        if is_real:
            n_rows += 1
            fl["value"] += 1
            fe["value"] += 1
            t = _value_type(value)
            if t not in fe["types"]:
                fe["types"].append(t)
            fe["areas"][area] += 1
            d = _session_date(rel)
            if d:
                fe["dates"].add(d)
            le["value"] += 1
            le["files"].add(rel)
            d = _session_date(rel)
            if d:
                le["dates"].add(d)
            ve = vals.setdefault(value, {"type": _value_type(value),
                                         "count": 0, "fams": Counter()})
            ve["count"] += 1
            ve["fams"][f] += 1
        elif vc == "already-masked":
            fl["masked"] += 1
            fe["masked"] += 1
            le["masked"] += 1
        else:
            fl["key"] += 1
        if fe["first"] is None:
            fe["first"] = h
        if fe["display"] is None and _displayable_value(value):
            fe["display"] = h

    for v, ve in known_vals.items():
        ve["count"] = known_occ[v]

    fam_attr = sum(e["value"] for f, e in fam.items() if f != "bare-token")
    unattr = fam.get("bare-token", {}).get("value", 0)

    # distinct values per family (for the "+N more values" hint in the
    # merged table; the full per-value list lives in --full)
    fam_distinct = {}
    for v, ve in vals.items():
        for f in ve["fams"]:
            fam_distinct[f] = fam_distinct.get(f, 0) + 1

    # families: facts + redaction status (exposed / mixed / protected);
    # KNOWN-only families (v0.5.0) appear with value=0, known>0
    families = []
    for f, e in sorted(fam.items(), key=lambda x: -x[1]["value"]):
        if e["value"] == 0 and e["masked"] == 0 and e["known"] == 0:
            continue
        disp = e["display"] or e["first"]
        example = None
        if disp:
            example = {"value_masked": _mask_value(disp[4]),
                       "file": disp[2], "line": disp[3]}
        shared = []
        if disp is not None:
            fams_of = vals.get(disp[4])
            if fams_of:
                cfams = fams_of["fams"]
                shared = sorted((g for g in cfams if g != f),
                                key=lambda g: (-cfams[g], g))
        if e["value"] > 0 and e["masked"] == 0:
            status = "exposed"
        elif e["value"] > 0:
            status = "mixed"
        elif e["known"] > 0 and e["masked"] == 0:
            status = "exposed"  # identity-verified material at rest, unmasked
        else:
            status = "protected"
        families.append({
            "family": f, "value": e["value"], "masked": e["masked"],
            "known": e["known"],
            "mentions": e["mentions"], "types": e["types"],
            "status": status,
            "priority": ("high" if e["value"] > 0 or e["known"] > 0
                         else "protected"),
            "distinct_values": fam_distinct.get(f, e["value"]),
            "areas": dict(e["areas"]), "dates": sorted(e["dates"]),
            "example": example,
        })
        if shared:
            families[-1]["shared_with"] = shared

    # locations: credential-shaped candidates bucketed by area (+ KNOWN
    # rows counted separately, v0.5.0 — additive, never folded into
    # credential_shaped)
    loc_items = sorted(loc.items(), key=lambda x: -x[1]["value"])
    total_val = sum(e["value"] for _, e in loc_items)
    locations = []
    for area, e in loc_items:
        if e["value"] == 0 and e["masked"] == 0 and e["known"] == 0:
            continue
        entry = {"area": area, "credential_shaped": e["value"],
                 "masked": e["masked"], "known": e["known"],
                 "percentage": (round(e["value"] * 100 / total_val, 1)
                                if total_val else 0.0),
                 "files_affected": len(e["files"])}
        st = _area_status(e["value"], e["masked"])
        if st:
            entry["status"] = st
        if e["dates"]:
            entry["date_range"] = {"source": "session_timestamp",
                                   "start": min(e["dates"]), "end": max(e["dates"])}
        locations.append(entry)

    # patterns: fact-structures, renderers own the language (reviewer
    # fix #3: observations are qualified, never definitive)
    patterns = []
    sess = loc.get("sessions")
    if total_val and sess and sess["value"] >= total_val / 2:
        pat = {"type": "historical_concentration", "severity": "info",
               "confidence": "moderate",
               "summary": "Candidates are concentrated in historical session transcripts.",
               "areas": ["sessions"]}
        if sess["dates"]:
            pat["date_range"] = {"source": "session_timestamp",
                                 "start": min(sess["dates"]), "end": max(sess["dates"])}
        patterns.append(pat)
    if n_mask > 0:
        patterns.append({"type": "redaction_active", "severity": "info",
                         "confidence": "high",
                         "summary": "A share of occurrences are already masked in the source.",
                         "areas": [a for a, e in loc.items() if e["masked"] > 0]})

    # redaction scopes: families and areas are both first-class
    # (reviewer fix #4: scope_type family | area)
    redaction = []
    for f, e in sorted(fam.items(), key=lambda x: -x[1]["value"]):
        if e["value"] == 0 and e["masked"] == 0:
            continue
        if e["value"] > 0 and e["masked"] == 0:
            st, note = "exposed", "value-shaped material remains at rest"
        elif e["value"] > 0:
            st = "mixed"
            note = (f"{_n(e['value'])} value-shaped · "
                    f"{_n(e['masked'])} masked "
                    f"occurrence{'s' if e['masked'] != 1 else ''}")
        else:
            st = "protected"
            note = (f"{_n(e['masked'])} "
                    f"occurrence{'s' if e['masked'] != 1 else ''} "
                    "already masked in the source")
        redaction.append({"scope_type": "family", "scope": f, "status": st, "note": note})
    for area, e in loc_items:
        if e["masked"] == 0:
            continue
        total = e["value"] + e["masked"]
        st = _area_status(e["value"], e["masked"])
        scope = "logs/agent.log" if area == "logs" else area
        redaction.append({"scope_type": "area", "scope": scope, "status": st,
                          "note": f"{_n(e['masked'])} of {_n(total)} "
                                  f"occurrence{'s' if total != 1 else ''} "
                                  "already masked in place"})

    # the proof list: distinct credential-shaped values, 2+2 masked,
    # family-attributed when determinable (reviewer: never forced);
    # KNOWN rows (v0.5.0) join with known:true + source_key (D73: no
    # value_id) — same sort, count = occurrences; Wave B HONEYTOKEN
    # rows join with known:false + value_id (proposal §4.2 — the
    # canary signal is the tier, never the known flag)
    top_values = []
    for v, e in vals.items():
        fam_c = e["fams"]
        known = [f for f in fam_c if f != "bare-token"]
        fam_n = max(known, key=lambda f: fam_c[f]) if known else None
        top_values.append({"value_masked": _mask_value(v), "type": e["type"],
                           "family": fam_n, "count": e["count"],
                           "families": sorted(e["fams"])})
    for v, e in known_vals.items():
        fam_c = e["fams"]
        fam_n = max(fam_c, key=lambda f: fam_c[f]) if fam_c else None
        row = {"value_masked": _mask_value(v), "type": "KNOWN",
               "family": fam_n, "count": e["count"],
               "families": sorted(e["fams"]),
               "known": True, "source_key": fam_n}
        vid = vid_map.get(_sha(v))
        if vid:
            row["value_id"] = vid  # absent, never null (D54); D73 lifted
        top_values.append(row)
    for v, e in ht_vals.items():
        # Wave B (proposal §4.2): HONEYTOKEN rows carry value_id (the
        # canary's registry identity — always present, canaries are
        # registered by construction) + known:false. family null
        # (unattributed, per the shipped nullable contract); source_key
        # only when the canary is ALSO a live .env value (§4.3 O5 —
        # both facts reported).
        row = {"value_masked": _mask_value(v), "type": "HONEYTOKEN",
               "family": None, "count": e["count"],
               "families": sorted(e["fams"]),
               "known": False}
        if e.get("source_key"):
            row["source_key"] = e["source_key"]
        vid = ht_map.get(_sha(v))
        if vid:
            row["value_id"] = vid
        top_values.append(row)
    top_values.sort(key=lambda x: -x["count"])

    affected_files = [
        {"file": rel, "total_findings": e["total"],
         "credential_shaped": e["value"], "key_name_mentions": e["key"],
         "already_masked": e["masked"], "known": e["known"]}
        for rel, e in sorted(files.items(), key=lambda x: -x[1]["total"])]

    telemetry = Counter(_family_of(h[1]) for h in all_hits)

    n_known = len(known_vals)
    n_ht = len(ht_vals)
    inst = _installation_status()
    manifest = _install_manifest()
    return {
        "schema": "info-guard/assessment/v1",
        "tool": {"name": "info-guard", "version": _PACKAGE_VERSION,
                 "gitleaks": _GITLEAKS_VERSION,
                 "installed": inst["engine"],
                 "engine_state": ("active" if inst["engine"] else
                                  ("partial" if inst["partial"] else "none")),
                 "engine_version": (manifest.get("version")
                                    if manifest and inst["engine"] else None)},
        "scan": {"generated": generated, "dirs": dirs,
                 "files_scanned": files_scanned, "read_only": True,
                 "gitleaks_ok": gitleaks_ok},
        "status": {
            "severity": "high" if (n_rows or n_known_rows or n_ht_rows) else "none",
            "action_required": n_rows > 0 or n_known_rows > 0 or n_ht_rows > 0,
            "summary": (
                "A registered canary value was found at rest. This is a "
                "canary-touch detection fact — investigate immediately."
                if n_ht_rows else
                ("Credential-shaped values were found at rest. They are "
                 "candidates, not confirmed leaks."
                 if n_rows else
                 ("Your .env values were found at rest. They are identity "
                  "matches — review whether they are still live."
                  if n_known_rows else
                  "No credential-shaped values found at rest."))),
            "credential_shaped": n_rows,
            # v0.5.0: True when >=1 KNOWN row; null otherwise (null = pass
            # disabled OR pass active with no match — documented; never
            # false in v0.5.0).
            "confirmed_active": True if n_known_rows else None,
        },
        "totals": {"findings": len(all_hits), "credential_shaped": n_rows,
                   "raw_detections": n_action, "distinct_values": len(vals),
                   "family_attributed": fam_attr, "unattributed": unattr,
                   "key_name_mentions": n_key, "already_masked": n_mask,
                   "known": n_known, "known_rows": n_known_rows,
                   "honeytoken": n_ht, "honeytoken_rows": n_ht_rows,
                   "partition": True},
        "families": {"total_with_values": sum(1 for f in families if f["value"] > 0),
                     "complete": True, "items": families},
        "locations": locations,
        "patterns": patterns,
        "redaction": redaction,
        "top_values": top_values,
        "affected_files": affected_files,
        "recommendations": [
            {"priority": "high", "step": 1, "title": "Rotate active candidates",
             "detail": (f"Check the {_n(len(vals))} distinct credential-shaped "
                        "values (see DISTINCT VALUES); rotate any still in use. "
                        "At-rest copies stay in these files either way "
                        "(masking never rewrites files); values already "
                        "superseded: ignore.")},
            {"priority": "medium", "step": 2, "title": "Choose prevention",
             "detail": ("Install Info Guard to mask future occurrences, or accept "
                        "recurrence and re-scan periodically. Install does NOT clean "
                        "what is already at rest — rotate first.")},
            {"priority": "low", "step": 3, "title": "Clean historical exposure",
             "detail": ("Archive/delete affected transcripts if appropriate. Rows only "
                        "clear when the files are deleted.")},
            {"priority": "info", "step": 4, "title": "Verify",
             "detail": ("After rotating, re-run once to confirm the rotation itself did "
                        "not leak the new values into logs. No routine re-run "
                        "otherwise.")},
        ],
        "appendix": {"telemetry": telemetry.most_common()},
    }


def _print_clean(a, env_meta=None):
    """Clean-scan report: header + STATUS 🟢 + EXECUTIVE SUMMARY with what
    it means/doesn't. No findings sections, no appendices. v0.5.0: the
    KNOWN section (disabled line / source diagnostics) still appears when
    the env pass is off — exactly one disabled line, plus one diagnostic
    per unavailable source (plan A1.5 matrix)."""
    t = a["totals"]
    nf = a["scan"]["files_scanned"]
    nm = t["already_masked"]
    print("STATUS: 🟢 CLEAN — no credential-shaped values found at rest.")
    print("        No changes were made by this scan. Nothing was written.")
    print()
    print("EXECUTIVE SUMMARY")
    print("  🟢 0         credential-shaped candidates")
    print(f"  🟠 {_n(t['findings']):<8} finding{'s' if t['findings'] != 1 else ''} — key-name mentions and already-masked only")
    print(f"  🟠 {_n(nf):<8} file{'s' if nf != 1 else ''} scanned")
    print(f"  🛡️ {_n(nm):<8} occurrence{'s' if nm != 1 else ''} already masked (prevention layer working)")
    if env_meta and (env_meta.get("diagnostics") or env_meta.get("disabled")):
        print()
        print("KNOWN (your .env values)")
        for d in env_meta.get("diagnostics", []):
            print(f"  {d}")
        if env_meta.get("disabled"):
            print(f"  {KNOWN_DISABLED_LINE}")
    print()
    print("  WHAT THIS MEANS")
    print("  No detected credential-shaped values AT REST in the scanned dirs — a")
    print("  solid baseline, but a snapshot of today, not a promise.")
    print("  What it does not mean:")
    print("    • future-proof — new services and new secrets create new")
    print("      exposure after this run")
    print("    • exhaustive — key-forms, known token prefixes, and gitleaks'")
    print("      ruleset; an unusual format could go unseen")
    print("  Why install anyway: Info Guard is PREVENTION, not cleanup.")
    print("  It masks your exact values before they ever reach logs/")
    print("  transcripts — and it NEVER removes what is already at rest:")
    print("  anything found stays until you rotate or delete it.")
    print("  Re-run preflight anytime (it's free) — e.g. after adding a")
    print("  new service, to confirm the baseline still holds.")
    return 0


def _render_assessment(a, all_hits, full, env_meta=None):
    """Render the 10-section report from the assessment object (the
    presentation layer). Sections appear only when their data is non-empty;
    the tier partition is stated explicitly (reviewer fix #5). v0.5.0:
    env_meta carries KNOWN-pass presentation facts (diagnostics, disabled,
    known_files — text-only, never serialized)."""
    t = a["totals"]
    nf = a["scan"]["files_scanned"]
    print(f"Info Guard v{_PACKAGE_VERSION} — Preflight Security Assessment")
    print(f"Read-only scan of Hermes home · values masked · generated {_fmt_generated(a['scan']['generated'])}")
    eng = a["tool"]["engine_state"]
    if eng == "active":
        ev = a["tool"]["engine_version"] or a["tool"]["version"]
        print(f"Engine: Info Guard INSTALLED v{ev} (ACTIVE) · gitleaks {a['tool']['gitleaks']}")
    elif eng == "partial":
        print("Engine: Info Guard PARTIAL — re-run install.sh to restore the redaction engine")
    else:
        print("Engine: Info Guard NOT INSTALLED — decide step (no redaction engine active)")
    print(f"SCOPE: {' · '.join(a['scan']['dirs'])} — {_n(nf)} file{'s' if nf != 1 else ''}")
    print()
    if not t["credential_shaped"] and not t.get("known", 0):
        return _print_clean(a, env_meta)

    # ── STATUS ─────────────────────────────────────────────────────────
    print("STATUS: 🔴 ACTION REQUIRED")
    print(f"        {a['status']['summary']}")
    print("        No changes were made by this scan. Nothing was written.")
    print()

    # ── EXECUTIVE SUMMARY ──────────────────────────────────────────────
    print("EXECUTIVE SUMMARY")
    nf = a["scan"]["files_scanned"]
    nm = t["already_masked"]
    print(f"  🔴 {_n(t['credential_shaped']):<8} credential-shaped candidates (values that look like real secrets)")
    n_known = t.get("known", 0)
    if n_known:
        m_files = len((env_meta or {}).get("known_files", set()))
        print(f"  🔵 {KNOWN_SUMMARY_CARD.format(n=n_known, m=m_files)}")
    parts = [f"{_n(t['family_attributed'])} family-attributed"]
    if t["unattributed"]:
        parts.append(f"{_n(t['unattributed'])} unattributed (generic token shapes)")
    else:
        parts.append("0 unattributed")
    parts.append(f"{_n(t['distinct_values'])} distinct values")
    raw_parts = [f"{_n(t['raw_detections'])} raw detections"]
    dups = t["raw_detections"] - t["credential_shaped"]
    if dups:
        raw_parts.append(f"{_n(dups)} duplicate detector hits collapsed")
    parts.append(" · ".join(raw_parts))
    print(f"  {'':10}" + " · ".join(parts))
    print(f"  🟠 {_n(nf):<8} file{'s' if nf != 1 else ''} scanned")
    fams_w = sum(1 for f in a["families"]["items"] if f["value"] > 0)
    print(f"  🔑 {_n(fams_w):<8} families with value-shaped material")
    print(f"  🛡️ {_n(nm):<8} occurrence{'s' if nm != 1 else ''} already masked (prevention layer working)")
    print()
    print("  WHAT MATTERS")
    types = sorted({v["type"] for v in a["top_values"]})
    tsum = ", ".join(types[:4])
    if len(types) > 4:
        tsum += "…"
    if not tsum:
        tsum = "token-shaped"
    print(f"  • The {_n(t['credential_shaped'])} candidates are token-shaped values ({tsum}); only you")
    print("    can confirm which are live (see CREDENTIAL EXPOSURE BY FAMILY).")
    if n_known:
        print(f"  • {_n(n_known)} known .env value{'s' if n_known != 1 else ''} {KNOWN_IDENTITY_NOTE}.")
    sess = next((l for l in a["locations"] if l["area"] == "sessions"), None)
    tot = sum(l["credential_shaped"] for l in a["locations"])
    if sess and tot and sess["credential_shaped"] >= tot / 2:
        print(f"  • {_n(sess['credential_shaped'])} of {_n(tot)} candidates sit in historical")
        print("    session transcripts — consistent with retained historical exposure")
        print("    (see EXPOSURE LOCATIONS).")
    if t["already_masked"]:
        prot = [r for r in a["redaction"]
                if r["status"] in ("protected", "mostly_masked")][:2]
        if prot:
            names = ", ".join(r["scope"] for r in prot)
            verb = "are" if len(prot) > 1 else "is"
            print(f"  • Redaction is working: {names} {verb} already masked in the source.")
    print()

    # ── KNOWN (your .env values) — pass state section (v0.5.0) ────────
    if env_meta and (env_meta.get("diagnostics") or env_meta.get("disabled")):
        print("KNOWN (your .env values)")
        for d in env_meta.get("diagnostics", []):
            print(f"  {d}")
        if env_meta.get("disabled"):
            print(f"  {KNOWN_DISABLED_LINE}")
        print()

    # ── CREDENTIAL EXPOSURE BY FAMILY ──────────────────────────────────
    # Merged table: candidates + the 2+2 proof value + redaction status
    # (owner refinements: VALUES + REDACTION EFFECTIVENESS consolidated;
    # sorted by status group, alphabetical within). The complete per-value
    # list lives in --full.
    print("CREDENTIAL EXPOSURE BY FAMILY")
    print(f"  {'Family':<34} {'Type':<24} {'Qty':>8}  {'Value (masked 2+2)':<18} Status")
    st_order = {"exposed": 0, "mixed": 1, "protected": 2}
    st_icon = {"exposed": "🔴 Exposed", "mixed": "🟡 Mixed",
               "protected": "🟢 Protected"}
    fams_sorted = sorted(a["families"]["items"],
                         key=lambda r: (st_order.get(r["status"], 3),
                                        r["family"].lower()))
    n_prot = sum(1 for r in a["families"]["items"] if r["status"] == "protected")
    n_prot_shown = 0
    for r in fams_sorted:
        if r["status"] == "protected":
            n_prot_shown += 1
            if n_prot_shown > 10:
                continue
        typ = " · ".join(r["types"]) or "—"
        if r["value"] > 0:
            qty = _n(r["value"])
            ex = r.get("example")
            val = ex["value_masked"] if ex else "—"
            n_more = r.get("distinct_values", 1) - 1
            if n_more > 0:
                val += f" ({_n(n_more)} more)"
            if r.get("shared_with"):
                val += "†"
        elif r.get("known", 0) > 0:
            qty = f"{_n(r['known'])} known"
            ex = r.get("example")
            val = ex["value_masked"] if ex else "—"
        else:
            qty = f"{_n(r['masked'])} masked"
            val = "—"
        status_label = (st_icon.get(r["status"], r["status"])
                        if r["value"] > 0 or r.get("known", 0) == 0
                        else "🔵 Known")
        print(f"  {_family_label(r['family'])[:32]:<34} {typ[:22]:<24} {qty:>8}  {val:<18} "
              f"{status_label}")
    if n_prot > 10:
        print(f"  …showing top 10 of {_n(n_prot)} protected families "
              "(`--full` lists every row)")
    print()
    foot = [(r["family"], r.get("shared_with")) for r in fams_sorted
            if r.get("shared_with") and r["value"] > 0]
    for fam, others in foot:
        print(f"  † {_family_label(fam)} — same value also under: "
              f"{', '.join(_family_label(g) for g in others)}")
    if foot:
        print()
    print("  DISTINCT VALUES — THE ROTATE LIST")
    tv = a["top_values"]
    for v in tv[:15]:
        fam_l = _family_label(v["family"]) if v["family"] else "(no key context)"
        print(f"  {v['value_masked']:<18} {v['type'][:22]:<24} "
              f"{_n(v['count']):>6}  {fam_l}")
    if len(tv) > 15:
        print(f"  …showing top 15 of {_n(len(tv))} distinct values "
              "(`--full` lists every value)")
    print()
    print("  If a masked value matches a credential you currently use, rotate it.")
    print("  If it belongs to a credential that has already been superseded, no")
    print("  action is required. Values are masked 2+2 — the full value exists")
    print("  only in the scanned file. `--full` lists every candidate row.")
    print()

    # ── EXPOSURE LOCATIONS (candidates + masked counts + area status) ──
    print("EXPOSURE LOCATIONS")
    st_icon = {"exposed": "🔴 Exposed", "mixed": "🟡 Mixed",
               "mostly_masked": "🟢 Mostly masked",
               "protected": "🟢 Protected"}
    for l in a["locations"]:
        if l["credential_shaped"] == 0 and l.get("masked", 0) == 0:
            continue
        masked = _n(l.get("masked", 0))
        if l["credential_shaped"] > 0:
            plural = "s" if l["credential_shaped"] != 1 else ""
            left = f"{_n(l['credential_shaped'])} credential-shaped candidate{plural} · {masked} masked"
        elif l.get("known", 0) > 0:
            kplural = "s" if l["known"] != 1 else ""
            left = f"{_n(l['known'])} known .env value{kplural} · {masked} masked"
        else:
            left = f"{masked} masked occurrences"
        st = st_icon.get(l.get("status"), "")
        print(f"  {l['area']:<10} {left:<34} {st}")
    print()
    pat = next((p for p in a["patterns"]
                if p["type"] == "historical_concentration"), None)
    if pat:
        print("  Pattern: Candidates are concentrated in historical session")
        dr = pat.get("date_range")
        if dr:
            dstr = (dr["start"] if dr["start"] == dr["end"]
                    else f"{dr['start']}–{dr['end']}")
            print(f"  transcripts ({dstr}, from session timestamps) — consistent with")
        else:
            print("  transcripts — consistent with")
        print("  retained historical exposure rather than a current logging failure.")
    else:
        areas = ", ".join(l["area"] for l in a["locations"]
                          if l["credential_shaped"] > 0 or l.get("known", 0) > 0)
        print(f"  Pattern: No single area dominates — candidates are spread across {areas}.")
    print()
    print("  SHOW AFFECTED FILES (top 10)")
    for f in a["affected_files"][:10]:
        cand = f["credential_shaped"]
        n_kn = f.get("known", 0)
        find_plural = "s" if f["total_findings"] != 1 else ""
        if cand or n_kn:
            cand_plural = "s" if cand != 1 else ""
            kn_suffix = (f" · {_n(n_kn)} known" if n_kn else "")
            print(f"  {f['file'][:56]:<58} {_n(f['total_findings'])} finding{find_plural} "
                  f"({_n(cand)} candidate{cand_plural}{kn_suffix})")
        else:
            print(f"  {f['file'][:56]:<58} {_n(f['total_findings'])} finding{find_plural}")
    print()

    # ── RECOMMENDED ACTIONS ────────────────────────────────────────────
    print("RECOMMENDED ACTIONS")
    if t.get("known", 0):
        m_files = len((env_meta or {}).get("known_files", set()))
        print(f"  🔵 {KNOWN_ACTIONS_LINE.format(n=t['known'], m=m_files)}")
    icons = {"high": "🔴", "medium": "🟠", "low": "🟡", "info": "🟢"}
    for r in a["recommendations"]:
        print(f"  {icons.get(r['priority'], '•')} {r['step']}. {r['title']} — {r['detail']}")
    print()
    print("  The tiers above are mutually exclusive: every finding is classified")
    print("  into exactly one — KNOWN (your .env values), credential-shaped,")
    print("  key-name mention, or already masked.")
    print()

    # ── APPENDIX B — finding ledger (sample or --full complete) ────────
    # APPENDIX A (detection telemetry) prints in --full mode only — the
    # main report is the assessment; mentions are forensic telemetry
    # (owner refinement: main report dropped it).
    from collections import OrderedDict
    deduped = OrderedDict()
    for h in all_hits:
        if h[0] not in ("HIGH-CONFIDENCE", "SUSPICIOUS"):
            if _value_class(h[4]) == "already-masked":
                continue
            if _mask_value(h[4]) == "***":
                continue
        key = (h[0], h[1], h[2], h[3], h[4])
        count, _ = deduped.get(key, (0, None))
        deduped[key] = (count + 1, h)
    if full:
        # APPENDIX A — the complete ledger (the main report's appendix);
        # APPENDIX B — telemetry (forensic mode only: mentions are NOT
        # findings).
        print(f"APPENDIX A — FINDING LEDGER (complete — {_n(len(deduped))} detections · "
              f"{_n(t['credential_shaped'])} unique candidate rows)")
        print("  Values are masked: you see the first and last 2 characters")
        print("  only. The full value exists only in the scanned file — it")
        print("  never leaves the machine.")
        for key, (n, h) in deduped.items():
            cls, rule, rel, line, value, masked, ctx = h
            print(f"  [{cls}] {rule}" + (f" (×{n} files/lines)" if n > 1 else ""))
            print(f"      {rel}:{line}  value={masked}")
            print()
        print("APPENDIX B — DETECTION TELEMETRY (key-name mentions — NOT findings)")
        for key, n in a["appendix"]["telemetry"][:25]:
            print(f"  {key[:32]:<34} × {_n(n)}")
        if len(a["appendix"]["telemetry"]) > 25:
            print("  …")
        print()
        print("  Mentions ≠ values at rest — detection telemetry, not findings.")
        print("  Actual leak hunting uses CREDENTIAL EXPOSURE BY FAMILY.")
    else:
        # SAMPLER: one example per family, ranked by signal, junk-display
        # rows (code refs/paths/markup) count-only
        known = _known_env_keys()
        fam_rows = OrderedDict()
        for key, (n, h) in deduped.items():
            fam = _family_of(h[1])
            if fam not in fam_rows:
                fam_rows[fam] = [0, None, None, False]
            fam_rows[fam][0] += n
            if fam_rows[fam][1] is None:
                fam_rows[fam][1] = h
            if fam_rows[fam][2] is None and _displayable_value(h[4]):
                fam_rows[fam][2] = h
            if _value_class(h[4]) == "token-format":
                fam_rows[fam][3] = True
        print("APPENDIX A — FINDING LEDGER")
        print("  (sample — one per family; `info-guard preflight --full` for the complete ledger)")
        print("  Values are masked: you see the first and last 2 characters")
        print("  only. The full value exists only in the scanned file — it")
        print("  never leaves the machine. Values too short to mask partially")
        print("  are counted in the totals but not listed here.")
        def _fam_rank(item):
            fam, (cnt, first, disp, has_token) = item
            if first[0] in ("HIGH-CONFIDENCE", "SUSPICIOUS"):
                rank = 0
            elif has_token:
                rank = 1
            else:
                rank = 2
            return (rank, -cnt)
        for fam, (cnt, first, disp, has_token) in sorted(fam_rows.items(), key=_fam_rank):
            h = disp or first
            cls, rule, rel, line, value, masked, ctx = h
            label = " — your .env key" if fam in known else ""
            print(f"  [{cls}] {rule} (×{cnt}){label}")
            if disp is not None:
                print(f"      {rel}:{line}  value={masked}")
            else:
                print("      (values are code refs / paths / markup — count-only)")
            print()
        print("  Known false-positive classes: code identifiers (password_hash =),")
        print("  config examples in docs, harmless IDs matching token prefixes.")
    # Exit ladder (Wave A, IG D83): 3 = KNOWN present (dominates), 1 =
    # credential-shaped only, 0 = clean. The D75 single-predicate
    # (known OR shape → 1) is superseded by the packaged ladder; known
    # values are the rotate-now signal and outrank shape guesses.
    return 3 if t.get("known", 0) > 0 else (1 if t["credential_shaped"] > 0
                                            else 0)


# ── KNOWN tier wording (v0.5.0, IG D57–D62/D70–D75) ──────────────────
# Canonical message constants (plan B5, NIT-2): docs + tests reference
# these exact strings; never drift. Vocabulary contract (D60): never
# "leak"/"confirmed"; "matches a current eligible .env value; review
# whether it is still live" (r3 NIT-3).
KNOWN_SUMMARY_CARD = "KNOWN (your .env values) — {n} in {m} files"
KNOWN_ACTIONS_LINE = ("{n} known .env values at rest in {m} files — "
                      "review/rotate if still live")
KNOWN_DISABLED_LINE = "KNOWN pass: no .env sources — disabled"
KNOWN_IDENTITY_NOTE = ("matches a current eligible `.env` value; review "
                       "whether it is still live")

# Candidate grammar for the env exact-value pass (v0.5.0, proposal §2.1.6):
# value-like runs of these chars, length >= 8. Quote chars are NOT in the
# class — surrounding quotes delimit runs (no strip step); a value with an
# INTERIOR quote can never be a candidate (documented exclusion).
_ENV_EXACT_RE = re.compile(r"[A-Za-z0-9_\-./+=:@%?&~#]{8,}")
_ENV_VALUE_MAX = 4096          # values > 4 KB skipped (documented envelope)
_ENV_SOURCE_MAX = 2 * 1024 * 1024  # sources > 2 MB skipped (documented envelope)
_ENV_LINE_CAP = 256            # per-line candidate cap (over-limit lines
                               # skipped for the env pass only, r3 MIN-4)

# Typed internal error codes for the sanitized adapter (plan A1.7): raw
# values never appear in exception args — only these codes cross the
# env-pass boundary.
ENV_SOURCE_UNREADABLE = "ENV_SOURCE_UNREADABLE"
ENV_SOURCE_MALFORMED = "ENV_SOURCE_MALFORMED"
ENV_PASS_INTERNAL = "ENV_PASS_INTERNAL"


def _env_sources():
    """Discover + classify env sources ONCE per preflight run (plan A1.5).

    Returns (index, sources, diagnostics):
      index      — {sha256(value): [keys...]} for eligible parsed values
                    (digest map ONLY — raw values never stored, never a
                    lookup key; proposal §2.1.5 letter, MAJ-1 r2)
      sources    — [{path, status: ok|unreadable|malformed, real: Path,
                     dev: int|None, ino: int|None}] — identity snapshot
                    (realpath + st_dev/st_ino where available) taken
                    BEFORE the candidate loop (MAJ-4 r1 ordering)
      diagnostics— pre-formatted masked lines, TEXT-ONLY (one per
                    unreadable|malformed source; never for absent/ok)

    Status rules (plan A1.5/A17 truth table): absent = not returned by
    _default_sources() (no diagnostic); unreadable = read fails;
    malformed = saw_content AND NOT saw_valid_entry (non-empty, zero
    valid entries); ok = saw_valid_entry OR zero-line empty file.
    Zero sources ok -> pass disabled (caller decides).
    """
    index, sources, diagnostics = {}, [], []
    for path in _default_sources():
        entry = {"path": path, "status": "ok", "real": None,
                 "dev": None, "ino": None}
        try:
            try:
                st = path.stat()
                entry["dev"], entry["ino"] = st.st_dev, st.st_ino
            except OSError:
                pass  # stat failure -> path-only identity (MIN-1 r2)
            entry["real"] = os.path.realpath(str(path))
            size = path.stat().st_size
            if size > _ENV_SOURCE_MAX:
                entry["status"] = "malformed"
                diagnostics.append(f"KNOWN pass: source {path.name} "
                                   "malformed — skipped")
                sources.append(entry)
                continue
            text = path.read_text(errors="replace")
        except OSError:
            entry["status"] = "unreadable"
            diagnostics.append(f"KNOWN pass: source {path.name} "
                               "unreadable — skipped")
            sources.append(entry)
            continue
        entries, saw_content, saw_valid = _parse_env_lines(
            text.splitlines())
        if saw_content and not saw_valid:
            entry["status"] = "malformed"
            diagnostics.append(f"KNOWN pass: source {path.name} "
                               "malformed — skipped")
            sources.append(entry)
            continue
        for k, v in entries.items():
            if _is_non_secret_key(k):
                continue
            if len(v) < 8 or v in _TRIVIAL_VALUES or len(v) > _ENV_VALUE_MAX:
                continue
            d = _sha(v)
            index.setdefault(d, [])
            if k not in index[d]:
                index[d].append(k)
        sources.append(entry)
    return index, sources, diagnostics


def _env_scan_line(line, index):
    """Candidate extraction + digest intersection for ONE line (plan
    A1.1). Returns [(digest, raw_candidate)] — raw candidates used ONLY
    for the hit tuple's value/mask, NEVER as a lookup key or exception
    payload (non-disclosure hard boundary). Empty on error (never raises
    with a raw value)."""
    out = []
    try:
        for m in _ENV_EXACT_RE.finditer(line):
            cand = m.group(0)
            if len(cand) > _ENV_VALUE_MAX:
                continue
            d = _sha(cand)
            if d in index:
                out.append((d, cand))
            if len(out) >= _ENV_LINE_CAP:
                break
    except Exception:
        return []
    return out


def _env_scan_file(path, index, src_ids):
    """Env pass over ONE candidate file (plan A1.1/A2 call graph: each
    file visited exactly once). Self-match exclusion (r3 CRIT-2, MAJ-4):
    skip when canonical path OR (st_dev, st_ino) matches a source
    identity. Returns (hits, sigs) where hits = env-known 7-tuples
    (one per OCCURRENCE — same-line repeats yield multiple hits, count
    preserved) and sigs = {(rel, line, value): source_key} for
    classification (the KEY travels with the signature so a collapsed
    shape hit can never misattribute the KNOWN family — MAJ-6 r3)."""
    hits, sigs = [], {}
    try:
        st = path.stat()
        dev, ino = st.st_dev, st.st_ino
    except OSError:
        dev, ino = None, None
    real = os.path.realpath(str(path))
    for src in src_ids:
        if real == src["real"]:
            return hits, sigs
        if (dev is not None and src["dev"] is not None
                and ino is not None and src["ino"] is not None
                and dev == src["dev"] and ino == src["ino"]):
            return hits, sigs
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return hits, sigs
    rel = os.path.relpath(str(path), str(_HERMES_HOME))
    for lineno, line in enumerate(text.splitlines(), 1):
        for d, cand in _env_scan_line(line, index):
            key = sorted(index[d])[0]  # alphabetically first key
            ctx = line[max(0, line.find(cand) - 40):
                       line.find(cand) + len(cand) + 80]
            ctx = re.sub(re.escape(cand), "***", ctx, count=1)
            hits.append(("KNOWN", f"known-env:{key}", rel, lineno, cand,
                         _mask_value(cand), ctx))
            sigs[(rel, lineno, cand)] = key
    return hits, sigs


def _collect_hits(dirs, redact=True, env_pass=False, canary_pass=False):
    """Shared scan used by preflight, watch and setup. Returns
    (all_hits, gitleaks_ok, env_meta) with 7-tuples
    (cls, rule, rel, line, value, masked, ctx).

    redact=False is for the setup wizard ONLY: gitleaks findings must
    carry their real value so the user can register it (the wizard never
    echoes it — it goes straight into custom_literals.json). Preflight
    stays redact=True (read-only, values blanked).

    env_pass=True (Wave A — the D71 boundary is lifted; preflight,
    watch, and setup all run the KNOWN exact-value pass): the KNOWN
    pass runs per file after _key_scan. preflight/watch classify via
    _build_assessment (env_meta); watch additionally expands its
    population to env-matched values (Phase 4, CRIT-1 fold). env_meta =
    {"known_sigs": {(rel,line,value): source_key}, "diagnostics": [...],
    "disabled": bool, "known_files": set} or None when env_pass=False.

    canary_pass=True (Wave B, IG D103): the registry-exact CANARY pass
    runs per file after _key_scan — any line containing a registered
    canary value emits a cls="HONEYTOKEN" hit. Independent of gitleaks
    (registry-exact value match, same plumbing as protected values);
    used by preflight + watch ONLY (setup never offers canaries as
    registration candidates)."""
    all_hits, gitleaks_ok = [], True
    env_meta = None
    ht_map = _honeytoken_id_map() if canary_pass else {}
    if env_pass:
        try:
            index, src_ids, diagnostics = _env_sources()
        except BaseException:
            # Sanitized adapter (plan A1.7): unexpected env-pass failure
            # degrades to disabled — generic, no raw values anywhere.
            index, src_ids, diagnostics = {}, [], []
            diagnostics.append(f"KNOWN pass: {ENV_PASS_INTERNAL} — disabled")
        env_meta = {"known_sigs": {}, "diagnostics": diagnostics,
                    "disabled": not any(s["status"] == "ok"
                                        for s in src_ids),
                    "known_files": set()}
    for d in dirs:
        for p in sorted(d.rglob("*")):
            if not p.is_file():
                continue
            for hit in _key_scan(p):
                all_hits.append((hit[0], hit[1],
                                 os.path.relpath(str(p), str(_HERMES_HOME)),
                                 *hit[2:]))
            if canary_pass and ht_map:
                # Wave B canary pass: exact-value scan of the file's
                # lines against the registered canary set. The canary
                # VALUE is kept in memory only (masked downstream, never
                # printed); the raw registry value is the match key.
                try:
                    text = p.read_text(errors="replace")
                except OSError:
                    text = ""
                for ln, line in enumerate(text.splitlines(), 1):
                    for cval in _canary_values(ht_map):
                        if cval in line:
                            all_hits.append((
                                "HONEYTOKEN", "honeytoken",
                                os.path.relpath(str(p), str(_HERMES_HOME)),
                                ln, cval, _HARD_MASK_RE.sub("***", line)[:140],
                                _HARD_MASK_RE.sub("***", line)[:140]))
                            break  # one hit per line (per-file:line:value row)
            if env_pass:
                try:
                    ehits, esigs = _env_scan_file(p, index, src_ids)
                except BaseException:
                    # Sanitized adapter (plan A1.7): a per-file env-pass
                    # failure degrades to a generic diagnostic — no raw
                    # values anywhere; other files and detectors continue.
                    ehits, esigs = [], {}
                    env_meta["diagnostics"].append(
                        f"KNOWN pass: {ENV_PASS_INTERNAL} — file skipped")
                env_meta["known_sigs"].update(esigs)
                for h in ehits:
                    all_hits.append(h)
                if ehits:
                    env_meta["known_files"].add(
                        os.path.relpath(str(p), str(_HERMES_HOME)))
        ghits, ok = _gitleaks_scan(d, redact=redact)
        gitleaks_ok = gitleaks_ok and ok
        for cls, rule, fname, line, value, masked, ctx in ghits:
            rel = os.path.relpath(fname, str(_HERMES_HOME)) if fname else str(d)
            all_hits.append((cls, rule, rel, line, value, masked, ctx))
    return all_hits, gitleaks_ok, env_meta


def _canary_values(ht_map):
    """Reverse the {sha256: id} canary map to the raw canary values —
    in-memory only (the map's keys are sha256, so the values must come
    from the registry load; cached per call). Returns a list of raw
    canary strings for exact line matching."""
    out = []
    entries, _ok, _doc = _load_registry()
    for item in entries:
        if isinstance(item, dict) and _entry_kind(item) == _HONEYTOKEN_KIND:
            v = item.get("value")
            if isinstance(v, str) and v and _sha(v) in ht_map:
                out.append(v)
    return out


# The 5 files the patch touches, with a marker per file. All present =
# ACTIVE; some = PARTIAL (a failed `hermes update` half-reverted the patch);
# none = MISSING. Single-marker greps miss partial reversion (external-audit
# B2/F5).
_ENGINE_MARKERS = {
    "agent/redact.py": "_redact_registry_patterns",
    "hermes_cli/config.py": "redact_patterns",
    "hermes_cli/main.py": "HERMES_REDACT_PATTERNS",
    "cli.py": "HERMES_REDACT_PATTERNS",
    "gateway/run.py": "HERMES_REDACT_PATTERNS",
}

# Supported Hermes release range. Bump BOTH when a rebase extends
# the tested matrix — keep in sync with README, docs/format-spec.md and
# .github/workflows/ci.yml. Tuples are release-tag date parts
# (v2026.8.18 -> (2026, 8, 18)); the .2-style suffixes compare correctly
# via zero-padding.
_SUPPORTED_MIN = (2026, 8, 3)     # v0.20.0 (v2026.8.3)
_SUPPORTED_MAX = (2026, 8, 19)    # v0.20.5 (v2026.8.19)


def _fmt_version(t):
    return "v" + ".".join(str(x) for x in t)


def _version_tuple(text):
    """First dotted-numeric run in text -> tuple of ints (None if absent)."""
    m = re.search(r"\d[\d.]*", text or "")
    if not m:
        return None
    return tuple(int(x) for x in m.group(0).split("."))


def _pad_tuple(t, n):
    return t + (0,) * (n - len(t))


def _checkout_version():
    """Best-effort live Hermes version as a tuple: git tag first, then the
    `hermes --version` date in parentheses. Returns (tuple|None, source)."""
    checkout = _HERMES_HOME / "hermes-agent"
    try:
        r = subprocess.run(["git", "-C", str(checkout), "describe",
                            "--tags", "--abbrev=0"],
                           capture_output=True, text=True, timeout=15)
        if r.returncode == 0 and r.stdout.strip():
            return _version_tuple(r.stdout.strip()), "git tag"
    except (OSError, subprocess.TimeoutExpired):
        pass
    hermes = shutil.which("hermes")
    if hermes:
        try:
            r = subprocess.run([hermes, "--version"], capture_output=True,
                               text=True, timeout=15)
            m = re.search(r"\((\d{4}\.\d{1,2}\.\d{1,2}(?:\.\d+)?)\)",
                          r.stdout or "")
            if m:
                return _version_tuple(m.group(1)), "hermes --version"
        except (OSError, subprocess.TimeoutExpired):
            pass
    return None, None


def _artifact_probe():
    """The package's patch vs the applied state in the live checkout.

    `git apply --reverse --check` passes only when the working tree's
    changes are EXACTLY this package's patch. A failing probe means
    the tree carries an OLDER/NEWER applied patch — the 'updated the
    package without re-running install.sh' trap, and the state that makes
    the next `hermes update` conflicting. Returns (ok, message|None)."""
    checkout = _HERMES_HOME / "hermes-agent"
    patch = Path(__file__).resolve().parent.parent / "patch" / \
        "redactor-registry-patterns.patch"
    if not (checkout / ".git").exists() or not patch.is_file():
        return True, None   # not a git checkout / source package incomplete
    try:
        r = subprocess.run(["git", "-C", str(checkout), "apply",
                            "--reverse", "--check", str(patch)],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return True, None
    if r.returncode == 0:
        return True, None
    return False, ("the applied patch differs from this package's artifact — "
                   "run ./install.sh to replace it in place (pattern file and "
                   "custom literals untouched)")


def _installation_status():
    """Best-effort detection of an existing Info Guard install: engine
    markers across all 5 patched files + the state artifacts that only
    install/build create."""
    status = {"state_dir": STATE_DIR.is_dir(),
              "patterns": MATCHER.exists(),
              "custom": CUSTOM_LITERALS.exists(),
              "markers": {}}
    for rel, marker in _ENGINE_MARKERS.items():
        p = _HERMES_HOME / "hermes-agent" / rel
        found = False
        if p.is_file():
            try:
                found = marker in p.read_text(errors="replace")
            except OSError:
                pass
        status["markers"][rel] = found
    n = sum(status["markers"].values())
    status["engine"] = n == len(_ENGINE_MARKERS)
    status["partial"] = 0 < n < len(_ENGINE_MARKERS)
    return status


def _print_install_status():
    """Frame the run: decide-step (not installed) vs. health check
    (installed — findings are residue, masking does not remove it)."""
    inst = _installation_status()
    if inst["engine"]:
        pf = "present" if inst["patterns"] else "MISSING"
        print(f"[info-guard] ℹ Info Guard INSTALLED (engine ACTIVE, 5/5 markers, "
              f"pattern file {pf}) — this run is a health check of at-rest "
              f"residue, not a decide step.")
    elif inst["partial"]:
        missing = ", ".join(rel for rel, ok in inst["markers"].items() if not ok)
        print(f"[info-guard] ⚠ Info Guard PARTIAL — patch markers missing in: "
              f"{missing}. A failed `hermes update` likely half-reverted the "
              f"patch: restore the files (`git checkout` them in the checkout) "
              f"and re-run ./install.sh before trusting this health check.")
    else:
        print("[info-guard] ℹ Info Guard not detected — this run is the "
              "before-install decide step.")


def _scan_dirs(names=None):
    return [p for name in (names or _PREFLIGHT_DIRS)
            for p in [_HERMES_HOME / name] if p.is_dir()]


_REGISTRY_VERSION = 2


def _new_id() -> str:
    """Opaque 64-bit random registration id (IG D65 — no derivation
    channel; value_id is NOT derivable from the value)."""
    return secrets.token_hex(8)


# ── Wave B (P3, IG D103): honeytoken kind model ────────────────────
_HONEYTOKEN_KIND = "honeytoken"
_HONEYTOKEN_PREFIX = "ht-"
_HONEYTOKEN_LEN = 24  # hex chars after the prefix (CSPRNG, D65 pattern)


def _generate_honeytoken() -> str:
    """Canary value: `ht-` + 24 CSPRNG hex chars (O1 — recognizable
    prefix; token_hex approach per D65 precedent, sized independently)."""
    return _HONEYTOKEN_PREFIX + secrets.token_hex(_HONEYTOKEN_LEN // 2)


def _entry_kind(item) -> str | None:
    """Kind classification for a registry entry (Wave B): absent →
    None (normal literal); `honeytoken` → the kind; ANY other value →
    None (treated as a normal literal — fail toward LESS escalation).
    Never raises; the loader's unknown-kind warning is emitted once per
    invocation by _load_registry, not here."""
    if isinstance(item, dict):
        k = item.get("kind")
        if isinstance(k, str) and k == _HONEYTOKEN_KIND:
            return _HONEYTOKEN_KIND
    return None


def _escaped_kind(kind: str, cap: int = 40) -> str:
    """Backslash-escape a kind value for the warning line (r2 NIT-1 /
    r3 MIN-2): backslash first, then quotes and control characters;
    truncated at `cap` characters (chars, not bytes) with `…` appended
    when the escaped form exceeds the cap. The literal value is never
    echoed — only this escaped metadata string."""
    esc = kind.replace("\\", "\\\\").replace("'", "\\'")
    esc = "".join(ch if ch.isprintable() and ch not in ("'",) else
                  esc_control(ch) for ch in esc)
    if len(esc) > cap:
        esc = esc[:cap] + "…"
    return esc


def esc_control(ch: str) -> str:
    """Escape a single control character for the warning line."""
    if ch == "\\":
        return "\\\\"
    if ch == "'":
        return "\\'"
    if ch == "\n":
        return "\\n"
    if ch == "\r":
        return "\\r"
    if ch == "\t":
        return "\\t"
    return f"\\x{ord(ch):02x}"


def _normalize_entries(raw):
    """Add-only normalization for registry literals (v0.4.2, IG D64/D65):
    plain strings -> {"value", "id"} · dicts without id -> +id · unknown
    entry fields preserved verbatim · non-string entries preserved
    verbatim (never dropped from the file; remain non-matchable as
    before) · duplicates collapse by value, first entry wins (D45 set
    semantics — one registration per unique value) · duplicate ids
    repaired deterministically (later entry gets a fresh id + stderr
    warning, never echoes the raw value).
    Returns (entries, n_new_ids, need_write)."""
    entries, seen, ids = [], set(), set()
    n_new, need = 0, False
    for item in raw:
        if isinstance(item, dict):
            v = item.get("value")
            if isinstance(v, str) and v:
                if v in seen:
                    continue
                seen.add(v)
                e = dict(item)  # preserve unknown fields (add-only)
                if not e.get("id"):
                    e["id"] = _new_id()
                    n_new += 1
                    need = True
                elif e["id"] in ids:
                    print(f"[info-guard] warning: duplicate literal id "
                          f"repaired — entry for {_mask_value(v)}",
                          file=sys.stderr)
                    e["id"] = _new_id()
                    n_new += 1
                    need = True
                ids.add(e["id"])
                entries.append(e)
            else:
                entries.append(dict(item))  # verbatim (MIN-1)
        elif isinstance(item, str) and item:
            if item in seen:
                continue
            seen.add(item)
            entries.append({"value": item, "id": _new_id()})
            ids.add(entries[-1]["id"])
            n_new += 1
            need = True
        else:
            entries.append(item)  # non-string preserved verbatim (MIN-1)
    return entries, n_new, need


def _load_registry():
    """Canonical registry loader (v0.4.2, IG D64/D65) — the ONE reader
    every stage uses (snapshot, setup, build, watch, literals):
    load → normalize (add-only) → validate (dup-id repair) → migrate
    (write only when stale; idempotent) → return ([entries], ok, doc).

    Contract:
    - missing file -> ([], True, None)  — empty registry is a valid,
      writable state (first-run `setup` must register; CRIT-1)
    - unreadable/parse-error -> ([], False, None)  — caller keeps the
      no-clobber guard; never crash, never clobber
    - doc = the parsed top-level object (writers preserve its unknown
      keys — add-only at top level too, MIN-1/evidence MIN-1)
    - migration: `version` missing or < 2 -> one atomic rewrite to
      v2 (unknown top-level keys preserved verbatim — MIN-2) with a
      one-time stderr note; same-version id backfill gets its own
      wording; `version` > 2 -> read-only pass-through (entries as-is,
      no writes, one stderr warning — MIN-5)
    - **migration/backfill write failure is NON-FATAL (MAJ-5 r1 fold,
      Wave A):** a read-only consumer (preflight/watch annotation
      lookup) must never crash because the migration could not
      persist — emit one stderr note, continue with the in-memory
      normalized entries, and return doc unchanged so canonical
      writers still see the original top level. A canonical WRITE
      command (literals add / setup) failing on an unwritable registry
      fails itself with exit 2 — that failure is the command's own
      atomic write, not this loader.
    - ALL chatter goes to stderr (stdout purity: watch --json /
      literals --json on the first post-upgrade run — MAJ-2)."""
    if not CUSTOM_LITERALS.exists():
        return [], True, None
    try:
        doc = json.loads(CUSTOM_LITERALS.read_text())
    except (OSError, ValueError):
        return [], False, None
    if not isinstance(doc, dict):
        return [], False, None
    raw = doc.get("literals", []) or []
    if not isinstance(raw, list):
        raw = []
    version = doc.get("version", 1)
    if version > _REGISTRY_VERSION:
        print(f"[info-guard] ⚠ {CUSTOM_LITERALS.name} version {version} is "
              f"newer than this app understands (v{_REGISTRY_VERSION}) — "
              f"loaded read-only", file=sys.stderr)
        return [e for e in raw if isinstance(e, (str, dict))], True, doc
    entries, n_new, need = _normalize_entries(raw)
    if need or version != _REGISTRY_VERSION:
        out = dict(doc)  # preserve unknown top-level keys (MIN-2)
        out["version"] = _REGISTRY_VERSION
        out["literals"] = entries
        try:
            _atomic_write_json(CUSTOM_LITERALS, out)
        except OSError:
            # Read-only filesystem (MAJ-5 r1): degrade gracefully —
            # annotation lookups proceed with in-memory entries; the
            # canonical writer's OWN write will fail loudly with exit 2.
            print(f"[info-guard] ⚠ {CUSTOM_LITERALS.name} migration could "
                  f"not be persisted (read-only?) — continuing in-memory",
                  file=sys.stderr)
            return entries, True, doc
        if version == _REGISTRY_VERSION:
            note = (f"{CUSTOM_LITERALS.name} backfilled — {_n(n_new)} "
                    f"entr{'y' if n_new == 1 else 'ies'} got ids")
        else:
            note = (f"{CUSTOM_LITERALS.name} migrated to v{_REGISTRY_VERSION} "
                    f"— {_n(n_new)} entr{'y' if n_new == 1 else 'ies'} got ids")
        print(f"[info-guard] {note}", file=sys.stderr)
    # Wave B (IG D103, A1): unknown `kind` values → ONE warning per
    # load/invocation (never persisted), exact wording, escaped + capped
    # (r1 NIT-10 / r2 NIT-1 / r3 MIN-2); the entry is treated as a normal
    # literal. A `honeytoken` kind is valid; absent kind is the default.
    warned = False
    for item in entries:
        if isinstance(item, dict) and isinstance(item.get("kind"), str) \
                and item["kind"] != _HONEYTOKEN_KIND and not warned:
            print(f"[info-guard] warning: unknown literal kind "
                  f"'{_escaped_kind(item['kind'])}' — treated as a normal "
                  f"literal", file=sys.stderr)
            warned = True
    return entries, True, doc


def _value_id_map():
    """Per-run deduplicated value-to-ID lookup (Wave A, Phase 2 — NIT-11
    r1: NOT a fingerprint-to-ID mapping; IDs are CSPRNG-generated and
    value-independent per S1, the lookup is by deduplicated VALUE).

    Built from the canonical loader's deduplicated entries (first-wins,
    v0.4.2 NIT-3) as {sha256(value): id} — in-memory only, read-only,
    annotation-only (D73: never affects matching or counts). Consumers
    that lack a registry entry simply omit `value_id` (absent, never
    null; D54). Never writes, never backfills — a canonical write
    command owns persistence (MAJ-5 r1)."""
    out = {}
    entries, _ok, _doc = _load_registry()
    for item in entries:
        if isinstance(item, dict):
            v, i = item.get("value"), item.get("id")
            if isinstance(v, str) and v and isinstance(i, str) and i:
                out.setdefault(_sha(v), i)  # first-wins
    return out


def _honeytoken_id_map():
    """Wave B (IG D103, A1/A4): {sha256(value): id} for CANARY entries
    only (`kind: honeytoken`) — the registry-exact canary-touch lookup.
    Same discipline as _value_id_map: in-memory, read-only,
    annotation-only, first-wins, never writes. A value registered as a
    canary is BOTH in _value_id_map (value_id join for all surfaces)
    and here (canary classification)."""
    out = {}
    entries, _ok, _doc = _load_registry()
    for item in entries:
        if isinstance(item, dict) and _entry_kind(item) == _HONEYTOKEN_KIND:
            v, i = item.get("value"), item.get("id")
            if isinstance(v, str) and v and isinstance(i, str) and i:
                out.setdefault(_sha(v), i)  # first-wins
    return out


def cmd_literals(args):
    """literals subcommand group (v0.4.2, IG D69): add/list registry
    entries. Every mutation goes through the canonical _load_registry()
    normalize/write path — no second implementation (external review
    requirement 3). D55 rules: --help anywhere -> usage exit 0 (global
    handler); unknown --* flags -> verbatim stderr warning + continue;
    usage errors -> exit 2. Result lines on stdout, ALL chatter on
    stderr (MAJ-2)."""
    if not args:
        print(_SUBCOMMAND_USAGE["literals"], file=sys.stderr)
        return 2
    sub, rest = args[0], args[1:]
    if sub == "add":
        return _literals_add(rest)
    if sub == "list":
        return _literals_list(rest)
    if sub == "remove":
        return _literals_remove(rest)
    print(f"[info-guard] unknown literals subcommand: {sub} "
          f"(try `info-guard literals --help`)", file=sys.stderr)
    return 2


def _literals_add(args):
    json_mode, mask, file_path, kind, values = False, None, None, None, []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--json":
            json_mode = True
        elif a == "--kind":
            if i + 1 >= len(args):
                print("[info-guard] usage: --kind KIND required "
                      "(only 'honeytoken' is supported)", file=sys.stderr)
                return 2
            if kind is not None:
                print("[info-guard] usage: --kind may only be given once",
                      file=sys.stderr)
                return 2
            kind = args[i + 1]  # validated below (r1 MAJ-1: exact domain)
            i += 1
        elif a == "--mask":
            if i + 1 >= len(args):
                print("[info-guard] usage: --mask STYLE required",
                      file=sys.stderr)
                return 2
            mask = args[i + 1]  # applies to every value; last wins (MIN-4)
            i += 1
        elif a == "--file":
            if i + 1 >= len(args):
                print("[info-guard] usage: --file FILE required",
                      file=sys.stderr)
                return 2
            file_path = args[i + 1]
            i += 1
        elif a.startswith("--"):
            print(f"[info-guard] Warning: unknown option '{a}'",
                  file=sys.stderr)
        else:
            values.append(a)
        i += 1
    if kind is not None and kind != "honeytoken":
        # r1 MAJ-1: `--kind` accepts exactly `honeytoken`; any other
        # value, missing value, or repeated flag is usage exit 2 with no
        # registry mutation. The registry file's tolerance for unknown
        # kind values does NOT extend to the CLI.
        print(f"[info-guard] usage: --kind accepts only 'honeytoken' "
              f"(got '{kind}')", file=sys.stderr)
        return 2
    if file_path:
        if kind is not None:
            print("[info-guard] usage: --file cannot be combined with "
                  "--kind honeytoken — a canary is planted one at a time",
                  file=sys.stderr)
            return 2
        try:
            with open(file_path) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#"):
                        values.append(line)
        except OSError:
            print(f"[info-guard] ✗ cannot read {file_path}", file=sys.stderr)
            return 2
    if kind is not None:
        # Wave B (IG D103, A2): honeytoken plant path.
        if mask is not None:
            print("[info-guard] usage: --mask cannot be combined with "
                  "--kind honeytoken — canaries are always mask: full",
                  file=sys.stderr)
            return 2
        if len(values) > 1:
            print("[info-guard] usage: --kind honeytoken takes at most one "
                  "VALUE (omit it to generate one)", file=sys.stderr)
            return 2
        explicit = values[0] if values else None
        if explicit is not None:
            # Value validation (r1 MAJ-7 / r2 MAJ-4): no control chars,
            # no line terminators, no empty/whitespace-only values.
            if not explicit.strip() or any(ord(c) < 32 or ord(c) == 127
                                           for c in explicit):
                print("[info-guard] usage: honeytoken values must be "
                      "non-empty and contain no control characters or "
                      "line terminators", file=sys.stderr)
                return 2
            value = explicit
        else:
            value = _generate_honeytoken()
        # Duplicate rules (r1 CRIT-2 both reviewers / proposal §2.3):
        existing, ok, doc = _load_registry()
        if not ok:
            print(f"[info-guard] ⚠ existing {CUSTOM_LITERALS.name} unreadable "
                  f"— will not overwrite", file=sys.stderr)
            return 1
        for item in existing:
            sig = item if isinstance(item, str) else item.get("value")
            if sig == value:
                if _entry_kind(item) == _HONEYTOKEN_KIND:
                    # Duplicate honeytoken → idempotent success, existing
                    # id, no rewrite (existing dup-add precedent).
                    vid = item.get("id") if isinstance(item, dict) else None
                    if json_mode:
                        print(json.dumps({
                            "added": [],
                            "duplicates": [{"value_masked":
                                            _mask_value(value), "id": vid}]},
                            indent=2))
                    else:
                        print(f"value {vid}")
                    return 0
                # Duplicate NORMAL literal → FAIL LOUD (no-silent-mutation,
                # D101): an operator must never believe a canary is planted
                # when it is not.
                print("[info-guard] value already registered with a "
                      "different kind — use hand-edit to change kind",
                      file=sys.stderr)
                return 2
        # Fresh canary: store mask full + kind honeytoken via the
        # canonical writer (r1 MAJ-3: atomic 0600-preserving write).
        entries, _n, _w = _normalize_entries(
            existing + [{"value": value, "mask": "full", "kind": "honeytoken"}])
        out = dict(doc) if isinstance(doc, dict) else {}
        out["version"] = 2
        out["literals"] = entries
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            _atomic_write_json(CUSTOM_LITERALS, out)
        except OSError:
            print(f"[info-guard] ✗ cannot write {CUSTOM_LITERALS} — "
                  f"registry unchanged (permissions? disk?)", file=sys.stderr)
            return 2
        vid = None
        for item in entries:
            if isinstance(item, dict) and item.get("value") == value:
                vid = item.get("id")
                break
        if explicit is None:
            # Generated value: full value to stderr ONCE (the operator
            # needs it to physically plant the decoy); stdout stays
            # machine-clean (MAJ-2). r3 MAJ-3: explicit values are NEVER
            # echoed in full — only generated values appear here.
            print(f"[info-guard] honeytoken planted: {value} (id {vid})",
                  file=sys.stderr)
        if json_mode:
            print(json.dumps({"added": [{"value_masked": _mask_value(value),
                                         "id": vid}]}, indent=2))
        else:
            print(f"planted {_mask_value(value)} (id {vid})")
        return 0
    if any(not v.strip() for v in values):
        print("[info-guard] usage: empty values rejected — literal values "
              "must be non-empty strings", file=sys.stderr)
        return 2
    if not values:
        print(_SUBCOMMAND_USAGE["literals"], file=sys.stderr)
        return 2
    existing, ok, doc = _load_registry()
    if not ok:
        print(f"[info-guard] ⚠ existing {CUSTOM_LITERALS.name} unreadable — "
              f"will not overwrite", file=sys.stderr)
        return 1
    pre = set()
    for item in existing:
        sig = item if isinstance(item, str) else item.get("value")
        if isinstance(sig, str) and sig:
            pre.add(sig)
    new_values = [v for v in values if v not in pre]
    merged, seen = [], set()
    for item in existing + [{"value": v, "mask": mask} if mask else v
                            for v in values]:
        sig = item if isinstance(item, str) else item.get("value")
        if sig in seen:
            continue
        seen.add(sig)
        merged.append(item)
    if new_values:
        entries, _n, _w = _normalize_entries(merged)
        out = dict(doc) if isinstance(doc, dict) else {}
        out["version"] = 2
        out["literals"] = entries
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            _atomic_write_json(CUSTOM_LITERALS, out)
        except OSError:
            # Canonical write failure (Wave A A2/MAJ-5): exit 2, never a
            # traceback, never a silent no-op — the registry is the
            # authoritative declaration surface; a failed write must be
            # loud and operational.
            print(f"[info-guard] ✗ cannot write {CUSTOM_LITERALS} — "
                  f"registry unchanged (permissions? disk?)",
                  file=sys.stderr)
            return 2
    else:
        entries = existing  # no-op: never rewrite (evidence MIN-1)
    by_value = {}
    for item in entries:
        if isinstance(item, dict) and isinstance(item.get("value"), str):
            by_value[item["value"]] = item.get("id")
    added, duplicates = [], []
    for v in values:
        rec = {"value_masked": _mask_value(v), "id": by_value.get(v)}
        (duplicates if v in pre else added).append(rec)
    if json_mode:
        print(json.dumps({"added": added, "duplicates": duplicates}, indent=2))
    else:
        for rec in added + duplicates:
            print(f"value {rec['id']}")
    return 0


def _literals_list(args):
    json_mode = False
    for a in args:
        if a == "--json":
            json_mode = True
        elif a.startswith("--"):
            print(f"[info-guard] Warning: unknown option '{a}'",
                  file=sys.stderr)
    entries, ok, _doc = _load_registry()
    if not ok:
        print(f"[info-guard] ⚠ {CUSTOM_LITERALS.name} unreadable",
              file=sys.stderr)
        if json_mode:
            inst = _installation_status()
            manifest = _install_manifest()
            print(json.dumps({
                "schema": "info-guard/literals/v1",
                "tool": {"name": "info-guard", "version": _PACKAGE_VERSION,
                         "gitleaks": _GITLEAKS_VERSION,
                         "installed": inst["engine"],
                         "engine_state": ("active" if inst["engine"] else
                                          ("partial" if inst["partial"] else "none")),
                         "engine_version": (manifest.get("version")
                                            if manifest and inst["engine"] else None)},
                "literals": []}, indent=2))
        return 0
    rows = []
    for item in entries:
        if isinstance(item, dict):
            v = item.get("value")
            if isinstance(v, str) and v:
                rows.append((v, item.get("id") or "",
                             "full" if item.get("mask") == "full" else None,
                             _entry_kind(item)))
        elif isinstance(item, str) and item:
            rows.append((item, "", None, None))
    rows.sort(key=lambda r: r[0])
    def _disp(v, m, k):
        # §2.4 two-surface doctrine: `mask: full` governs the REDACTION
        # surface only and never renders as `***` in CLI output —
        # machine surfaces (list, JSON) use the standard 2+2 finding-row
        # mask for honeytokens. Normal full-mask literals keep the
        # pre-existing `***` display (unchanged, §2.4 "normal" row).
        if k is None and m == "full":
            return "***"
        return _mask_value(v)
    if json_mode:
        inst = _installation_status()
        manifest = _install_manifest()
        out_rows = []
        for v, i, m, k in rows:
            rec = {"value_masked": _disp(v, m, k), "id": i}
            if k is not None:
                # Wave B (IG D103): `kind` on machine surfaces only when
                # explicitly set (absent-never-null for normal literals).
                rec["kind"] = k
            out_rows.append(rec)
        print(json.dumps({
            "schema": "info-guard/literals/v1",
            "tool": {"name": "info-guard", "version": _PACKAGE_VERSION,
                     "gitleaks": _GITLEAKS_VERSION,
                     "installed": inst["engine"],
                     "engine_state": ("active" if inst["engine"] else
                                      ("partial" if inst["partial"] else "none")),
                     "engine_version": (manifest.get("version")
                                        if manifest and inst["engine"] else None)},
            "literals": out_rows}, indent=2))
    else:
        for v, i, m, k in rows:
            # Wave B: honeytoken rows gain a `honeytoken` column; normal
            # literals show nothing (absent-never-null).
            suffix = f"  {k}" if k is not None else ""
            print(f"{i or '-':<16} {_disp(v, m, k)}{suffix}")
    return 0


def _literals_remove(args):
    """literals remove <id> (Wave B, IG D103, A3): removes exactly one
    registry entry by id through the canonical writer path — atomic
    0600-preserving write (r1 MAJ-3). Unknown id → idempotent exit 0
    with `no entry with id <id>` on stderr (r1 MIN-1: JSON carries
    `removed: false`; `removed: true` only when actually removed)."""
    json_mode = False
    ids = []
    for a in args:
        if a == "--json":
            json_mode = True
        elif a.startswith("--"):
            print(f"[info-guard] Warning: unknown option '{a}'",
                  file=sys.stderr)
        else:
            ids.append(a)
    if len(ids) != 1:
        print("[info-guard] usage: literals remove <id> (exactly one id)",
              file=sys.stderr)
        return 2
    target = ids[0]
    entries, ok, doc = _load_registry()
    if not ok:
        print(f"[info-guard] ⚠ existing {CUSTOM_LITERALS.name} unreadable "
              f"— will not overwrite", file=sys.stderr)
        return 1
    kept, found = [], False
    for item in entries:
        sig = item if isinstance(item, str) else item.get("value")
        ident = item.get("id") if isinstance(item, dict) else None
        if ident == target:
            found = True
            continue  # drop exactly this entry
        kept.append(item)
    if not found:
        print(f"[info-guard] no entry with id {target}", file=sys.stderr)
        if json_mode:
            print(json.dumps({"removed": False, "id": target}, indent=2))
        return 0
    out = dict(doc) if isinstance(doc, dict) else {}
    out["version"] = 2
    out["literals"] = kept
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        _atomic_write_json(CUSTOM_LITERALS, out)
    except OSError:
        print(f"[info-guard] ✗ cannot write {CUSTOM_LITERALS} — "
              f"registry unchanged (permissions? disk?)", file=sys.stderr)
        return 2
    if json_mode:
        print(json.dumps({"removed": True, "id": target}, indent=2))
    else:
        print(f"removed {target}")
    return 0


def _self_fill_mask_style(value):
    """Self-fill mask style (Wave A P-D, shape-based + length floor):
    token-format value → `full`; any value shorter than 12 chars →
    `full` regardless of shape (2+2 on an 8-char PIN discloses half the
    secret); everything else → default 2+2 (None). Applied by VALUE
    shape, not detector class (D9's stated intent)."""
    if len(value) < 12 or _value_class(value) == "token-format":
        return "full"
    return None


def cmd_setup(args):
    """Interactive wizard: preflight scan → review candidates → register
    the real ones → pick .env sources → build the pattern file.

    Values are NEVER echoed: candidates are shown masked, and confirmed
    values go straight from the scan into custom_literals.json.
    `--all` accepts every candidate non-interactively (for agents/tests).
    Wave A (Phase 5): identity-verified KNOWN .env candidates are
    grouped into ONE default-accept prompt (masked value + source_key +
    proposed mask style, plaintext-persistence disclosure); non-KNOWN
    candidates keep the existing per-item prompt."""
    auto = "--all" in args
    if not auto and not sys.stdin.isatty():
        print("[info-guard] setup is interactive — run it in a terminal, or use:\n"
              "    info-guard preflight            review candidates manually\n"
              "    info-guard build [ENV_FILE...]  build from your .env files\n"
              "    edit <state>/custom_literals.json, then `info-guard build`")
        return 2
    dirs = _scan_dirs()
    if not dirs:
        print(f"[info-guard] setup: no scan targets under {_HERMES_HOME} "
              f"({', '.join(_PREFLIGHT_DIRS)})")
        return 0
    _ensure_gitleaks()
    print(f"[info-guard] setup — scanning {len(dirs)} dirs under {_HERMES_HOME} "
          f"(read-only scan; only your confirmed choices write anything)")
    all_hits, gitleaks_ok, env_meta = _collect_hits(dirs, redact=False,
                                                    env_pass=True)
    if not gitleaks_ok:
        print("[info-guard] setup: ⚠ gitleaks not found on PATH — key-shape pass only")
    from collections import OrderedDict
    known_sigs = (env_meta or {}).get("known_sigs") or {}
    deduped = OrderedDict()
    for h in all_hits:
        if h[0] == "KNOWN":
            continue  # KNOWN rows handled by the group prompt, never the per-item loop
        if (h[2], h[3], h[4]) in known_sigs:
            continue  # KNOWN precedence: the env pass owns this signature
        key = (h[0], h[1], h[2], h[3], h[4])
        count, _ = deduped.get(key, (0, None))
        deduped[key] = (count + 1, h)
    added = []          # (value, mask_style)
    skipped_short = 0

    # ── Wave A: KNOWN self-fill group (Phase 5, A13) ──────────────
    # Identity-verified .env values (env_meta known_sigs) get ONE
    # default-accept group prompt: masked value + source_key + proposed
    # mask style + plaintext-persistence disclosure. Declining skips the
    # group (values remain detectable as env rows, just unregistered).
    known_sigs = (env_meta or {}).get("known_sigs") or {}
    if known_sigs:
        known_vals = OrderedDict()   # value -> {source_key, count}
        for (_rel, _line, value), src_key in known_sigs.items():
            e = known_vals.setdefault(value, {"source_key": src_key, "count": 0})
            e["count"] += 1
        print()
        print(f"[info-guard] {len(known_vals)} known .env value(s) found in the "
              f"scanned files — register as protected literal(s)? [Y/n]")
        for value, e in known_vals.items():
            style = _self_fill_mask_style(value)
            style_label = "full" if style == "full" else "default 2+2"
            print(f"    {_mask_value(value):<18} source_key={e['source_key']}  "
                  f"mask={style_label}  (×{e['count']})")
        print(f"    Accepting writes a PLAINTEXT copy to {CUSTOM_LITERALS} "
              f"(0600, same trust class as your .env).")
        if auto:
            ans = "y"
        else:
            try:
                ans = input("    register these known values? [Y/n] ").strip().lower()
            except EOFError:
                ans = "q"
            if ans in ("q", "quit"):
                print("[info-guard] aborted — nothing registered")
                return 2
        if ans in ("y", "yes", ""):
            for value, e in known_vals.items():
                added.append((value, _self_fill_mask_style(value)))
            print(f"    ✓ {len(known_vals)} known value(s) queued for registration")
        else:
            print("    skipped — values remain detectable as env rows, "
                  "just unregistered")
    if deduped:
        print(f"\n[info-guard] {len(deduped)} candidate(s) found in your transcripts "
              f"and logs. Review each: anything that is YOURS gets registered as "
              f"an exact-value literal (values shown masked only).")
        print()
        for key, (n, h) in deduped.items():
            cls, rule, rel, line, value, masked, ctx = h
            if cls == "KNOWN":
                continue  # KNOWN rows handled by the group prompt above
            print(f"  [{cls}] {rule} (×{n})")
            print(f"      {rel}:{line}  value={masked}")
            if ctx:
                print(f"      …{ctx}…")
            if auto:
                ans = "y"
            else:
                try:
                    ans = input("      add as literal? [y]es / [n]o / [q]uit  ").strip().lower()
                except EOFError:
                    ans = "q"
            if ans == "q":
                break
            if ans != "y":
                continue
            if len(value) < 8:
                skipped_short += 1
                print("      (value too short for exact-value matching — it will be "
                      "covered if its KEY is in your .env sources)")
                continue
            style = _self_fill_mask_style(value)
            added.append((value, style))
            print(f"      ✓ registered (mask: {style or 'default 2+2'})")
        print()
    # .env sources
    env_sources = []
    for cand, default in [(_HERMES_HOME / ".env", True), (Path.cwd() / ".env", False)]:
        if not cand.exists():
            continue
        if auto:
            ans = "y" if default else "n"
        else:
            ans = input(f"  include {cand} as an env source? [Y/n] "
                        if default else f"  include {cand} as an env source? [y/N] ").strip().lower()
            ans = ans or ("y" if default else "n")
        if ans == "y":
            env_sources.append(str(cand))
    # write custom_literals.json (merge, never clobber) — through the
    # canonical normalize path so new entries get ids at write time;
    # unknown top-level keys preserved (evidence MIN-1)
    existing, ok, doc = _load_registry()
    if not ok:
        print(f"[info-guard] ⚠ existing {CUSTOM_LITERALS.name} unreadable — "
              f"will not overwrite; new values skipped")
        added = []
    if added:
        seen = set()
        merged = []
        for item in existing + [{"value": v, "mask": m} if m else v for v, m in added]:
            sig = item if isinstance(item, str) else item.get("value")
            if sig in seen:
                continue
            seen.add(sig)
            merged.append(item)
        entries, _n_new, _need = _normalize_entries(merged)
        out = dict(doc) if isinstance(doc, dict) else {}
        out["version"] = 2
        out["literals"] = entries
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        _atomic_write_json(CUSTOM_LITERALS, out)
        print(f"[info-guard] wrote {len(added)} new literal(s) → {CUSTOM_LITERALS}")
    elif not env_sources:
        print("[info-guard] nothing new to register — no changes made")
        return 0
    # build
    if env_sources:
        cmd_build(env_sources)
    elif added:
        print("[info-guard] no env sources selected — pattern file will contain "
              "only the custom literals (add sources later with "
              "`info-guard build ENV_FILE...`)")
    if skipped_short:
        print(f"[info-guard] note: {skipped_short} short value(s) skipped — their "
              f"keys are covered if present in an env source")
    cmd_status()
    # setup stamping (IG D48): setup just changed the protection config —
    # refresh an existing baseline's protection + assessment snapshot in
    # place so the next `watch` doesn't scream "N protection changes".
    # Values are untouched (keep_values). No baseline / v1 baseline: the
    # next watch baselines or migrates anyway (delta-free).
    baseline_path = STATE_DIR / "watch-baseline.json"
    if baseline_path.exists():
        try:
            prev_bl = json.loads(baseline_path.read_text())
        except (OSError, ValueError):
            prev_bl = None
        if (prev_bl is not None
                and prev_bl.get("schema") == "info-guard/watch-baseline/v2"):
            total_files = sum(1 for d in dirs for _ in d.rglob("*")
                              if _.is_file())
            now = datetime.now(timezone.utc).isoformat(
                timespec="seconds").replace("+00:00", "Z")
            bl_assessment = _build_assessment(
                all_hits, [str(d.relative_to(_HERMES_HOME)) for d in dirs],
                total_files, gitleaks_ok, now)
            _write_watch_baseline(
                baseline_path, {}, prev_bl,
                _snapshot_protection(),
                _snapshot_assessment_totals(bl_assessment),
                keep_values=True)
            print("[info-guard] setup: watch baseline protection/assessment "
                  "stamped (values preserved)")
    print("[info-guard] done. Verify with ./test.sh — masking is live immediately.")
    return 0


# ═══════════════════════════════════════════════════════════════════════
# Wave C (P4 Self-Sustain, Phase A): W10 update / W11 heal / W12 batteries
# / W6 cron. Binding contract: proposals/self-sustain.md v1.6 (IG D113).
# ═══════════════════════════════════════════════════════════════════════

_UPDATE_SCHEMA = "info-guard/update/v1"
_UPDATE_ERROR_CLASSES = ("none", "usage", "network", "dirty_tree", "not_git",
                         "lock", "checkout", "install", "tag_mismatch",
                         "version_mismatch", "verify", "state", "repair")
_RELEASE_TAG_RE = re.compile(r"^v(\d+)\.(\d+)\.(\d+)$")
_PATCHED_FILES = ("agent/redact.py", "cli.py", "gateway/run.py",
                  "hermes_cli/config.py", "hermes_cli/main.py")
_CRON_MARKER_PREFIX = "info-guard-managed:"


def _pkg_root() -> Path:
    """The running binary resolves its own package root via __file__
    (<pkg> = bin/..) — update works from any cwd; ~/.info-guard is the
    documented canonical path but is never hardcoded in logic (W10)."""
    return Path(__file__).resolve().parent.parent


def _git(args, cwd, timeout=60):
    """Run git in cwd. Returns (rc|None, stdout, stderr); None rc = the
    invocation could not run (missing git, timeout)."""
    try:
        r = subprocess.run(["git", "-C", str(cwd)] + list(args),
                           capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired):
        return None, "", ""


def _pkg_is_git(pkg) -> bool:
    return (pkg / ".git").exists() and _git(["rev-parse", "--is-inside-work-tree"],
                                            pkg)[0] == 0


def _origin_url(pkg):
    """The RAW configured origin URL (git config, not `git remote get-url`
    — get-url applies url.<base>.insteadOf rewriting, which would hide the
    https scheme from the HTTPS policy check; the rewrite still applies at
    git's transport layer for ls-remote/fetch)."""
    rc, out, _ = _git(["config", "--get", "remote.origin.url"], pkg)
    return out.strip() if rc == 0 and out.strip() else None


def _pkg_dirty(pkg) -> bool:
    """Fail closed on a dirty package tree (staged + worktree tracked
    changes; untracked files are not at risk from a checkout). Never
    stashes or resets operator changes (invariant 5)."""
    rc, out, _ = _git(["status", "--porcelain", "--untracked-files=no"], pkg)
    return True if rc != 0 else bool(out.strip())


class _PkgLock:
    """flock package-checkout lock (<pkg>/.git/info-guard.lock), distinct
    from the target-checkout lock install.sh holds. create=False (used by
    update --check) opens an EXISTING lock file read-only and never creates
    it — the file is created by mutating operations, so its absence means
    no update is in progress (read-only non-mutation contract, A2/S2)."""

    def __init__(self, pkg, create=True):
        self.path = pkg / ".git" / "info-guard.lock"
        self.create = create
        self.fd = None

    def acquire(self) -> bool:
        try:
            if self.create:
                self.fd = os.open(str(self.path), os.O_CREAT | os.O_RDWR, 0o600)
            else:
                if not self.path.exists():
                    return True
                self.fd = os.open(str(self.path), os.O_RDONLY)
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                os.close(self.fd)
                self.fd = None
                return False
            return True
        except OSError:
            if self.fd is not None:
                try:
                    os.close(self.fd)
                except OSError:
                    pass
                self.fd = None
            return False

    def release(self):
        if self.fd is not None:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            except OSError:
                pass
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None


def _discover_release(pkg):
    """Origin-qualified release discovery: `git ls-remote --tags origin`,
    strict vX.Y.Z grammar only, annotated tags peeled to their commit via
    the ^{} lines. Local tags are never a selection source (S1). Returns
    (tag, commit) for the highest SemVer, or (None, None)."""
    rc, out, _ = _git(["ls-remote", "--tags", "origin"], pkg, timeout=60)
    if rc != 0:
        return None, None
    commits = {}
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) != 2 or not parts[1].startswith("refs/tags/"):
            continue
        name = parts[1][len("refs/tags/"):]
        peeled = name.endswith("^{}")
        if peeled:
            name = name[:-3]
        if peeled:
            commits[name] = parts[0]          # annotated -> peeled commit
        else:
            commits.setdefault(name, parts[0])
    best = None
    for name, sha in commits.items():
        m = _RELEASE_TAG_RE.match(name)
        if not m:
            continue
        ver = tuple(int(x) for x in m.groups())
        if best is None or ver > best[0]:
            best = (ver, name, sha)
    return (best[1], best[2]) if best else (None, None)


def _read_package_version(pkg) -> str | None:
    """The checked-out bin/info-guard's _PACKAGE_VERSION constant (read as
    text — never imported)."""
    try:
        text = (pkg / "bin" / "info-guard").read_text(errors="replace")
    except OSError:
        return None
    m = re.search(r'_PACKAGE_VERSION\s*=\s*"([^"]+)"', text)
    return m.group(1) if m else None


_MANIFEST_UNREADABLE = object()


def _read_install_manifest():
    """install.json as a dict, or _MANIFEST_UNREADABLE when the state is
    inaccessible (A10: post-apply verification must report error_class
    'state', never a mis-claimed version mismatch). A MISSING manifest is a
    legitimate fresh/uninstalled state -> {} (only permission/IO errors on
    an existing file are 'unreadable')."""
    try:
        data = json.loads(INSTALL_MANIFEST.read_text())
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except OSError:
        return _MANIFEST_UNREADABLE
    except ValueError:
        return {}


def _write_install_manifest(doc: dict) -> None:
    _atomic_write_json(INSTALL_MANIFEST, doc)


def _write_prev_ref(pkg, commit) -> bool:
    """Durable previous-commit ref (gc protection, §3.1.1): rollback must
    not depend on reflog reachability."""
    rc, _, _ = _git(["update-ref", "refs/info-guard/previous", commit], pkg)
    return rc == 0


def _read_prev_ref(pkg) -> str | None:
    rc, out, _ = _git(["rev-parse", "--verify", "--quiet",
                       "refs/info-guard/previous"], pkg)
    return out.strip() if rc == 0 and out.strip() else None


def _commit_available(pkg, commit) -> bool:
    rc, _, _ = _git(["cat-file", "-e", f"{commit}^{{commit}}"], pkg)
    return rc == 0


def _engine_state() -> str:
    """Deterministic engine state for the update envelope: ACTIVE (incl.
    ACTIVE-by-upstream — markers present, patch not a working-tree
    modification), PARTIAL, MISSING, DRIFT (markers complete but the
    working-tree patch differs from this package's artifact)."""
    inst = _installation_status()
    n = sum(inst["markers"].values())
    if n == 0:
        return "MISSING"
    if n < 5:
        return "PARTIAL"
    probe_ok, _ = _artifact_probe()
    if probe_ok:
        return "ACTIVE"
    return "DRIFT" if not _is_upstream_merged() else "ACTIVE"


def _is_upstream_merged() -> bool:
    """PR #87953 merged state: markers present in HEAD + reverse-apply fails
    (not a working-tree patch) + forward apply fails (already in HEAD)."""
    checkout = _HERMES_HOME / "hermes-agent"
    patch = _pkg_root() / "patch" / "redactor-registry-patterns.patch"
    if not (checkout / ".git").exists() or not patch.is_file():
        return False
    for rel, marker in _ENGINE_MARKERS.items():
        rc, out, _ = _git(["show", f"HEAD:{rel}"], checkout)
        if rc != 0 or marker not in out:
            return False
    if _git(["apply", "--reverse", "--check", str(patch)], checkout)[0] == 0:
        return False
    if _git(["apply", "--check", str(patch)], checkout)[0] == 0:
        return False
    return True


def _run_install(pkg, checkout, timeout=1800):
    """Canonical install.sh with the internal-invocation contract:
    --no-config --no-cron (never surfaces the interactive cron prompt, A14).
    cwd is pinned to the package root — test.sh (install.sh's battery)
    resolves install.sh/uninstall.sh via os.getcwd()."""
    return subprocess.run(
        ["bash", str(pkg / "install.sh"), "--checkout", str(checkout),
         "--no-config", "--no-cron"],
        capture_output=True, text=True, timeout=timeout, cwd=str(pkg))


def _classify_install_failure(stderr: str, during_apply: bool) -> str:
    """Map install.sh's exit-2 operational refusals to the envelope's
    error_class (the §3.11 heal-not-attemptable / apply-time rows)."""
    low = (stderr or "").lower()
    if "another update/heal in progress" in low or "lock held" in low:
        return "lock"
    if "could not determine the target hermes version" in low:
        return "version_mismatch"
    if "refusing to overwrite" in low or "expected product state" in low:
        return "repair"
    return "install" if during_apply else "repair"


class _UpdateRun:
    """Update command state: the JSON envelope (one shape for every
    reachable outcome) + stdout-purity routing (json mode -> chatter to
    stderr, stdout carries ONLY the envelope)."""

    def __init__(self, json_mode: bool):
        self.json_mode = json_mode
        self.env = {"schema": _UPDATE_SCHEMA, "status": "error",
                    "current": _PACKAGE_VERSION, "latest": None,
                    "selected_commit": None, "engine": "UNKNOWN",
                    "applied": False, "healed": False, "error_class": "none"}

    def say(self, msg: str):
        (sys.stderr if self.json_mode else sys.stdout).write(msg + "\n")

    def finish(self, status, engine=None, latest=None, selected=None,
               applied=None, healed=None, error_class="none", exit_code=0):
        self.env["status"] = status
        if engine is not None:
            self.env["engine"] = engine
        if latest is not None:
            self.env["latest"] = latest
        if selected is not None:
            self.env["selected_commit"] = selected
        if applied is not None:
            self.env["applied"] = applied
        if healed is not None:
            self.env["healed"] = healed
        self.env["error_class"] = error_class
        if self.json_mode:
            print(json.dumps(self.env, indent=2))
        return exit_code


def _recover_pending(u: _UpdateRun, pkg, man: dict):
    """Stale-pending recovery (§3.1.1): a stale pending record is never
    silently discarded and can never be replaced by a new transaction until
    recovery succeeds. Returns (ok, error_class)."""
    p = man.get("pending") or {}
    prev_commit = p.get("previous_commit")
    prev_version = p.get("previous_version")
    if not prev_commit or not prev_version or not _commit_available(pkg, prev_commit):
        u.say("[info-guard] update: stale pending transaction present but its "
              "previous_commit is unavailable — manual recovery required "
              "(pending preserved)")
        return False, "state"
    u.say(f"[info-guard] update: recovering stale pending transaction "
          f"(checkout {prev_commit[:12]} by commit id)")
    rc, _, _ = _git(["checkout", prev_commit], pkg, timeout=60)
    if rc != 0:
        return False, "checkout"
    try:
        inst = _run_install(pkg, _HERMES_HOME / "hermes-agent")
    except subprocess.TimeoutExpired:
        return False, "install"
    for line in (inst.stdout + inst.stderr).splitlines():
        u.say(line)
    if inst.returncode != 0:
        return False, _classify_install_failure(inst.stderr, during_apply=False)
    man2 = _read_install_manifest()
    if man2 is _MANIFEST_UNREADABLE:
        return False, "state"
    if man2.get("version") != prev_version:
        return False, "version_mismatch"
    _write_install_manifest({"version": prev_version,
                             "installed_at": man2.get("installed_at"),
                             "previous_version": man2.get("previous_version"),
                             "previous_commit": man2.get("previous_commit"),
                             "pending": None})
    u.say("[info-guard] update: recovered — package restored to the last "
          "verified state, pending cleared")
    return True, None


def _update_check(u: _UpdateRun, pkg) -> int:
    """update --check: read-only in every state (ls-remote only — no fetch,
    no refs/index/worktree/FETCH_HEAD mutation, no repair)."""
    origin = _origin_url(pkg)
    if origin is None:
        u.say("[info-guard] update: no origin configured on this checkout")
        return u.finish("error", error_class="network", exit_code=2)
    if not origin.startswith("https://"):
        u.say("[info-guard] update: origin must be HTTPS (HTTPS git only — "
              "the configured origin is the trust anchor); no fetch was made")
        return u.finish("error", error_class="network", exit_code=2)
    if _pkg_dirty(pkg):
        u.say("[info-guard] update: package tree is dirty — resolve local "
              "modifications first (never auto-stash)")
        return u.finish("error", engine=_engine_state(), error_class="dirty_tree",
                        exit_code=2)
    engine = _engine_state()
    tag, commit = _discover_release(pkg)
    if tag is None:
        u.say("[info-guard] update: no matching release tag (strict vX.Y.Z) "
              "on the origin")
        return u.finish("error", engine=engine, error_class="tag_mismatch",
                        exit_code=2)
    latest = tag[1:]
    cur = _version_tuple(_PACKAGE_VERSION) or (0,)
    lat = _version_tuple(latest) or (0,)
    if lat > cur:
        u.say(f"[info-guard] update: newer version available: "
              f"{_PACKAGE_VERSION} -> {latest} (check only — nothing changed)")
        return u.finish("update_available", engine=engine, latest=latest,
                        exit_code=1)
    u.say(f"[info-guard] update: up to date ({_PACKAGE_VERSION})"
          + (f" — engine {engine}" if engine != "ACTIVE" else ""))
    return u.finish("up_to_date", engine=engine, latest=_PACKAGE_VERSION,
                    exit_code=0)


def _heal_via_install(u: _UpdateRun, pkg, checkout) -> int:
    """Heal-only install path (current tag, broken engine). Returns
    install.sh's rc; the envelope error_class is recorded on u."""
    try:
        inst = _run_install(pkg, checkout)
    except subprocess.TimeoutExpired:
        u._install_error_class = "repair"
        return 2
    u._install_error_class = _classify_install_failure(inst.stderr,
                                                       during_apply=False)
    for line in (inst.stdout + inst.stderr).splitlines():
        u.say(line)
    return inst.returncode


def _update_apply(u: _UpdateRun, pkg) -> int:
    """Default (mutating) update path — the explicit-mutation surface."""
    # stale-pending recovery FIRST (r1 MAJ-1 fold): never overwritten by a
    # new transaction
    man = _read_install_manifest()
    if man is _MANIFEST_UNREADABLE:
        u.say("[info-guard] update: install.json unreadable — cannot assess "
              "the transaction state (state inaccessible)")
        return u.finish("error", error_class="state", exit_code=2)
    if man.get("pending"):
        ok, err = _recover_pending(u, pkg, man)
        if not ok:
            return u.finish("error", error_class=err, exit_code=2)
        man = _read_install_manifest()
    origin = _origin_url(pkg)
    if origin is None:
        u.say("[info-guard] update: no origin configured on this checkout")
        return u.finish("error", error_class="network", exit_code=2)
    if not origin.startswith("https://"):
        u.say("[info-guard] update: origin must be HTTPS (HTTPS git only — "
              "the configured origin is the trust anchor); no fetch was made")
        return u.finish("error", error_class="network", exit_code=2)
    if _pkg_dirty(pkg):
        u.say("[info-guard] update: package tree is dirty — resolve local "
              "modifications first (never auto-stash, no checkout)")
        return u.finish("error", engine=_engine_state(), error_class="dirty_tree",
                        exit_code=2)
    engine = _engine_state()
    tag, commit = _discover_release(pkg)
    if tag is None:
        u.say("[info-guard] update: no matching release tag (strict vX.Y.Z) "
              "on the origin")
        return u.finish("error", engine=engine, error_class="tag_mismatch",
                        exit_code=2)
    latest = tag[1:]
    cur = _version_tuple(_PACKAGE_VERSION) or (0,)
    lat = _version_tuple(latest) or (0,)
    if lat <= cur:
        # current tag — engine ACTIVE -> up to date; otherwise heal-only
        if engine == "ACTIVE":
            u.say(f"[info-guard] update: up to date ({_PACKAGE_VERSION}) — "
                  f"engine ACTIVE")
            return u.finish("up_to_date", engine=engine,
                            latest=_PACKAGE_VERSION, exit_code=0)
        u.say(f"[info-guard] update: up to date ({_PACKAGE_VERSION}) but "
              f"engine {engine} — heal-only install (no tag change)")
        rc = _heal_via_install(u, pkg, _HERMES_HOME / "hermes-agent")
        if rc == 0:
            return u.finish("up_to_date", engine="ACTIVE",
                            latest=_PACKAGE_VERSION, healed=True, exit_code=0)
        if rc == 1:
            return u.finish("heal_failed", engine=engine,
                            latest=_PACKAGE_VERSION, error_class="repair",
                            exit_code=1)
        err = getattr(u, "_install_error_class", "repair")
        eng = "UNKNOWN" if err in ("lock", "version_mismatch") else engine
        return u.finish("error", engine=eng, latest=_PACKAGE_VERSION,
                        error_class=err, exit_code=2)
    # ── newer release: apply transaction ──────────────────────────────
    head_before = _git(["rev-parse", "HEAD"], pkg)[1].strip()
    prev_version = man.get("version") or _PACKAGE_VERSION
    pending = {"previous_version": prev_version,
               "previous_commit": head_before,
               "selected_commit": commit,
               "started_at": datetime.now(timezone.utc).isoformat(
                   timespec="seconds").replace("+00:00", "Z")}
    _write_install_manifest({**man, "pending": pending})
    u.say(f"[info-guard] update: applying {latest} (origin commit "
          f"{commit[:12]})")
    # fetch WITHOUT writing a local tag (FETCH_HEAD only — an existing local
    # tag pointing elsewhere is never a collision)
    rc, _, err = _git(["fetch", "origin", f"refs/tags/{tag}"], pkg, timeout=120)
    if rc != 0:
        u.say("[info-guard] update: fetch failed — no checkout performed "
              "(pending preserved)")
        return u.finish("error", engine=engine, latest=latest,
                        selected=commit, error_class="network",
                        exit_code=2)
    fh_sha = ""
    try:
        fh_sha = (pkg / ".git" / "FETCH_HEAD").read_text().split("\t")[0].strip()
    except OSError:
        pass
    if fh_sha != commit:
        u.say("[info-guard] update: FETCH_HEAD does not resolve to the "
              "selected origin commit — aborting (pending preserved)")
        return u.finish("error", engine=engine, latest=latest,
                        selected=commit, error_class="network",
                        exit_code=2)
    rc, _, _ = _git(["checkout", commit], pkg, timeout=60)
    if rc != 0:
        return u.finish("error", engine="UNKNOWN", latest=latest,
                        selected=commit, error_class="checkout",
                        exit_code=2)
    u.env["applied"] = True   # the selected commit was checked out
    try:
        inst = _run_install(pkg, _HERMES_HOME / "hermes-agent")
    except subprocess.TimeoutExpired:
        return u.finish("error", engine="UNKNOWN", latest=latest,
                        selected=commit, applied=True,
                        error_class="install", exit_code=2)
    for line in (inst.stdout + inst.stderr).splitlines():
        u.say(line)
    if inst.returncode != 0:
        err = _classify_install_failure(inst.stderr, during_apply=True)
        eng = "UNKNOWN" if err in ("lock", "version_mismatch") else engine
        return u.finish("error", engine=eng, latest=latest,
                        selected=commit, applied=True,
                        error_class=err, exit_code=2)
    # ── post-apply verification (version-source agreement, §3.8) ──────
    # The three sources that must agree: HEAD == the selected origin
    # commit, the checked-out _PACKAGE_VERSION == latest, and
    # install.json.version == latest. The transaction records
    # (previous_version/previous_commit/pending) must be PRESERVED by
    # install.sh's end-of-run rewrite (compared against the pre-update
    # manifest values — install.sh never writes them; the final atomic
    # commit below does).
    new_ver = _read_package_version(pkg)
    man2 = _read_install_manifest()
    head_now = _git(["rev-parse", "HEAD"], pkg)[1].strip()
    if man2 is _MANIFEST_UNREADABLE:
        u.say("[info-guard] update: install.json unreadable during "
              "post-apply verification — no 'verified' claim is made "
              "(partial outcome: the package may still be updated)")
        return u.finish("error", engine="UNKNOWN", latest=latest,
                        selected=commit, applied=True,
                        error_class="state", exit_code=2)
    if (head_now != commit or new_ver != latest
            or man2.get("version") != latest
            or man2.get("previous_version") != man.get("previous_version")
            or man2.get("previous_commit") != man.get("previous_commit")):
        u.say("[info-guard] update: version-source disagreement after apply — "
              "no 'updated' claim is made (rollback: info-guard update "
              "--rollback)")
        return u.finish("error", engine="UNKNOWN", latest=latest,
                        selected=commit, applied=True,
                        error_class="version_mismatch", exit_code=2)
    if man2.get("pending") != pending:
        u.say("[info-guard] update: manifest transaction fields not preserved "
              "through install — no 'verified' claim (state)")
        return u.finish("error", engine="UNKNOWN", latest=latest,
                        selected=commit, applied=True,
                        error_class="state", exit_code=2)
    eng_after = _engine_state()
    healed = engine != "ACTIVE" and eng_after == "ACTIVE"
    _write_install_manifest({"version": latest,
                             "installed_at": man2.get("installed_at"),
                             "previous_version": prev_version,
                             "previous_commit": head_before,
                             "pending": None})
    _write_prev_ref(pkg, head_before)
    u.say(f"[info-guard] update: updated to {latest} — engine {eng_after}, "
          f"previous release {prev_version} ({head_before[:12]}) recorded")
    return u.finish("updated", engine=eng_after, latest=latest,
                    selected=commit, applied=True, healed=healed,
                    exit_code=0)


def _update_rollback(u: _UpdateRun, pkg) -> int:
    """update --rollback (D113): executable rollback by commit id — never by
    tag name; no local tag is required. Resolves the previous commit from
    refs/info-guard/previous (fallback: install.json.previous_commit)."""
    man = _read_install_manifest()
    if man is _MANIFEST_UNREADABLE:
        u.say("[info-guard] update: install.json unreadable — cannot assess "
              "the transaction state (state inaccessible)")
        return u.finish("error", error_class="state", exit_code=2)
    if man.get("pending"):
        ok, err = _recover_pending(u, pkg, man)
        if not ok:
            return u.finish("error", error_class=err, exit_code=2)
        man = _read_install_manifest()
    prev_commit = _read_prev_ref(pkg) or man.get("previous_commit")
    prev_version = man.get("previous_version")
    if not prev_commit or not prev_version or not _commit_available(pkg, prev_commit):
        u.say("[info-guard] update: previous release commit no longer "
              "available locally — cannot roll back")
        return u.finish("error", error_class="state", exit_code=2)
    cur_version = man.get("version") or _PACKAGE_VERSION
    head_before = _git(["rev-parse", "HEAD"], pkg)[1].strip()
    engine = _engine_state()
    u.say(f"[info-guard] update: rolling back to {prev_version} "
          f"(commit {prev_commit[:12]} by commit id)")
    rc, _, _ = _git(["checkout", prev_commit], pkg, timeout=60)
    if rc != 0:
        return u.finish("error", engine="UNKNOWN", error_class="checkout",
                        exit_code=2)
    u.env["applied"] = True
    try:
        inst = _run_install(pkg, _HERMES_HOME / "hermes-agent")
    except subprocess.TimeoutExpired:
        return u.finish("error", engine="UNKNOWN", error_class="install",
                        exit_code=2)
    for line in (inst.stdout + inst.stderr).splitlines():
        u.say(line)
    if inst.returncode != 0:
        err = _classify_install_failure(inst.stderr, during_apply=True)
        return u.finish("error", engine="UNKNOWN", error_class=err, exit_code=2)
    new_ver = _read_package_version(pkg)
    man2 = _read_install_manifest()
    head_now = _git(["rev-parse", "HEAD"], pkg)[1].strip()
    if (head_now != prev_commit or new_ver != prev_version
            or man2.get("version") != prev_version):
        u.say("[info-guard] update: rollback verification failed — no "
              "successful rollback claim is made")
        return u.finish("error", engine="UNKNOWN", error_class="version_mismatch",
                        exit_code=2)
    eng_after = _engine_state()
    healed = engine != "ACTIVE" and eng_after == "ACTIVE"
    _write_install_manifest({"version": prev_version,
                             "installed_at": man2.get("installed_at"),
                             "previous_version": cur_version,
                             "previous_commit": head_before,
                             "pending": None})
    _write_prev_ref(pkg, head_before)
    u.say(f"[info-guard] update: rolled back to {prev_version} — previous "
          f"release {cur_version} ({head_before[:12]}) recorded, pending clear")
    return u.finish("updated", engine=eng_after, latest=None,
                    selected=None, applied=True, healed=healed,
                    exit_code=0)


def cmd_update(args):
    """W10 — info-guard update [--check] [--json] [--rollback]."""
    json_mode = "--json" in (args or [])
    check_mode = "--check" in (args or [])
    rollback = "--rollback" in (args or [])
    for a in (args or []):
        if a.startswith("--") and a not in ("--json", "--check", "--rollback"):
            print(f"[info-guard] Warning: unknown option '{a}'", file=sys.stderr)
        elif not a.startswith("--"):
            print(f"[info-guard] update: unexpected argument '{a}' "
                  f"(try `info-guard update --help`)", file=sys.stderr)
            u = _UpdateRun(json_mode)
            return u.finish("error", error_class="usage", exit_code=2)
    u = _UpdateRun(json_mode)
    if check_mode and rollback:
        u.say("[info-guard] usage: --check and --rollback are mutually "
              "exclusive (D113)")
        return u.finish("error", error_class="usage", exit_code=2)
    pkg = _pkg_root()
    if not _pkg_is_git(pkg):
        u.say("[info-guard] update: package is not a git checkout — update "
              "requires a git install (git clone); tarball installs are "
              "refused")
        return u.finish("error", error_class="not_git", exit_code=2)
    lock = _PkgLock(pkg, create=not check_mode)
    if not lock.acquire():
        u.say("[info-guard] update: another update in progress (package "
              "lock held)")
        return u.finish("error", error_class="lock", exit_code=2)
    try:
        if rollback:
            return _update_rollback(u, pkg)
        if check_mode:
            return _update_check(u, pkg)
        return _update_apply(u, pkg)
    except BaseException:
        # sanitized boundary: an internal failure surfaces as ONE generic
        # value-free line + an error envelope — never a traceback carrying
        # package/registry content (mirrors the preflight boundary)
        u.say("[info-guard] update: internal error — operation incomplete "
              "(generic; run `info-guard update --check` for state)")
        return u.finish("error", error_class="state", exit_code=2)
    finally:
        lock.release()


# ── W12: the seven in-process smoke checks (single fixture source: the
#    same synthetic probe corpus as test.sh's masking section) ───────────
def _smoke_failed() -> list:
    """Run the seven named smoke checks in-process against the checkout's
    engine (agent/redact.py — stdlib-only import chain). Read-only: the
    probes use scratch temp files; the real pattern file/registry/state are
    never read or written. Returns the list of failed check names."""
    checkout = _HERMES_HOME / "hermes-agent"
    if not (checkout / "agent" / "redact.py").is_file():
        return []   # engine state (MISSING) already covers this
    saved_path = list(sys.path)
    sys.path.insert(0, str(checkout))
    try:
        from agent.redact import redact_sensitive_text as _redact
    except Exception:
        return ["smoke engine import"]
    finally:
        sys.path[:] = saved_path
    failed = []
    tmp = Path(tempfile.mkdtemp(prefix="ig-smoke-"))
    try:
        default_lit = "ig-probe-default-" + "12345"
        full_lit = "ig-probe-full-mask-" + "67890"
        short_lit = "ig-short-" + "42"
        pfile = tmp / "patterns.json"
        _atomic_write_json(pfile, {
            "mask": {"head": 2, "tail": 2, "floor": 12},
            "literals": [default_lit,
                         {"value": full_lit, "mask": "full"}, short_lit],
            "key_patterns": {"IG_PROBE_PIN": True},
        })

        def redact(text, file_read=False, patterns=str(pfile)):
            os.environ["HERMES_REDACT_PATTERNS"] = patterns
            return _redact(text, file_read=file_read)

        if redact(default_lit) != "ig...45":
            failed.append("WC SMOKE-1 exact-value partial masking")
        if redact(full_lit) != "***":
            failed.append("WC SMOKE-2 full mask")
        if redact(short_lit) != "***":
            failed.append("WC SMOKE-3 short-value floor")
        if redact("IG_PROBE_PIN=1234") != "IG_PROBE_PIN=***":
            failed.append("WC SMOKE-4 key-pattern masking")
        # 5: broken pattern file -> fail-safe fallback, no unmasked gap, NO
        # repair performed by the smoke
        broken = tmp / "broken.json"
        good = {"mask": {"head": 2, "tail": 2, "floor": 12},
                "literals": ["ig-broken-" + "probe"], "key_patterns": {}}
        t0 = time.time()
        _atomic_write_json(broken, good)
        os.utime(broken, (t0, t0))
        redact("ig-broken-" + "probe", patterns=str(broken))   # prime cache
        broken.write_text("{not json")
        os.utime(broken, (t0 + 2, t0 + 2))
        out = redact("ig-broken-" + "probe", patterns=str(broken))
        if "ig-broken-" + "probe" in out:
            failed.append("WC SMOKE-5 broken-pattern fail-safe")
        elif broken.read_text() != "{not json":
            failed.append("WC SMOKE-5 broken-pattern fail-safe (smoke repaired "
                          "the file — must be read-only)")
        # 6: missing pattern file -> no-op; built-in redaction still works
        os.environ.pop("HERMES_REDACT_PATTERNS", None)
        if _redact("hello world") != "hello world":
            failed.append("WC SMOKE-6 missing-pattern no-op")
        # 7: file_read sentinel — a masked value can never be written back
        sent = redact(f"value={default_lit}", file_read=True)
        if sent == f"value={default_lit}" or "ig-probe" in sent or "12345" in sent:
            failed.append("WC SMOKE-7 file-read sentinel")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
        os.environ.pop("HERMES_REDACT_PATTERNS", None)
    return failed


# ── W6: stale-cron probe (read-only; warning-only; exit-0 limitation) ────
def _shell_tokens(line: str):
    """Tokenize a crontab line respecting single-quoted segments: a '…'
    region is ONE token, '\\'' inside it is an escaped quote. Quote
    wrappers are stripped and '\\'' unescaped (canonicalization). Returns
    None on malformed input (unterminated quote)."""
    tokens, cur, i, n = [], [], 0, len(line)
    in_q = False
    while i < n:
        c = line[i]
        if in_q:
            if c == "'":
                if line[i:i + 4] == "'\\''":
                    cur.append("'")
                    i += 4
                    continue
                in_q = False
                i += 1
                continue
            cur.append(c)
            i += 1
            continue
        if c == "'":
            in_q = True
            i += 1
            continue
        if c.isspace():
            if cur:
                tokens.append("".join(cur))
                cur = []
            i += 1
            continue
        cur.append(c)
        i += 1
    if in_q:
        return None
    if cur:
        tokens.append("".join(cur))
    return tokens


def _unsafe_cron_value(v: str) -> bool:
    """% is rejected at crontab serialization/parsing (cron's daemon layer
    treats it as an input separator even inside shell quotes); newlines and
    control characters are rejected likewise."""
    return any(ord(c) < 32 or ord(c) == 127 or c == "%" for c in v)


def _parse_managed_line(line: str):
    """Parse one managed crontab line -> (exe_path, hermes_home) or None.
    Grammar: <5 schedule fields> then leading NAME='…' assignments, then
    the executable word '<pkg>/bin/info-guard', then `check`, then
    `# info-guard-managed:'<pkg>'`. %/control characters anywhere ->
    rejected (None)."""
    toks = _shell_tokens(line)
    if not toks or len(toks) < 6:
        return None
    # the first five bare tokens are the schedule fields (quoted forms are
    # never valid in the schedule — the grammar rejects them)
    schedule = toks[:5]
    if any(("'" in t) or (t.startswith("#")) or ("=" in t) for t in schedule):
        return None
    rest = toks[5:]
    exe, hermes_home, i = None, None, 0
    while i < len(rest):
        t = rest[i]
        if "=" in t and not t.startswith("#"):
            k, _, v = t.partition("=")
            if k == "HERMES_HOME" and hermes_home is None:
                hermes_home = v
            i += 1
            continue
        if exe is None:
            exe = t
            i += 1
            continue
        break
    if exe is None:
        return None
    tail = rest[i:]
    if not tail or tail[0] != "check":
        return None
    marker_ok = False
    for t in tail[1:]:
        if t == "#":
            continue
        if t.startswith(_CRON_MARKER_PREFIX):
            val = t[len(_CRON_MARKER_PREFIX):]
            marker_ok = bool(val) and not _unsafe_cron_value(val)
        else:
            return None
    if not marker_ok:
        return None
    for v in (exe, hermes_home or ""):
        if _unsafe_cron_value(v):
            return None
    return exe, hermes_home


def _cron_probe_warnings():
    """Read-only stale-cron probe (W6/A9): scan the operator's crontab for
    info-guard-managed lines, tokenize (never split naively), validate
    (%/control rejection), and warn when the resolved absolute binary is
    missing or its --version differs from the running binary. NEVER mutates,
    NEVER executes arbitrary crontab text. Warning is exit-0 (documented
    limitation — not a health verdict)."""
    crontab = shutil.which("crontab")
    if crontab is None:
        print("[info-guard] ⚠ cron probe unavailable (no crontab on PATH) — "
              "skipped; warning is exit 0, never a health verdict")
        return
    try:
        r = subprocess.run([crontab, "-l"], capture_output=True, text=True,
                           timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        print("[info-guard] ⚠ cron probe unavailable (crontab -l failed) — "
              "skipped; warning is exit 0, never a health verdict")
        return
    if r.returncode != 0:
        return   # "no crontab for <user>" is normal — nothing managed exists
    for line in r.stdout.splitlines():
        if _CRON_MARKER_PREFIX not in line:
            continue
        parsed = _parse_managed_line(line)
        if parsed is None:
            print("[info-guard] ⚠ cron: an info-guard-managed line is "
                  "malformed or unsafe ('%'/control chars) — rejected, never "
                  "executed (warning only)")
            continue
        exe, hermes_home = parsed
        if not Path(exe).is_file():
            print("[info-guard] ⚠ cron: a managed line points at a missing "
                  "binary — stale install? (warning only; never repaired)")
            continue
        try:
            vr = subprocess.run([exe, "--version"], capture_output=True,
                                text=True, timeout=15)
        except (OSError, subprocess.TimeoutExpired):
            print("[info-guard] ⚠ cron: a managed binary could not report "
                  "its version (warning only)")
            continue
        if vr.returncode == 0 and vr.stdout.strip() != f"info-guard {_PACKAGE_VERSION}":
            print("[info-guard] ⚠ cron: a managed line points at a DIFFERENT "
                  "info-guard version — stale install? (warning only; never "
                  "auto-fixed)")


# ── W12: check --battery (sandboxed full battery) ───────────────────────
def _snapshot_real_state() -> str:
    """Byte-level snapshot of the real package/target/registry/state/git
    metadata for the S7 no-mutation assertion."""
    parts = []
    pkg = _pkg_root()
    for name in ("HEAD", "index", "packed-refs"):
        p = pkg / ".git" / name
        if p.exists():
            parts.append(f"{name}:" + hashlib.sha256(p.read_bytes()).hexdigest())
        else:
            parts.append(f"{name}:ABSENT")
    for ref in sorted((pkg / ".git" / "refs").rglob("*")) if (pkg / ".git" / "refs").exists() else []:
        if ref.is_file():
            parts.append(f"ref:{ref.relative_to(pkg / '.git')}:"
                         + hashlib.sha256(ref.read_bytes()).hexdigest())
    rc, out, _ = _git(["status", "--porcelain", "--untracked-files=no"], pkg)
    parts.append(f"pkg_status:{out}")
    rc, out, _ = _git(["rev-parse", "HEAD"], pkg)
    parts.append(f"pkg_head:{out.strip()}")
    checkout = _HERMES_HOME / "hermes-agent"
    for rel in _PATCHED_FILES:
        p = checkout / rel
        if p.is_file():
            parts.append(f"target:{rel}:"
                         + hashlib.sha256(p.read_bytes()).hexdigest())
        else:
            parts.append(f"target:{rel}:ABSENT")
    if (checkout / ".git").exists():
        for name in ("HEAD", "index", "packed-refs"):
            p = checkout / ".git" / name
            parts.append(f"tgt:{name}:" + (hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else "ABSENT"))
        fh = checkout / ".git" / "FETCH_HEAD"
        parts.append(f"tgt:FETCH_HEAD:" + ("PRESENT" if fh.exists() else "ABSENT"))
    for f in ("install.json", "redact_patterns.json", "custom_literals.json"):
        p = STATE_DIR / f
        parts.append(f"state:{f}:" + (hashlib.sha256(p.read_bytes()).hexdigest() if p.is_file() else "ABSENT"))
    cl = STATE_DIR / "cron-install.lock"
    parts.append(f"state:cron-install.lock:" + ("PRESENT" if cl.exists() else "ABSENT"))
    return "\n".join(parts)


def _check_battery() -> int:
    """check --battery: run the full committed test.sh sandboxed (scratch
    HERMES_HOME + scratch target checkout), bounded timeout, no-recursion,
    byte-no-mutation of the real package/target/registry/state/git metadata
    (S7). Exit 0 all green · 1 battery verdict broken · 2 operational
    (timeout, sandbox failure). IG_TEST_BATTERY_FAKE=1 (test-only, off by
    default) substitutes a stub battery so the wrapper's own assertions can
    be exercised without recursion."""
    pkg = _pkg_root()
    snap_before = _snapshot_real_state()
    scratch = Path(tempfile.mkdtemp(prefix="ig-battery-"))
    try:
        target = scratch / "target"
        real_checkout = _HERMES_HOME / "hermes-agent"
        if not (real_checkout / "agent" / "redact.py").is_file():
            print("[info-guard] ✗ check --battery: no target checkout — "
                  "cannot run the battery (operational)", file=sys.stderr)
            return 2
        for rel in _PATCHED_FILES:
            src = real_checkout / rel
            dst = target / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
        for cmd in (["git", "init", "-q"], ["git", "add", "-A"],
                    ["git", "-c", "user.email=ig@test",
                     "-c", "user.name=ig-test", "commit", "-q", "-m", "base"]):
            subprocess.run(cmd, cwd=str(target), capture_output=True,
                           check=True, timeout=60)
        home = scratch / "home"
        home.mkdir()
        log = scratch / "battery.log"
        env = dict(os.environ)
        env["HERMES_HOME"] = str(home)
        env.pop("HERMES_REDACT_PATTERNS", None)
        if os.environ.get("IG_TEST_BATTERY_FAKE") == "1":
            log.write_text("fake battery (IG_TEST_BATTERY_FAKE test mode)\n"
                           "(discovered=1 executed=1 passed=1 skipped=0 failed=0)\n")
            rc = 0
        else:
            try:
                with open(log, "w") as f:
                    r = subprocess.run(
                        ["bash", str(pkg / "test.sh"), "--checkout", str(target)],
                        cwd=str(pkg), env=env, stdout=f,
                        stderr=subprocess.STDOUT, timeout=1800)
                rc = r.returncode
            except subprocess.TimeoutExpired:
                print("[info-guard] ✗ check --battery: battery timed out "
                      "(bounded; operational failure)", file=sys.stderr)
                return 2
        out = log.read_text(errors="replace")
        # no-recursion assertion: the committed battery must never invoke
        # `check --battery` (S7). Matches the ADJACENT-args invocation
        # signature ('"check", "--battery"') so the scan's own assertion
        # lines cannot trip it; the IG_TEST_BATTERY_FAKE stub line is
        # exempt (it never spawns test.sh — see WC S7 in test.sh).
        src = (pkg / "test.sh").read_text(errors="replace")
        recursive = any(('"check", "--battery"' in ln  # IG_TEST_BATTERY_FAKE scan-self exemption
                         or "'check', '--battery'" in ln)  # IG_TEST_BATTERY_FAKE scan-self exemption
                        and "IG_TEST_BATTERY_FAKE" not in ln
                        and not ln.strip().startswith("#")
                        for ln in src.splitlines())
        if recursive:
            print("[info-guard] ✗ check --battery: test.sh recursively "
                  "invokes check --battery (S7 violation)", file=sys.stderr)
            return 2
        print("── check --battery (sandboxed) ──")
        shown = 0
        for line in out.splitlines():
            if ("discovered=" in line or "✗" in line or "FAIL" in line
                    or "✓ check" in line or "✓ engine" in line
                    or "IG_TEST_BATTERY_FAKE" in line):
                print(line)
                shown += 1
        if shown == 0:
            print("(no summary lines captured)")
        snap_after = _snapshot_real_state()
        if snap_before != snap_after:
            print("[info-guard] ✗ check --battery: REAL state mutated by the "
                  "battery run — S7 violation (package/target/registry/state/"
                  "git metadata must be byte-unchanged)", file=sys.stderr)
            return 2
        if rc == 0:
            print("[info-guard] ✓ check --battery: full battery green "
                  "(sandboxed; real state byte-unchanged)")
            return 0
        print("[info-guard] ✗ check --battery: the battery reported failures "
              "(verdict: broken)", file=sys.stderr)
        return 1
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def cmd_check(args):
    """Health check — the package's schedulable watchdog. Verifies the
    engine marker survived updates, the pattern file is present, the applied
    patch matches this package's artifact, the live Hermes is within the
    tested release range, and (W12) the engine actually masks (seven
    in-process smoke checks). --heal = explicit engine repair via install.sh
    (never automatic); --battery = full sandboxed test.sh. Exit 0 = healthy,
    1 = broken (completed verdict), 2 = usage OR operational (D94). No alert
    channel assumed: the caller's scheduler decides what to do with a
    non-zero exit (cron mail, ntfy, ...)."""
    args = args or []
    heal = "--heal" in args
    battery = "--battery" in args
    for a in args:
        if a.startswith("--") and a not in ("--heal", "--battery"):
            print(f"[info-guard] Warning: unknown option '{a}'", file=sys.stderr)
    if heal and battery:
        print("[info-guard] usage: --heal and --battery are mutually "
              "exclusive", file=sys.stderr)
        return 2
    if battery:
        return _check_battery()
    problems = 0
    operational = False
    inst = _installation_status()
    upstream = False
    if inst["engine"]:
        print("[info-guard] ✓ engine: ACTIVE — all 5 patch markers present")
        probe_ok, probe_msg = _artifact_probe()
        if not probe_ok:
            if _is_upstream_merged():
                upstream = True
                print("[info-guard] ℹ patch state: ACTIVE-by-upstream — patch "
                      "present in Hermes HEAD (PR #87953 merged); behavior "
                      "verified by the smoke below (markers alone never "
                      "prove the engine masks)")
            else:
                problems += 1
                print(f"[info-guard] ✗ patch state: {probe_msg}")
        ver, src = _checkout_version()
        if ver is None:
            print("[info-guard] ⚠ supported range: could not detect the live "
                  "Hermes version (no git tags, no hermes on PATH) — range "
                  "check skipped (tested: "
                  f"{_fmt_version(_SUPPORTED_MIN)}–"
                  f"{_fmt_version(_SUPPORTED_MAX)})")
        elif ver > _pad_tuple(_SUPPORTED_MAX, len(ver)):
            problems += 1
            print(f"[info-guard] ✗ supported range: your Hermes "
                  f"({_fmt_version(ver)}, from {src}) is NEWER than the "
                  f"tested range ({_fmt_version(_SUPPORTED_MIN)}–"
                  f"{_fmt_version(_SUPPORTED_MAX)}). Update Info Guard FIRST "
                  f"(git pull the package) and re-run ./install.sh before "
                  f"your next `hermes update` — an untested release may not "
                  f"accept the patch.")
        elif ver < _pad_tuple(_SUPPORTED_MIN, len(ver)):
            print(f"[info-guard] ⚠ supported range: your Hermes "
                  f"({_fmt_version(ver)}) is OLDER than the tested range "
                  f"({_fmt_version(_SUPPORTED_MIN)}–"
                  f"{_fmt_version(_SUPPORTED_MAX)}) — masking still works, "
                  f"but upgrade Hermes to a tested version when convenient.")
        else:
            print(f"[info-guard] ✓ supported range: Hermes {_fmt_version(ver)} "
                  f"({src}) within tested range "
                  f"({_fmt_version(_SUPPORTED_MIN)}–"
                  f"{_fmt_version(_SUPPORTED_MAX)})")
    elif inst["partial"]:
        problems += 1
        missing = ", ".join(rel for rel, ok in inst["markers"].items() if not ok)
        print(f"[info-guard] ✗ engine: PARTIAL — markers missing in: {missing}. "
              f"A failed `hermes update` likely half-reverted the patch; "
              f"restore the files (`git checkout` them in the checkout) and "
              f"re-run ./install.sh, or run `info-guard check --heal`")
    else:
        problems += 1
        print("[info-guard] ✗ engine: MISSING — no patch markers found; "
              "`hermes update` likely wiped the patch; run ./install.sh "
              "(idempotent), `info-guard check --heal`, or ./uninstall.sh if "
              "you want out")
    # W12 smoke: the health verdict proves the engine actually masks
    if inst["engine"]:
        smoke_failed = _smoke_failed()
        for name in smoke_failed:
            problems += 1
            print(f"[info-guard] ✗ smoke: {name} — the engine does not mask "
                  f"correctly; this is a BROKEN verdict even though markers "
                  f"are present")
        if not smoke_failed and upstream:
            print("[info-guard] ✓ smoke: all 7 checks pass — ACTIVE-by-upstream "
                  "behavior verified")
    if inst["patterns"]:
        try:
            data = json.loads(MATCHER.read_text())
            lits = data.get("literals", [])
            n_full = sum(1 for l in lits if isinstance(l, dict))
            print(f"[info-guard] ✓ pattern file: present ({len(lits)} literals, "
                  f"{n_full} full-mask, {len(data.get('key_patterns', {}))} "
                  f"key patterns)")
        except OSError:
            operational = True
            print(f"[info-guard] ✗ pattern file: UNREADABLE at {MATCHER} — "
                  f"state inaccessible (operational, exit 2)", file=sys.stderr)
        except ValueError:
            problems += 1
            print(f"[info-guard] ✗ pattern file: invalid JSON at {MATCHER} — "
                  f"run `info-guard build` to regenerate (recovery message)")
    else:
        problems += 1
        print(f"[info-guard] ✗ pattern file: missing — run ./install.sh then "
              f"`info-guard build`")
    if CUSTOM_LITERALS.exists():
        print("[info-guard] ✓ custom literals: present (masking-only source)")
    if _gitleaks_available():
        print("[info-guard] ✓ gitleaks: available (preflight tuned-ruleset tier "
              "active)")
    else:
        print("[info-guard] ⚠ gitleaks: absent — OPTIONAL; preflight degrades "
              "to key-shape pass (install with `info-guard preflight`)")
    _cron_probe_warnings()
    print()
    if operational:
        print("[info-guard] ✗ check FAILED — state inaccessible (operational "
              "failure, exit 2)", file=sys.stderr)
        return 2
    if problems:
        print(f"[info-guard] ✗ check FAILED — {problems} problem(s) found")
        if heal:
            print("[info-guard] check --heal: attempting engine repair via "
                  "install.sh (--no-config --no-cron)…")
            target = _HERMES_HOME / "hermes-agent"
            if not (target / "agent" / "redact.py").is_file():
                print("[info-guard] ✗ check --heal: no target checkout — "
                      "repair cannot be attempted (operational, exit 2)",
                      file=sys.stderr)
                return 2
            try:
                inst_run = _run_install(_pkg_root(), target)
            except subprocess.TimeoutExpired:
                print("[info-guard] ✗ check --heal: install timed out "
                      "(operational, exit 2)", file=sys.stderr)
                return 2
            for line in (inst_run.stdout + inst_run.stderr).splitlines():
                print(line)
            if inst_run.returncode == 0:
                leftover = [n for n in _smoke_failed()]
                print("[info-guard] ✓ check --heal: engine restored — re-run "
                      "`info-guard check` to confirm the verdict")
                return 1 if leftover else 0
            if inst_run.returncode == 2:
                print("[info-guard] ✗ check --heal: repair could not be "
                      "attempted (operational, exit 2)", file=sys.stderr)
                return 2
            print("[info-guard] ✗ check --heal: repair attempted but the "
                  "engine is still broken (completed verdict, exit 1)",
                  file=sys.stderr)
            return 1
        return 1
    if heal:
        print("[info-guard] check --heal: engine already ACTIVE — nothing to "
              "repair")
    print("[info-guard] ✓ check OK — Info Guard healthy")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv and argv[0] in ("-h", "--help") else 1
    if argv[0] == "--version":
        print(f"info-guard {_PACKAGE_VERSION}")
        return 0
    cmd, rest = argv[0], argv[1:]
    # -h/--help anywhere in the subcommand args wins (plan B1; evidence
    # review MIN-1): `watch --reset --help` prints usage, never resets.
    if rest and any(a in ("-h", "--help") for a in rest) \
            and cmd in _SUBCOMMAND_USAGE:
        print(_SUBCOMMAND_USAGE[cmd])
        return 0
    if cmd == "build":
        cmd_build(rest)
        return 0
    if cmd == "status":
        return cmd_status()
    if cmd == "preflight":
        return cmd_preflight(rest)
    if cmd == "watch":
        return cmd_watch(rest)
    if cmd == "setup":
        return cmd_setup(rest)
    if cmd == "check":
        return cmd_check(rest)
    if cmd == "update":
        return cmd_update(rest)
    if cmd == "literals":
        return cmd_literals(rest)
    print(f"[info-guard] unknown command: {cmd} (try `info-guard --help`)")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
